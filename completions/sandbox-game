# bash completion for sandbox-game                         -*- shell-script -*-
# Installed to ~/.local/share/bash-completion/completions/ by install.sh, where
# bash-completion picks it up the first time sandbox-game is completed.
#
# Completes the options; running sandboxes after --stop; existing ones after
# --name, --delete and --reset-install; requirement names after --require;
# Proton installs after --proton= and --with-proton=, NW.js versions after
# --nwjs-version=; directories for GAMEDIR;
# and, for the command, paths inside GAMEDIR written the way the sandbox sees
# them -- type /game/ and it lists the game's folder.

# bash-completion 2.12 renamed its helpers; use whichever this one has.
_sandbox_game_init()
{
    if declare -F _comp_initialize >/dev/null; then
        _comp_initialize -s -- "$@"
    else
        _init_completion -s "$@"
    fi
}
_sandbox_game_filedir()
{
    if declare -F _comp_compgen_filedir >/dev/null; then
        _comp_compgen_filedir "$@"
    else
        _filedir "$@"
    fi
}

# Running sandboxes, as `sandbox-attach --list` names them.
_sandbox_game_running()
{
    sandbox-attach --list 2>/dev/null | awk 'NR > 1 && NF >= 2 { print $1 }'
}

# Sandboxes that exist, running or not: the folders in ~/game-sandboxes.
_sandbox_game_known()
{
    local d
    for d in ~/game-sandboxes/*/; do
        [[ -d $d ]] && d=${d%/} && printf '%s\n' "${d##*/}"
    done
}

# A word as typed -- quotes and backslashes and all -- as the shell will see
# it, in REPLY. Nothing in it is run or expanded: a name is only ever a name.
_sandbox_game_dequote()
{
    local word=$1 reply="" quote="" char i
    for ((i = 0; i < ${#word}; i++)); do
        char=${word:i:1}
        if [[ $quote == "'" ]]; then
            if [[ $char == "'" ]]; then quote=""; else reply+=$char; fi
        elif [[ $quote == '"' ]]; then
            if [[ $char == '"' ]]; then
                quote=""
            elif [[ $char == '\' ]] && ((i + 1 < ${#word})); then
                ((i++)); reply+=${word:i:1}
            else
                reply+=$char
            fi
        elif [[ $char == "'" || $char == '"' ]]; then
            quote=$char
        elif [[ $char == '\' ]] && ((i + 1 < ${#word})); then
            ((i++)); reply+=${word:i:1}
        else
            reply+=$char
        fi
    done
    REPLY=$reply
}

# The candidates from $@ that start with the word being completed, added
# literally. They are read as data, never as a wordlist for compgen -W, which
# would expand command substitutions in a name it was given.
_sandbox_game_matches()
{
    local cand
    COMPREPLY=()
    for cand in "$@"; do
        [[ $cand == "$cur"* ]] && COMPREPLY+=("$cand")
    done
}

# Like _sandbox_game_matches, for an option value: the word being completed
# may be only the value, or the whole --option=value. A Proton install name can
# hold spaces, so it is shell-escaped before it goes into COMPREPLY.
_sandbox_game_value_matches()
{
    local prefix=$1 match=$2 escape=$3 cand word
    shift 3
    COMPREPLY=()
    for cand in "$@"; do
        [[ $cand == "$match"* ]] || continue
        word=$prefix$cand
        if [[ $escape == 1 ]]; then
            printf -v word '%q' "$word"
        fi
        COMPREPLY+=("$word")
    done
}

# The command, as the sandbox sees it: /game/... is the game folder, and so is
# a relative path, the sandbox starting out in /game. $1 = the game folder as
# typed. Anything else absolute is the host's /usr and the like.
_sandbox_game_inside()
{
    local REPLY root base prefix m r word
    _sandbox_game_dequote "$1" || return
    # Only "~" and "~/..." are this shell's home. Replacing every leading
    # tilde would turn ~otheruser/game into $HOMEotheruser/game; leave a
    # ~otheruser to _comp_expand_tilde (or as written) instead.
    case $REPLY in
        \~) REPLY=$HOME ;;
        \~/*) REPLY=$HOME${REPLY#\~} ;;
        \~*)
            if declare -F _comp_expand_tilde >/dev/null; then
                _comp_expand_tilde "$REPLY"
            fi ;;
    esac
    root=$(realpath -- "$REPLY" 2>/dev/null) || return
    # The word being completed arrives as typed, quotes and backslashes and
    # all -- as the last Tab inserted it: "sub\ dir/" is looked up as
    # "sub dir/", or the next level never comes.
    _sandbox_game_dequote "$cur"
    word=$REPLY
    if [[ $word == /game || $word == /game/* ]]; then
        base=$root${word#/game} prefix=/game
    elif [[ $word == /* ]]; then
        if [[ /game/ == "$word"* ]]; then
            COMPREPLY=(/game/)
            compopt -o nospace 2>/dev/null
        else
            _sandbox_game_filedir
        fi
        return
    else
        base=$root/$word prefix=
    fi
    local IFS=$'\n'
    local -a matches
    mapfile -t matches < <(compgen -f -- "$base")
    COMPREPLY=()
    for m in "${matches[@]}"; do
        [[ -d $m ]] && m+=/
        r=${m#"$root"}
        COMPREPLY+=("${prefix:-${r#/}}${prefix:+$r}")
    done
    # Quote what the shell needs quoted, and let a folder's slash stand without
    # a space, so the next level is one Tab away.
    compopt -o filenames 2>/dev/null
    [[ ${#COMPREPLY[@]} -ne 1 || ${COMPREPLY[0]} == */ ]] && compopt -o nospace 2>/dev/null
}

_sandbox_game()
{
    local cur prev words cword was_split split
    _sandbox_game_init "$@" || return

    # Where are we? Options run up to GAMEDIR; everything after it is CMD.
    local i skip=0 gamedir="" at=-1 dashdash=0
    for ((i = 1; i < cword; i++)); do
        if ((skip)); then ((skip--)); continue; fi
        case ${words[i]} in
            --name | --env | --stop | --delete | --reset-install | --allow-lan | --add-host | --x11-backend | --x11-exe | --require | --nwjs-version) skip=1 ;;
            --ro) skip=2 ;;
            --) dashdash=1; gamedir=${words[i + 1]-}; at=$((i + 1)); break ;;
            -*) ;;
            *) gamedir=${words[i]}; at=$i; break ;;
        esac
    done
    if ((at >= 0 && cword > at)); then
        if ((cword == at + 1)); then
            _sandbox_game_inside "$gamedir"
        else
            _sandbox_game_filedir      # arguments to the game's own command
        fi
        return
    fi
    if ((dashdash)); then
        # The word after -- is GAMEDIR even when it starts with a dash; the
        # command that follows is not this command's options either.
        _sandbox_game_filedir -d
        return
    fi

    # An option's value. --opt=value arrives as prev=--opt and cur=value once
    # bash-completion's -s splitter has divided the word, or as one
    # --opt=value word. A finished --opt=value word before the cursor is
    # neither: its option already has a value, and this word is a new
    # argument. bash-completion 2.12 calls the split flag was_split, set to
    # "set"; older _init_completion -s calls it split, set to "true".
    local current=${words[cword]} opt=$prev value=$cur prefix="" split_here=0
    if [[ ${was_split-} == set || ${split-} == true ]]; then
        # The splitter took the "=" off prev and left cur the value, and
        # readline replaces only that part: COMPREPLY carries the value
        # alone, never the option again.
        split_here=1
    elif [[ $current == --*=* && $cur == "$current" ]]; then
        # No splitter divided the word, so the whole of it is replaced.
        opt=${current%%=*}
        value=${current#*=}
        prefix="${opt}="
        split_here=1
    fi
    case $opt in
        --x11-backend)
            _sandbox_game_value_matches "$prefix" "$value" 0 gamescope satellite
            return ;;
        --require)
            # A comma-separated list: complete the word after the last comma.
            local done=${value%"${value##*,}"} cand
            COMPREPLY=()
            for cand in landlock scoped private-display limits audio seccomp all; do
                [[ $cand == "${value##*,}"* ]] && COMPREPLY+=("$prefix$done$cand")
            done
            compopt -o nospace 2>/dev/null
            return ;;
        --stop)
            local -a running
            mapfile -t running < <(_sandbox_game_running)
            _sandbox_game_value_matches "$prefix" "$value" 0 ${running[@]+"${running[@]}"}
            return ;;
        --name)
            local -a known
            mapfile -t known < <(_sandbox_game_known)
            _sandbox_game_value_matches "$prefix" "$value" 0 ${known[@]+"${known[@]}"}
            return ;;
        --delete | --reset-install)
            # sandbox-game parses these as "--delete NAME", never "--delete=NAME".
            ((split_here)) && return
            local -a known
            mapfile -t known < <(_sandbox_game_known)
            _sandbox_game_value_matches "$prefix" "$value" 0 ${known[@]+"${known[@]}"}
            return ;;
        --ro)
            _sandbox_game_filedir
            return ;;
        --env | --allow-lan | --add-host | --x11-exe)
            # Values are free text (or a host path this mode cannot see).
            return ;;
        --gamescope)
            # A boolean unless =ARGS is typed; after a space the next word is
            # GAMEDIR, so options and folders are offered below.
            ((split_here)) && return ;;
        --proton | --with-proton)
            if ((split_here)); then
                if [[ $value == [/~.]* && -z $prefix ]]; then
                    _sandbox_game_filedir -d
                else
                    local -a installs
                    mapfile -t installs < <(sandbox-game --list-proton 2>/dev/null)
                    _sandbox_game_value_matches "$prefix" "$value" 1 \
                        ${installs[@]+"${installs[@]}"}
                fi
                return
            fi ;;
        --nwjs-version)
            if [[ $value == [/~.]* && -z $prefix ]]; then
                _sandbox_game_filedir -d
            else
                local -a versions
                mapfile -t versions < <(sandbox-game --list-nwjs 2>/dev/null)
                _sandbox_game_value_matches "$prefix" "$value" 0 \
                    ${versions[@]+"${versions[@]}"}
            fi
            return ;;
        --mkxp | --pgmmv | --dotnet)
            ((split_here)) && { _sandbox_game_filedir -d; return; } ;;
    esac
    # --ro's second argument is a path inside the sandbox: nothing to offer.
    if ((cword >= 3)) && [[ ${words[cword - 2]} == --ro ]]; then
        return
    fi

    # --proton, --gamescope, --mkxp, --nwjs-version, --pgmmv, --dotnet and
    # --with-proton take an optional =VALUE; they are listed plain, and typing
    # the = gets the values completed.
    if [[ $cur == -* ]]; then
        _sandbox_game_matches --wayland --wayland-x11 --x11-backend --x11-exe --gamescope --host-x11 --headless \
            --proton --mod-loaders --steam --hide-tray --mkxp --nwjs-version --pgmmv --dotnet --with-proton --net --allow-lan \
            --lan --mac-vendor --hosts --add-host --hosts-writable --ro --require --name --env --mangohud --hdr --list --stop \
            --stop-all --reset-install --delete --print-name --list-proton --list-nwjs --check --help
        return
    fi
    _sandbox_game_filedir -d                   # GAMEDIR
}
complete -F _sandbox_game sandbox-game
