    "munlockall", "membarrier", "memfd_create", "userfaultfd",
    # files, directories and their descriptors
    "open", "openat", "openat2", "creat", "close", "close_range", "read",
    "write", "readv", "writev", "pread64", "pwrite64", "preadv", "pwritev",
    "preadv2", "pwritev2", "lseek", "_llseek", "dup", "dup2", "dup3", "fcntl",
    "fcntl64", "flock", "fsync", "fdatasync", "sync", "syncfs",
    "sync_file_range", "sync_file_range2", "arm_sync_file_range", "fallocate",
    "truncate", "truncate64", "ftruncate", "ftruncate64", "fadvise64",
    "fadvise64_64", "arm_fadvise64_64", "readahead", "sendfile", "sendfile64",
    "splice", "tee", "copy_file_range", "stat", "lstat", "fstat", "stat64",
    "lstat64", "fstat64", "newfstatat", "fstatat64", "statx", "statfs",
    "fstatfs", "statfs64", "fstatfs64", "access", "faccessat", "faccessat2",
    "mkdir", "mkdirat", "rmdir", "rename", "renameat", "renameat2", "link",
    "linkat", "unlink", "unlinkat", "symlink", "symlinkat", "readlink",
    "readlinkat", "chmod", "fchmod", "fchmodat", "fchmodat2", "chown",
    "fchown", "lchown", "fchownat", "chown32", "fchown32", "lchown32",
    "utime", "utimes", "futimesat", "utimensat", "utimensat_time64",
    "getdents", "getdents64", "pipe", "pipe2",
    # FIFOs and sockets in the file system; device nodes need a capability
    "mknod", "mknodat",
    # extended attributes: Wine keeps DOS file attributes in them
    "getxattr", "lgetxattr", "fgetxattr", "setxattr", "lsetxattr",
    "fsetxattr", "listxattr", "llistxattr", "flistxattr", "removexattr",
    "lremovexattr", "fremovexattr",
    # devices: GPUs, sound, input, terminals, NTSYNC all speak ioctl
    "ioctl", "inotify_init", "inotify_init1", "inotify_add_watch",
    "inotify_rm_watch",
    # waiting for things
    "poll", "ppoll", "ppoll_time64", "select", "_newselect", "pselect6",
    "pselect6_time64", "epoll_create", "epoll_create1", "epoll_ctl",
    "epoll_wait", "epoll_pwait", "epoll_pwait2", "eventfd", "eventfd2",
    "timerfd_create", "timerfd_settime", "timerfd_settime64",
    "timerfd_gettime", "timerfd_gettime64",
    # clocks and timers, read and used; not set
    "clock_gettime", "clock_gettime64", "clock_getres", "clock_getres_time64",
    "clock_nanosleep", "clock_nanosleep_time64", "nanosleep", "gettimeofday",
    "time", "timer_create", "timer_settime", "timer_settime64",
    "timer_gettime", "timer_gettime64", "timer_getoverrun", "timer_delete",
    # futexes; futex_waitv is Proton's fsync
    "futex", "futex_time64", "futex_waitv",
    # sockets -- the families are the denylist's to refuse, socketcall too
    "socket", "socketpair", "socketcall", "bind", "connect", "listen",
    "accept", "accept4", "getsockname", "getpeername", "getsockopt",
    "setsockopt", "sendto", "recvfrom", "send", "recv", "sendmsg", "recvmsg",
    "sendmmsg", "recvmmsg", "recvmmsg_time64", "shutdown",
    # System V IPC: shared memory for X11's MIT-SHM, and semaphores and
    # message queues for older engines; ipc is how i386 reaches them. Private
    # to the sandbox's own IPC namespace.
    "ipc", "shmget", "shmat", "shmdt", "shmctl", "semget", "semop",
    "semtimedop", "semtimedop_time64", "semctl", "msgget", "msgsnd", "msgrcv",
    "msgctl",
    # further restrictions only: sandbox-landlock, Chromium's own filter
    "seccomp", "landlock_create_ruleset", "landlock_add_rule",
    "landlock_restrict_self",
]
# Left out on purpose, for the next reader wondering: setns, chroot, mount and
# the rest of namespace and mount handling, which nothing in a sandbox runs
# (sandbox-attach enters from outside, through the sandbox's own starter);
# Linux AIO (io_*), POSIX message queues, fanotify, name_to_handle_at,
# vmsplice, pkey_*, mseal, map_shadow_stack, process_madvise, pidfd_getfd,
# memfd_secret, cachestat, the new futex_wait/wake/requeue, listmount,
# statmount, the lsm_* and *xattrat calls, adjtimex, the old i386 signal
# calls besides sigreturn, vm86, and everything that needs a capability.
# Each has a fallback, or is no part of what games and Wine do.

# Programs may ask the kernel to behave as on another Unix, or to make every
# readable page executable; neither has any business here. Asking which
# personality is in force (0xffffffff) is fine, and 32-bit Linux is what
# linux32 asks for. Anything else gets the list's ENOSYS: libseccomp can only
# say "not one of these" with rules that overlap, and leaves undocumented
# which of overlapping rules wins.
PERSONALITIES = (0, 8, 0xFFFFFFFF, 2**64 - 1)    # PER_LINUX, PER_LINUX32, query twice

# sandbox-landlock makes these calls under the filter. If the installed
# libseccomp is too old to know them they would get ENOSYS, and Landlock
# would quietly go, as on a kernel without it. Refuse instead.
REQUIRED = ("landlock_create_ruleset", "landlock_add_rule", "landlock_restrict_self")
POLICIES = ("denylist", "allowlist")
SCMP_FLTATR_CTL_OPTIMIZE = 8


def policy():
    chosen = os.environ.get("SANDBOX_SECCOMP_POLICY") or "denylist"
    if chosen not in POLICIES:
        sys.exit(f"sandbox-seccomp: SANDBOX_SECCOMP_POLICY={chosen}: "
                 f"not one of {', '.join(POLICIES)}; not building a filter")
    return chosen


def build_allowlist(lib):
    for name in REQUIRED:
        if lib.seccomp_syscall_resolve_name(name.encode()) == -1:
            sys.exit(f"sandbox-seccomp: this libseccomp does not know {name}, "
                     "which the allowlist must let through; update libseccomp "
                     "or leave SANDBOX_SECCOMP_POLICY unset")
    ctx = context(lib, ACT_LOG if log_mode() else act_errno(ENOSYS))
    # A binary search over the syscall numbers rather than one comparison
    # after another: a few hundred rules, and Wine makes millions of calls.
    # Without it the filter is slower, not weaker: no reason to refuse.
    lib.seccomp_attr_set(ctx, SCMP_FLTATR_CTL_OPTIMIZE, 2)
    for name in ALLOW:
        add_rule(lib, ctx, ACT_ALLOW, name)
    for value in PERSONALITIES:
        add_rule(lib, ctx, ACT_ALLOW, "personality", ArgCmp(0, CMP_EQ, value, 0))
    return ctx


# Classic BPF, as seccomp takes it: 8-byte instructions of code, jt, jf, k.
INSN = struct.Struct("=HBBI")
BPF_CLASS, BPF_RET, BPF_SRC_K, BPF_JA = 0x07, 0x06, 0x00, 0x05
BPF_MAXINSNS = 4096


def export(lib, ctx):
    with tempfile.TemporaryFile() as f:
        rc = lib.seccomp_export_bpf(ctx, f.fileno())
        if rc < 0:
            sys.exit(f"sandbox-seccomp: cannot export the filter: {os.strerror(-rc)}")
        f.seek(0)
        return f.read()


def chain(first, then):
    """One program: FIRST, and where FIRST would allow the call, THEN.
    Every return of ALLOW in FIRST becomes a jump to THEN's start; THEN
    starts by loading what it looks at, so nothing carries over. Logging,
    refusing or killing stays FIRST's to say."""
    insns = [list(INSN.unpack_from(first, at)) for at in range(0, len(first), INSN.size)]
    for i, (code, _, _, k) in enumerate(insns):
        if code & BPF_CLASS != BPF_RET:
            continue
        if code != BPF_RET | BPF_SRC_K:     # returns a register: cannot tell
            sys.exit("sandbox-seccomp: cannot chain the filters: unexpected return")
        if k == ACT_ALLOW:
            insns[i] = [BPF_JA, 0, 0, len(insns) - i - 1]
    program = b"".join(INSN.pack(*insn) for insn in insns) + then
    if len(program) // INSN.size > BPF_MAXINSNS:
        sys.exit("sandbox-seccomp: the chained filter is longer than the kernel takes")
    return program


class SockFprog(ctypes.Structure):
    _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]


PR_SET_NO_NEW_PRIVS, PR_SET_SECCOMP, SECCOMP_MODE_FILTER = 38, 22, 2


def load_program(program):
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_void_p,
                           ctypes.c_ulong, ctypes.c_ulong]
    buf = ctypes.create_string_buffer(program, len(program))
    prog = SockFprog(len(program) // INSN.size, ctypes.addressof(buf))
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, None, 0, 0) < 0 or \
            libc.prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, ctypes.addressof(prog), 0, 0) < 0:
        sys.exit("sandbox-seccomp: cannot install the filter: "
                 f"{os.strerror(ctypes.get_errno())}")


def main():
    lib = load_lib()
    allowlist = policy() == "allowlist"
    ctx = build(lib)
    # Built before anything is said, so that --check shows a list this
    # libseccomp cannot build as the failure it is.
    program = chain(export(lib, ctx), export(lib, build_allowlist(lib))) if allowlist else None
    if sys.argv[1:] == ["--status"]:    # for sandbox-game --check
        if families_filtered(lib):
            print("socket families filtered")
        else:
            path, tag = socketcall_users()[0]
            why = ("does not say which kernel it is built for, so may make sockets"
                   if tag == UNKNOWN else
                   f"is built for kernel {tag[0]}.{tag[1]} and makes sockets")
            print(f"socket families not filtered: {path} {why} through socketcall")
        return
    if len(sys.argv) > 1:
        if allowlist:
            load_program(program)
        else:
            rc = lib.seccomp_load(ctx)
            if rc < 0:
                sys.exit(f"sandbox-seccomp: cannot install the filter: {os.strerror(-rc)}")
        try:
            os.execvp(sys.argv[1], sys.argv[1:])
        except OSError as e:
            sys.exit(f"sandbox-seccomp: {sys.argv[1]}: {e.strerror}")
    if sys.stdout.isatty():
        sys.exit("sandbox-seccomp: refusing to write a binary filter to a terminal")
    sys.stdout.flush()
    if allowlist:
        sys.stdout.buffer.write(program)
        sys.stdout.flush()
        return
    rc = lib.seccomp_export_bpf(ctx, sys.stdout.fileno())
    if rc < 0:
        sys.exit(f"sandbox-seccomp: cannot export the filter: {os.strerror(-rc)}")


if __name__ == "__main__":
    main()
