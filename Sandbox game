#!/usr/bin/env bash
# Nautilus script: right-click a game and run it sandboxed (no net, home hidden,
# writes captured under ~/game-sandboxes/<name>/). Auto-detects:
#   * RPG Maker / NW.js  -> right-click the game folder or its "www" folder
#   * Ren'Py / native    -> right-click the game folder or its .sh launcher
#   * RPG Maker XP/VX/VX Ace -> native via mkxp-z, no Wine (folder or Game.exe)
#   * Windows / Proton   -> right-click the game folder or the .exe itself
#
# Wayland, MangoHud and the Proton version come from saved preferences, so there
# is one launcher rather than a menu entry per combination. Set them with the
# "Sandbox game preferences" script; per-game settings win over the defaults:
#   ~/.config/sandbox-game/games/<name>
#   ~/.config/sandbox-game/defaults
#
#   D=~/.local/share/nautilus/scripts
#   install -Dm755 "Sandbox game" "$D/Sandbox game"
#   install -Dm755 "Sandbox game preferences" "$D/Sandbox game preferences"
#   install -Dm644 sandbox-game-lib ~/.local/bin/sandbox-game-lib
#   install -Dm755 sandbox-seccomp ~/.local/bin/sandbox-seccomp
# The library holds the parts both scripts must agree on and is sourced from
# beside sandbox-game; it stays out of the scripts dir, where Nautilus would
# offer it as a menu entry.
#
# NW.js runtime is auto-found; override with NWJS_DIR=/path if needed.
# Proton: the saved version wins, else the newest install; PROTON_DIR=/path
# overrides outright. The prefix is built fresh under
# ~/game-sandboxes/<name>/compat/, never your real Steam one.
# mkxp-z is looked for in ~/.local/share/mkxp*, ~/mkxp*, /opt/mkxp*; unpack the
# release directory there whole (the binary needs its stdlib/ beside it) or set
# MKXP_DIR=/path. Its config lands in ~/game-sandboxes/<name>/mkxp.json and is
# yours to edit -- that is where a soundfont, RTP paths or fontSub would go.
# Errors show in a zenity dialog; full output logs to
#   ~/game-sandboxes/<name>-lastrun.log
set -uo pipefail

SANDBOX="$HOME/.local/bin/sandbox-game"
[ -x "$SANDBOX" ] || SANDBOX="$(command -v sandbox-game || true)"
msg() { command -v zenity >/dev/null && zenity --info  --no-wrap --text="$1" 2>/dev/null \
            || notify-send "sandbox-game" "$1" 2>/dev/null || true; }
die() { command -v zenity >/dev/null && zenity --error --no-wrap --text="$1" 2>/dev/null \
            || notify-send "sandbox-game" "$1" 2>/dev/null; exit 1; }
[ -n "$SANDBOX" ] || die "sandbox-game not found in ~/.local/bin or PATH."

LIB="$(dirname "$SANDBOX")/sandbox-game-lib"
# shellcheck source=sandbox-game-lib
. "$LIB" 2>/dev/null || die "sandbox-game-lib not found beside sandbox-game:\n$LIB"

SEL="$(head -n1 <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")"
[ -n "$SEL" ] || SEL="$(pwd)"
SEL="$(realpath "$SEL")"
[ -e "$SEL" ] || die "Selection not found:\n$SEL"

# RPG Maker XP / VX / VX Ace, i.e. the RGSS engines mkxp-z reimplements. Game.ini
# names the runtime it wants; the data files and encrypted archives catch dumps
# that arrived without one. MV/MZ never match -- those are the NW.js case above.
is_rgss() {
    [ -f "$1/Game.ini" ] &&
        grep -qiE '^[[:space:]]*Library[[:space:]]*=[[:space:]]*RGSS' "$1/Game.ini" && return 0
    [ -n "$(find "$1" -maxdepth 2 \( -iname '*.rvdata2' -o -iname '*.rvdata' \
            -o -iname '*.rxdata' -o -iname 'Game.rgss*' \) -print -quit 2>/dev/null)" ]
}

# Windows games ship a heap of .exe beside the real one; drop the usual
# installers and helpers, but only while something else is left to run.
EXE_JUNK='unins|install|setup|vcredist|dxsetup|dxwebsetup|directx|oalinst|dotnet|redist|crashhandler|crashreport|crashsender|touchup|nwjc|notification_helper|python'

find_exes() {                                  # $1 = dir -> best guess first
    local dir="$1" d list keep
    for d in 1 5; do                           # top level first, then deeper
        list="$(find "$dir" -maxdepth "$d" -type f -iname '*.exe' -printf '%s\t%p\n' 2>/dev/null)"
        [ -n "$list" ] && break
    done
    [ -n "$list" ] || return 0
    keep="$(grep -Eiv "/[^/]*(${EXE_JUNK})[^/]*\.exe$" <<<"$list")"
    [ -n "$keep" ] && list="$keep"
    # Rank: filename echoing the folder name first, then biggest -- the real
    # binary is rarely the small one. awk keeps the folder name literal, so a
    # game called "S.T.A.L.K.E.R." is not read as a regex.
    awk -F'\t' -v b="${dir##*/}" '
        BEGIN { b = tolower(b) }
        { n = $2; sub(/.*\//, "", n)
          print (index(tolower(n), b) ? 0 : 1) "\t" $0 }' <<<"$list" \
        | sort -t"$(printf '\t')" -k1,1n -k2,2rn | cut -f3
}

pick() {                                       # $1 = dir to strip, $@ = paths
    local dir="$1" rel; shift
    [ "$#" -eq 1 ] && { printf '%s\n' "$1"; return; }
    rel="$(printf '%s\n' "${@#"$dir"/}" \
        | zenity --list --title="Pick launcher" --column="Launcher" \
                 --width=700 --height=400 2>/dev/null)"
    [ -n "$rel" ] && printf '%s\n' "$dir/$rel"
}

RO=(); CMD=(); GAMEDIR=""; PROTON=0; MKXP=0; ALLOW_WAYLAND=1; ALLOW_MANGOHUD=1

# ---- figure out what was selected -----------------------------------------
# Shared with the preferences dialog, so both agree on which game this is.
resolve_selection "$SEL"
APPDIR="$R_APPDIR"

if [ -n "$APPDIR" ]; then
    # ----- RPG Maker / NW.js -----
    # NW.js runs on Wayland perfectly well outside this sandbox. What it cannot
    # do is run without a D-Bus session bus: Chromium's wayland backend segfaults
    # on startup when there is none, reproducibly, while its x11 backend does not
    # care. Handing a game the session bus would open the keyring, the portals
    # and gvfs to it, which is most of what this sandbox exists to prevent, so
    # the trade is x11 instead. See --ozone-platform=x11 below.
    ALLOW_WAYLAND=0
    # MangoHud is out for the same practical reason: its GL shim is LD_PRELOADed
    # into every child, and Chromium spawns a zygote and its own sandboxed
    # renderers. The window then never comes up and the process hangs until it
    # is killed. An FPS overlay on a 2D RPG Maker game is no loss.
    ALLOW_MANGOHUD=0
    GAMEDIR="$R_GAMEDIR"
    if [ "$(basename "$APPDIR")" = www ]; then APP_IN="/game/www"; else APP_IN="/game"; fi
    NW_DIR="${NWJS_DIR:-}"
    if [ -z "$NW_DIR" ]; then
        for base in ~/.config/nvm ~/.local/share/nwjs ~/nwjs; do
            [ -d "$base" ] || continue
            NW_DIR="$(find "$base" -type d -name 'nwjs-*linux*' 2>/dev/null | sort -V | tail -n1)"
            [ -n "$NW_DIR" ] && break
        done
    fi
    [ -n "$NW_DIR" ] && [ -x "$NW_DIR/nw" ] \
        || die "NW.js runtime not found under ~/.config/nvm (or set NWJS_DIR=...)."
    NW_NAME="$(basename "$GAMEDIR")"; NW_NAME="${NW_NAME//[^A-Za-z0-9._-]/_}"
    RO=( --ro "$NW_DIR" /nwjs )
    # Inside the sandbox: rebuild the runtime dir with nw renamed to the game,
    # then exec it against the app. $1=name $2=app-path
    # --no-sandbox: Chromium builds its own sandbox from user namespaces, which
    # sandbox-game switches off, and without them it dies looking for a setuid
    # helper instead. The sandbox around it is the one that counts here.
    CMD=( sh -c '
        set -e
        d=/tmp/nwrun; mkdir -p "$d"
        cp /nwjs/nw "$d/$1"
        for f in /nwjs/*; do b=${f##*/}; [ "$b" = nw ] || ln -sf "$f" "$d/$b"; done
        exec "$d/$1" "$2" --ozone-platform=x11 --no-sandbox   # x11: see above
    ' _ "$NW_NAME" "$APP_IN" )
else
    # ----- native (.sh), else RGSS via mkxp-z, else Windows (.exe) via Proton --
    # A native launcher always wins: Ren'Py and Unity ship both a .sh and a .exe
    # in the same folder, and running the Linux build beats emulating the other.
    # RGSS comes next, so an RPG Maker VX Ace game runs natively under mkxp-z
    # rather than dragging its Game.exe through Wine.
    LAUNCHER=""; GAMEDIR="$R_GAMEDIR"
    if [ -d "$SEL" ]; then
        mapfile -t shs < <(find "$GAMEDIR" -maxdepth 1 -type f -name '*.sh' | sort)
        if [ "${#shs[@]}" -gt 0 ]; then
            LAUNCHER="$(pick "$GAMEDIR" "${shs[@]}")"
            [ -n "$LAUNCHER" ] || exit 0               # picker cancelled
        elif is_rgss "$GAMEDIR"; then
            MKXP=1
        else
            mapfile -t exes < <(find_exes "$GAMEDIR")
            [ "${#exes[@]}" -gt 0 ] \
                || die "Nothing runnable at:\n$GAMEDIR\n\nLooked for an RPGM/NW.js app, an RGSS game, a .sh launcher and a .exe."
            LAUNCHER="$(pick "$GAMEDIR" "${exes[@]}")"
            [ -n "$LAUNCHER" ] || exit 0               # picker cancelled
            PROTON=1
        fi
    else
        LAUNCHER="$SEL"
        # Game.exe inside an RGSS folder is still an mkxp-z game.
        case "${SEL,,}" in
            *.exe) if is_rgss "$GAMEDIR"; then MKXP=1; else PROTON=1; fi ;;
        esac
    fi
    if [ "$MKXP" = 1 ]; then
        CMD=()            # the runtime is the program, so there is no launcher
    else
        REL="${LAUNCHER#"$GAMEDIR"/}"
        CMD=( /game/"$REL" )
    fi
fi

BASE="$(basename "$GAMEDIR")"

# ---- saved preferences -----------------------------------------------------
# Keyed by the sandbox name so prefs and captured writes stay together, and
# read only now that the dispatch above has settled which game this is.
NAME="$("$SANDBOX" --print-name "$GAMEDIR" 2>/dev/null)" \
    || die "Cannot derive a sandbox name for:\n$GAMEDIR"
FLAG=()
[ "$(cfg_get audio 0)" = 1 ] && FLAG+=( --audio )
HOST_X11="$(cfg_get host_x11 0)"
[ "$HOST_X11" = 1 ] && FLAG+=( --host-x11 )
[ "$HOST_X11" != 1 ] && [ "$ALLOW_WAYLAND" = 1 ] && [ "$(cfg_get wayland 0)" = 1 ] && FLAG+=( --wayland )
[ "$ALLOW_MANGOHUD" = 1 ] && [ "$(cfg_get mangohud 0)" = 1 ] && FLAG+=( --mangohud )
if [ "$HOST_X11" != 1 ] && { [ "$(cfg_get gamescope 0)" = 1 ] ||
    [ "$ALLOW_WAYLAND" = 0 ] || [ "$(cfg_get wayland 0)" != 1 ]; }; then
    # gamescope_args is hand-edited only; empty means gamescope's own defaults.
    GA="$(cfg_get gamescope_args "")"
    if [ -n "$GA" ]; then FLAG+=( "--gamescope=$GA" ); else FLAG+=( --gamescope ); fi
fi
# env=K=V K=V ... -- a game launched from the file manager inherits its
# environment, not a shell's, so anything the game needs has to be recorded.
read -r -a CFG_ENV <<<"$(cfg_get env "")"
for e in ${CFG_ENV[@]+"${CFG_ENV[@]}"}; do FLAG+=( "--env=$e" ); done
if [ "$MKXP" = 1 ]; then
    FLAG+=( "--mkxp${MKXP_DIR:+=$MKXP_DIR}" )
elif [ "$PROTON" = 1 ]; then
    # An exported PROTON_VER still wins, matching NWJS_DIR/MKXP_DIR/PROTON_DIR.
    PV="${PROTON_VER:-$(cfg_get proton auto)}"
    if [ "$PV" = auto ]; then FLAG+=( --proton ); else FLAG+=( "--proton=$PV" ); fi
fi

mkdir -p "$HOME/game-sandboxes"
LOG="$HOME/game-sandboxes/${BASE}-lastrun.log"

# Withholding --mangohud is not enough to keep the overlay away from NW.js:
# sandbox-game also opts in from an inherited MANGOHUD=1, and that variable
# would reach the game regardless and switch on MangoHud's Vulkan layer. Drop
# it outright for the engines that cannot survive it.
RUN=( "$SANDBOX" )
[ "$ALLOW_MANGOHUD" = 1 ] || RUN=( env -u MANGOHUD "$SANDBOX" )

msg "Launching ${BASE}…"
if "${RUN[@]}" "${FLAG[@]}" "${RO[@]}" "$GAMEDIR" "${CMD[@]}" >"$LOG" 2>&1; then
    exit 0
else
    rc=$?
    if command -v zenity >/dev/null; then
        { echo "exit code: $rc"; echo "log: $LOG"; echo; tail -n 80 "$LOG"; } \
          | zenity --text-info --title="sandbox-game failed (${BASE})" \
                   --width=1000 --height=650 2>/dev/null
    else
        notify-send "sandbox-game failed (${BASE})" "exit $rc — see $LOG" 2>/dev/null
    fi
    exit "$rc"
fi
