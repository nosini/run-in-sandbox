#!/usr/bin/env bash
# Nautilus script: right-click a game and run it sandboxed (no net unless the
# preferences allow the internet, home hidden, writes captured under
# ~/game-sandboxes/<name>/). Auto-detects:
#   * RPG Maker / NW.js  -> right-click the game folder or its "www" folder
#   * Ren'Py / native    -> right-click the game folder, .sh or Linux binary
#   * RPG Maker XP/VX/VX Ace -> native via mkxp-z, no Wine (folder or Game.exe)
#   * Pixel Game Maker MV -> native Linux player (folder or player.exe)
#   * Windows / Proton   -> right-click the game folder or the .exe itself
#
# Wayland, MangoHud, the Proton version and mod loaders come from saved
# preferences, so there is one launcher rather than a menu entry per
# combination. Set them with the "Sandbox game preferences" script; per-game
# settings win over the defaults:
#   ~/.config/sandbox-game/games/<name>
#   ~/.config/sandbox-game/defaults
#
#   D=~/.local/share/nautilus/scripts
#   install -Dm755 "Sandbox game" "$D/Sandbox game"
#   install -Dm755 "Sandbox game preferences" "$D/Sandbox game preferences"
#   install -Dm644 sandbox-game-lib ~/.local/lib/sandbox-game/sandbox-game-lib
#   install -Dm755 sandbox-seccomp ~/.local/lib/sandbox-game/sandbox-seccomp
#   install -Dm644 nwjs-casefold.js ~/.local/lib/sandbox-game/nwjs-casefold.js
# The library holds the parts both scripts must agree on and is sourced from
# beside sandbox-game; it stays out of the scripts dir, where Nautilus would
# offer it as a menu entry.
#
# NW.js runtime is auto-found; override with NWJS_DIR=/path if needed.
# Proton: the saved version wins, else the newest install; PROTON_DIR=/path
# overrides outright. The prefix is built fresh under
# ~/game-sandboxes/<name>/compat/, never your real Steam one.
# mkxp-z is looked for in ~/.local/share/mkxp*, ~/mkxp*, /opt/mkxp*; unpack the
# release directory there whole (the binary needs its stdlib/ beside it) or set
# MKXP_DIR=/path. Its config lands in ~/game-sandboxes/<name>/mkxp.json and is
# yours to edit -- that is where a soundfont, RTP paths or fontSub would go.
# Errors show in a GTK dialog, warnings as a notification once the game is
# up; full output logs to
#   ~/game-sandboxes/<name>-lastrun.log
set -uo pipefail

SANDBOX="${SANDBOX_BACKEND:-$HOME/.local/bin/sandbox-game}"
[ -x "$SANDBOX" ] || SANDBOX="$(command -v sandbox-game || true)"
msg() { notify-send "sandbox-game" "$1" 2>/dev/null || true; }
die() {
    printf '%b\n' "$1" >&2
    if declare -F dialog >/dev/null; then dialog error --text="$1" 2>/dev/null && exit 1; fi
    notify-send "sandbox-game" "$1" 2>/dev/null || true
    exit 1
}
[ -n "$SANDBOX" ] || die "sandbox-game not found in ~/.local/bin or PATH."

# Beside sandbox-game when that is a checkout, else where install.sh puts it.
LIB="$(dirname "$(realpath "$SANDBOX")")/sandbox-game-lib"
[ -f "$LIB" ] || LIB="$HOME/.local/lib/sandbox-game/sandbox-game-lib"
# shellcheck source=sandbox-game-lib
. "$LIB" 2>/dev/null || die "sandbox-game-lib not found (run install.sh):\n$LIB"

SEL="$(head -n1 <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")"
[ -n "$SEL" ] || SEL="$(pwd)"
SEL="$(realpath "$SEL")"
[ -e "$SEL" ] || die "Selection not found:\n$SEL"

pick() {                                       # $1 = dir to strip, $@ = paths
    local dir="$1" rel; shift
    [ "$#" -eq 1 ] && { printf '%s\n' "$1"; return; }
    rel="$(python3 -c 'import json,sys; json.dump({"items": sys.argv[1:]}, sys.stdout)' \
        "${@#"$dir"/}" | dialog pick --title="Pick launcher")"
    [ -n "$rel" ] && printf '%s\n' "$dir/$rel"
}

RO=(); CMD=(); GAMEDIR=""; PROTON=0; MKXP=0; PGMMV=0; ALLOW_MANGOHUD=1

# ---- figure out what was selected -----------------------------------------
# Shared with the preferences dialog, so both agree on which game this is.
resolve_selection "$SEL"
APPDIR="$R_APPDIR"
GAMEDIR="$R_GAMEDIR"
NAME_ARGS=()
[ -z "${SANDBOX_GAME_NAME:-}" ] || NAME_ARGS=( --name "$SANDBOX_GAME_NAME" )
NAME="$("$SANDBOX" --print-name "${NAME_ARGS[@]}" "$GAMEDIR" 2>/dev/null)" \
    || die "Cannot derive a sandbox name for:\n$GAMEDIR"

if [ "$(cfg_get launch_with auto)" = proton ]; then
    # A saved override skips NW.js and the native replacement players, even
    # when a data folder or Linux launcher was selected.
    APPDIR=""
    PROTON=1
    if [ -f "$SEL" ] && [[ "${SEL,,}" = *.exe ]]; then
        LAUNCHER="$SEL"
    else
        mapfile -t exes < <(find_exes "$GAMEDIR")
        [ "${#exes[@]}" -gt 0 ] \
            || die "Proton requested, but no Windows .exe was found at:\n$GAMEDIR\n\nChoose Automatic in Sandbox game preferences to use the native launcher."
        LAUNCHER="$(pick "$GAMEDIR" "${exes[@]}")"
        [ -n "$LAUNCHER" ] || exit 0
    fi
    CMD=( "/game/${LAUNCHER#"$GAMEDIR"/}" )
elif [ -n "$APPDIR" ]; then
    # ----- RPG Maker / NW.js -----
    # MangoHud is out for NW.js: its GL shim is LD_PRELOADed
    # into every child, and Chromium spawns a zygote and its own sandboxed
    # renderers. The window then never comes up and the process hangs until it
    # is killed. An FPS overlay on a 2D RPG Maker game is no loss.
    ALLOW_MANGOHUD=0
    GAMEDIR="$R_GAMEDIR"
    if [ "$(basename "$APPDIR")" = www ]; then APP_IN="/game/www"; else APP_IN="/game"; fi
    NW_DIR="${NWJS_DIR:-}"
    if [ -z "$NW_DIR" ]; then
        for base in ~/.config/nvm ~/.local/share/nwjs ~/nwjs; do
            [ -d "$base" ] || continue
            NW_DIR="$(find "$base" -type d -name 'nwjs-*linux*' 2>/dev/null | sort -V | tail -n1)"
            [ -n "$NW_DIR" ] && break
        done
    fi
    [ -n "$NW_DIR" ] && [ -x "$NW_DIR/nw" ] \
        || die "NW.js runtime not found under ~/.config/nvm (or set NWJS_DIR=...)."
    NW_NAME="$(basename "$GAMEDIR")"; NW_NAME="${NW_NAME//[^A-Za-z0-9._-]/_}"
    # nw under the game's name -- the process name, and the node name the
    # sound server keys the game's device by -- in a directory of links to
    # the rest of the runtime, where Chromium looks for it beside the binary.
    # Bound there rather than copied: a copy lands in /tmp, which is memory,
    # some 200 MB of it on every launch.
    RO=( --ro "$NW_DIR" /nwjs --ro "$NW_DIR/nw" "/tmp/nwrun/$NW_NAME" )
    # Windows ignores case in file names, and so do the games made on it:
    # asking for img/pictures/B.png when the file is b.png leaves an invisible
    # character or a "Failed to load" on Linux. nwjs-casefold.js, run ahead of
    # the game's scripts, points such a request at the file that is there. It
    # is bound in read-only below, unless the preferences turn it off. Beside
    # the library, where install.sh puts both; without it the game still runs,
    # only with case mattering.
    CASEFOLD="$(dirname "$LIB")/nwjs-casefold.js"
    # RPG Maker leaves "name" empty in package.json, and NW.js will not start
    # without one: the profile directory (localStorage, which is where some
    # games keep their saves) is named after it. Fill in NW_NAME, which is the
    # same on every launch. It runs inside the sandbox, so the edited copy
    # lands in the capture's rw/ and the install stays untouched. Only an
    # empty or missing top-level name is replaced; a file that does not parse
    # is left for NW.js to complain about.
    # "inject_js_start" is pointed at nwjs-casefold.js where it is bound in --
    # NW.js takes an absolute path there -- and taken out again when it is
    # not, so turning the correction off leaves nothing of it behind. A script
    # the game injects itself is left alone either way.
    read -r -d '' NW_FIX_PKG <<'EOF' || true
import json, os, sys
path, name, casefold = sys.argv[1:]
CASEFOLD = "/nwjs-casefold.js"
try:
    with open(path, encoding="utf-8-sig") as f:
        pkg = json.load(f)
except (OSError, ValueError):
    sys.exit()
if not isinstance(pkg, dict):
    sys.exit()
changed = False
if not str(pkg.get("name") or "").strip():
    pkg["name"] = name
    changed = True
inject = pkg.get("inject_js_start")
if casefold and not str(inject or "").strip():
    pkg["inject_js_start"] = CASEFOLD
    changed = True
elif casefold and inject != CASEFOLD:
    print("sandbox-game: the game injects %s, so file name case is not corrected"
          % inject, file=sys.stderr)
elif not casefold and inject == CASEFOLD:
    del pkg["inject_js_start"]
    changed = True
if changed:
    # Replaced rather than rewritten: a read-only package.json is common.
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(pkg, f, indent=2, ensure_ascii=False)
    os.replace(path + ".tmp", path)
EOF
    # Inside the sandbox: fix up package.json, link the rest of the runtime in
    # beside nw renamed to the game, then exec it against the app. $1=name $2=app-path
    # $3=the fix above $4=ozone platform, then any further NW.js options,
    # appended below once the display preferences are known.
    # Chromium tells the sound server it is "Chromium", like every Chromium
    # browser, so a router such as pulsemeeter sends the game wherever the
    # browsers go. PULSE_PROP_OVERRIDE renames the client to the game; plain
    # PULSE_PROP only fills in what the application left unset.
    # --no-sandbox costs nothing measurable: NW.js 0.110 was checked running
    # without it, and none of its processes carried a seccomp filter beyond
    # sandbox-game's own. Chromium's sandbox needs the user namespaces that
    # sandbox-game switches off, and a Node-enabled page cannot be sandboxed
    # anyway. Passed so that no NW.js build goes looking for a setuid helper.
    CMD=( sh -c '
        set -e
        export PULSE_PROP_OVERRIDE="application.name=$1"
        casefold=; [ ! -f /nwjs-casefold.js ] || casefold=1
        [ ! -f "$2/package.json" ] || python3 -c "$3" "$2/package.json" "$1" "$casefold" || true
        d=/tmp/nwrun
        for f in /nwjs/*; do
            b=${f##*/}; [ "$b" = nw ] || [ "$b" = "$1" ] || ln -sf "$f" "$d/$b"
        done
        name=$1 app=$2 ozone=$4; shift 4
        exec "$d/$name" "$app" --ozone-platform="$ozone" --no-sandbox "$@"
    ' _ "$NW_NAME" "$APP_IN" "$NW_FIX_PKG" )
else
    # ----- native, else PGMMV/RGSS, else Windows (.exe) via Proton ------------
    # A .sh launcher always wins: Ren'Py and Unity ship both a .sh and a .exe
    # in the same folder, and running the Linux build beats emulating the other.
    # Recognised PGMMV/RGSS games use their native replacement players, ahead
    # of a Linux program, such as an mkxp-z unpacked into an RPG Maker game.
    # The order game_engine in sandbox-game-lib goes by.
    LAUNCHER=""; GAMEDIR="$R_GAMEDIR"
    if [ -d "$SEL" ]; then
        mapfile -t natives < <(native_scripts "$GAMEDIR")
        if [ "${#natives[@]}" -eq 0 ] && ! is_pgmmv "$GAMEDIR" && ! is_rgss "$GAMEDIR"; then
            mapfile -t natives < <(native_binaries "$GAMEDIR")
        fi
        if [ "${#natives[@]}" -gt 0 ]; then
            LAUNCHER="$(pick "$GAMEDIR" "${natives[@]}")"
            [ -n "$LAUNCHER" ] || exit 0               # picker cancelled
        elif is_pgmmv "$GAMEDIR"; then
            PGMMV=1
        elif is_rgss "$GAMEDIR"; then
            MKXP=1
        else
            mapfile -t exes < <(find_exes "$GAMEDIR")
            [ "${#exes[@]}" -gt 0 ] \
                || die "Nothing runnable at:\n$GAMEDIR\n\nLooked for an RPGM/NW.js app, a PGMMV or RGSS game, a native Linux launcher and a .exe."
            LAUNCHER="$(pick "$GAMEDIR" "${exes[@]}")"
            [ -n "$LAUNCHER" ] || exit 0               # picker cancelled
            PROTON=1
        fi
    else
        LAUNCHER="$SEL"
        # Selecting a Windows player still uses a recognised native runtime.
        case "${SEL,,}" in
            *.exe) if is_pgmmv "$GAMEDIR"; then PGMMV=1
                   elif is_rgss "$GAMEDIR"; then MKXP=1; else PROTON=1; fi ;;
            *.json) is_pgmmv "$GAMEDIR" && PGMMV=1 ;;
        esac
    fi
    if [ "$MKXP" = 1 ] || [ "$PGMMV" = 1 ]; then
        CMD=()            # the runtime is the program, so there is no launcher
    else
        REL="${LAUNCHER#"$GAMEDIR"/}"
        # One that lost its executable bit is sandbox-game's to run; see there.
        CMD=( /game/"$REL" )
    fi
fi

BASE="$(basename "$GAMEDIR")"

# ---- saved preferences -----------------------------------------------------
# Keyed by the sandbox name so prefs and captured writes stay together. The
# name was resolved before dispatch so launch_with can choose the runtime.
# The same translation the desktop manager uses; see sandbox-game-lib.
pref_flags
if [ -n "$APPDIR" ] && [ "$(cfg_get casefold 1)" = 1 ] && [ -f "$CASEFOLD" ]; then
    RO+=( --ro "$CASEFOLD" /nwjs-casefold.js )
fi
# NW.js picks its backend by flag, not from the environment, so tell it what
# was chosen: native Wayland (the host's, or gamescope's exposed socket), else
# X11 (gamescope's private Xwayland, or the host X server).
# There is no session bus in the sandbox. A Wayland crash for want of one was
# seen once (2026-08, game unrecorded) but not with 0.110 or 0.116 since; if a
# game does crash on Wayland, switching it back to Xwayland is the way out.
# webgl=vulkan puts WebGL on ANGLE's Vulkan backend. Left to itself,
# Chromium runs it on OpenGL ES under Wayland (desktop OpenGL under X11), and
# on an RX 9070 with Mesa that drew an RPG Maker lighting plugin's darkness
# solid black beyond a circle round the player; likely the driver computing
# the shader's mediump in 16 bits, which only GLES honours. Vulkan draws it
# right, on the GPU. A preference, not a default: whether it helps or harms
# depends on the GPU and driver.
if [ -n "$APPDIR" ]; then
    if [ "$WL" = 1 ]; then CMD+=( wayland ); else CMD+=( x11 ); fi
    if [ "$(cfg_get webgl auto)" = vulkan ]; then
        CMD+=( --use-angle=vulkan
               "--enable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE" )
    fi
fi
if [ "$PGMMV" = 1 ]; then
    FLAG+=( "--pgmmv${PGMMV_DIR:+=$PGMMV_DIR}" )
elif [ "$MKXP" = 1 ]; then
    FLAG+=( "--mkxp${MKXP_DIR:+=$MKXP_DIR}" )
fi

mkdir -p "$HOME/game-sandboxes"
# Named after the sandbox, like its capture folder, so the manager finds it.
LOG="$HOME/game-sandboxes/${NAME}-lastrun.log"

# Withholding --mangohud is not enough to keep the overlay away from NW.js:
# sandbox-game also opts in from an inherited MANGOHUD=1, and that variable
# would reach the game regardless and switch on MangoHud's Vulkan layer. Drop
# it outright for the engines that cannot survive it.
RUN=( "$SANDBOX" )
[ "$ALLOW_MANGOHUD" = 1 ] || RUN=( env -u MANGOHUD "$SANDBOX" )

msg "Launching ${BASE}…"
"${RUN[@]}" "${FLAG[@]}" "${RO[@]}" "$GAMEDIR" "${CMD[@]}" >"$LOG" 2>&1 &
GAME=$!
# sandbox-game's own warnings and notes (no sound restriction, no limits, a
# display it had to change) come before the game starts, and the log only
# reaches a window when the launch fails. So show them once the game is under
# way -- not when it has already died, which gets the failure window instead.
# Its lines, and sandbox-landlock's, say whose they are -- "sandbox-game:
# warning: " -- so a game's own "warning: " lines stay out of it; indented
# lines continue one. The title names the tool, so the lines go without.
(
    sleep 3
    kill -0 "$GAME" 2>/dev/null || exit 0
    w="$(awk '/^sandbox-(game|landlock): (warning|note): / { p = 1; sub(/^sandbox-[a-z]+: /, ""); print; next }
              p && /^ / { sub(/^ +/, "  "); print; next } { p = 0 }' "$LOG")"
    [ -n "$w" ] || exit 0
    notify-send "sandbox-game: ${BASE}" "$w" 2>/dev/null || true
) </dev/null >/dev/null 2>&1 &
NOTE=$!
if wait "$GAME"; then
    kill "$NOTE" 2>/dev/null
    exit 0
else
    rc=$?
    kill "$NOTE" 2>/dev/null
    # A .NET program's starter, finding no runtime it can use, says so in
    # these words and exits 131; the answer is in the preferences.
    HINT=""
    if grep -qE 'You must install (or update )?\.NET' "$LOG" 2>/dev/null; then
        if [[ " ${FLAG[*]} " == *" --dotnet "* ]]; then
            HINT="The sandbox gave this .NET program your .NET runtime, but not a version it accepts. Install the version the log below asks for."
        elif [ "$DOTNET_APP" = 1 ]; then
            HINT='This is a .NET program, and the sandbox has no .NET runtime unless you allow one: turn on ".NET runtime" in Sandbox game preferences.'
        else
            HINT="This is a .NET program, and the sandbox has no .NET runtime. sandbox-game --dotnet gives it yours."
        fi
    fi
    if ! { [ -z "$HINT" ] || printf '%s\n\n' "$HINT"
           echo "exit code: $rc"; echo "log: $LOG"; echo; tail -n 80 "$LOG"; } \
        | dialog log --title="sandbox-game failed (${BASE})"; then
        notify-send "sandbox-game failed (${BASE})" "exit $rc — see $LOG" 2>/dev/null
    fi
    exit "$rc"
fi
