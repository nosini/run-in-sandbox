#!/usr/bin/env python3
"""Host-side GTK dialogs. Requests and preference responses use plain JSON."""
import argparse
import ipaddress
import json
import os
import re
import sys
import tempfile
from pathlib import Path

DISPLAY_CHOICES = {
    "wayland": "Native Wayland",
    "wayland-x11": "Native Wayland + private X11 (split)",
    "wayland-gamescope": "Native Wayland, in gamescope",
    "x11": "X11, in gamescope (private Xwayland)",
    "host-x11": "Host X11 (other X apps can watch and control it)",
}

SECURITY_CHOICES = {
    "separate_uid": [("0", "None — run as the desktop user"),
                     ("1", "Subordinate uid — newuidmap (persistent uid)"),
                     ("systemd", "Systemd — nsresourced / mountfsd (transient uid)")],
    "seccomp_policy": [("denylist", "Denylist — block known dangerous calls"),
                       ("allowlist", "Allowlist — also block calls outside the allowed list")],
    "seccomp": [("enforce", "Enforce — refuse blocked calls"),
                ("log", "Log only — allow calls and request audit logging")],
}


# Dropdowns that can leave their setting to the defaults (for a game) or to
# the built-in value (for the defaults): the file keys each one writes.
INHERITED = {
    "launch_with": ("launch_with",),
    "display": ("wayland", "wayland_x11", "gamescope", "host_x11"),
    "x11_backend": ("x11_backend",),
    "proton": ("proton",),
    "nwjs": ("nwjs",),
    "casefold": ("casefold",),
    "webgl": ("webgl",),
    "with_proton": ("with_proton",),
    "resolution": ("gamescope_args",),
}


def display_of(values):
    if values.get("host_x11") == "1":
        return "host-x11"
    if values.get("wayland") == "1":
        if values.get("wayland_x11") == "1":
            return "wayland-x11"
        return "wayland-gamescope" if values.get("gamescope") == "1" else "wayland"
    return "x11"


def file_choice(key, values):
    """What one settings file chooses for a dropdown; {} gives the built-in value."""
    value = values.get(key, "")
    if key == "display":
        return display_of(values)
    if key == "resolution":
        return gamescope_parts(values.get("gamescope_args", ""))[0]
    if key == "launch_with":
        return "proton" if value == "proton" else "auto"
    if key == "x11_backend":
        return "satellite" if value == "satellite" else "gamescope"
    if key == "casefold":
        return "0" if value == "0" else "1"
    if key == "webgl":
        return "vulkan" if value == "vulkan" else "auto"
    if key in ("proton", "nwjs"):
        return value or "auto"
    return value


# The variable each protection choice overrides; unset everywhere, it decides.
SECURITY_VARIABLES = {"separate_uid": "SANDBOX_SEPARATE_UID", "seccomp_policy": "SANDBOX_SECCOMP_POLICY",
                      "seccomp": "SANDBOX_SECCOMP"}


def environment_choice(key, value):
    """A protection variable's value as sandbox-game reads it, or None if it refuses it."""
    if key == "separate_uid":
        return value if value in ("1", "systemd") else "0"
    if key == "seccomp":
        return "log" if value == "log" else "enforce"
    return value if value in ("denylist", "allowlist") else None


def security_choices(key, default_label, value):
    choices = [("", default_label), *SECURITY_CHOICES[key]]
    if value not in {value for value, _ in choices}:
        choices.append((value, f"Invalid saved value: {value}"))
    return choices


def requirements_value(text):
    asked = re.split(r"[\s,]+", text)
    return ",".join(key for key, _ in REQUIREMENTS if "all" in asked or key in asked)


class Appearance:
    """Application-wide theme; previewing never writes the desktop settings."""

    def __init__(self, Adw, path=None):
        self.schemes = {"system": Adw.ColorScheme.DEFAULT,
                        "light": Adw.ColorScheme.FORCE_LIGHT,
                        "dark": Adw.ColorScheme.FORCE_DARK}
        config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
        self.path = path if path is not None else config / "sandbox-game" / "interface"
        self.saved_theme = "system"
        try:
            for line in self.path.read_text(encoding="utf-8", errors="replace").splitlines():
                key, separator, value = line.partition("=")
                if separator and key.strip() == "theme":
                    self.saved_theme = value.strip()
        except OSError:
            pass
        if self.saved_theme not in self.schemes:
            self.saved_theme = "system"
        self.manager = Adw.StyleManager.get_default()
        self.preview(self.saved_theme)

    def preview(self, theme):
        self.manager.set_color_scheme(self.schemes[theme])

    def save(self, theme):
        if theme == self.saved_theme:
            return
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.path.parent,
                                             prefix=".interface-", delete=False) as stream:
                temporary = Path(stream.name)
                stream.write("theme=" + theme + "\n")
            temporary.replace(self.path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
        self.saved_theme = theme


def gamescope_parts(text):
    """Extract the two GUI options, keeping other command-line words intact."""
    words = text.split()
    width = height = ""
    fullscreen = False
    rest = []
    i = 0
    while i < len(words):
        word = words[i]
        if word in ("-W", "--output-width", "-H", "--output-height"):
            value = words[i + 1] if i + 1 < len(words) else ""
            if word in ("-W", "--output-width"):
                width = value
            else:
                height = value
            i += 2
        else:
            if word in ("-f", "--fullscreen"):
                fullscreen = True
            else:
                rest.append(word)
            i += 1
    return (f"{width}x{height}" if width and height else ""), fullscreen, rest


# The syntax sandbox-game's --allow-lan and --add-host accept, checked as the
# preferences are saved; sandbox-game checks it again (PREF_CHECK) at launch.
LAN_ENTRY = re.compile(r"(?:\[(?P<v6>[0-9a-f:.]+(?:/\d+)?)\]|(?P<v4>[0-9.]+(?:/\d+)?)"
                       r"|(?P<bare6>[0-9a-f]*:[0-9a-f:.]*(?:/\d+)?))"
                       r"(?::(?P<port>\d+(?:-\d+)?))?(?:/(?P<proto>tcp|udp))?", re.I)
HOST_NAME = re.compile(r"[a-z0-9_](?:[a-z0-9_.-]*[a-z0-9_])?", re.I)


def lan_error(text):
    """Why a LAN allowance list is not valid, or None."""
    for word in re.split(r"[\s,]+", text):
        if not word:
            continue
        match = LAN_ENTRY.fullmatch(word)
        try:
            net = ipaddress.ip_network(match["v6"] or match["v4"] or match["bare6"], strict=False)
        except (TypeError, ValueError):
            return f"Not an address or network: {word}"
        if net.is_loopback or net.is_multicast or net.network_address.is_unspecified:
            return f"Not a LAN address: {word}"
        if match["port"]:
            low, _, high = match["port"].partition("-")
            if not 0 < int(low) <= int(high or low) <= 65535:
                return f"No such port: {word}"
    return None


def hosts_error(text):
    """Why a list of hosts entries is not valid, or None."""
    for line in re.split(r"[,\n]", text):
        words = line.split()
        if not words:
            continue
        try:
            ipaddress.ip_address(words[0])
        except ValueError:
            return f"Hosts entry does not start with an address: {line.strip()}"
        if len(words) < 2:
            return f"Hosts entry has no names after {words[0]}"
        for name in words[1:]:
            if not HOST_NAME.fullmatch(name):
                return f"Not a host name: {name}"
    return None


def hosts_lines(value):
    """The saved form, ADDR NAME..., ADDR NAME..., as one entry per line."""
    return "\n".join(entry.strip() for entry in value.split(",") if entry.strip())


def hosts_value(text):
    return ", ".join(" ".join(line.split()) for line in re.split(r"[,\n]", text) if line.strip())


REQUIREMENTS = (
    ("landlock", "Filesystem restrictions (Landlock): the game will not start without them"),
    ("scoped", "Signal and abstract socket scoping (Landlock ABI 6): the game will not start without it"),
    ("private-display", "Private display: no access to the desktop's display server (rules out host X11, "
                        "plain Wayland and split display); the game will not start without it"),
    ("limits", "Memory, CPU and task limits: the game will not start without them"),
    ("audio", "Playback-only sound or none: the game will not start without it"),
    ("seccomp", "Syscall filter enforced, not logging: the game will not start without it"),
)


class Preferences:
    """Preferences that remain unsaved until the window's Save button is used."""

    def __init__(self, request):
        self.request = request
        self.defaults_only = bool(request.get("defaults"))
        self.values = dict(request.get("values", {}))
        for key in ("x11_backend", "proton", "nwjs", "casefold", "webgl", "with_proton"):
            self.values[key] = file_choice(key, self.values)
        for key in ("net", "mangohud", "hdr", "mod_loaders", "steam", "hide_tray", "dotnet", "lan", "mac_vendor", "private_hosts",
                    "hosts_writable"):
            self.values[key] = "1" if self.values.get(key) == "1" else "0"
        for key in ("lan_allow", "hosts"):
            self.values[key] = self.values.get(key, "")
        self.values["require"] = requirements_value(self.values.get("require", ""))
        self.runtime = file_choice("launch_with", self.values)
        self.scope = "all" if self.defaults_only else "game"
        # Keep each scope's protection choices separate, including unsaved
        # edits. An inherited choice must stay inherited after saving.
        self.security_scope = self.scope
        # Legacy callers only send merged values. Their provenance is unknown:
        # leave security settings untouched rather than copy or clear them.
        scopes = request.get("security", {"all": request.get("values", {})} if self.defaults_only else {})
        self.security_scopes = set(scopes)
        # Each file's own values, by scope: what a Default choice stands for.
        self.files = {scope: dict(values) for scope, values in scopes.items()}
        self.security_values = {scope: {key: scopes.get(scope, {}).get(key, "") for key in SECURITY_CHOICES}
                                for scope in ("game", "all")}
        self.values.update(self.security_values[self.scope])
        default_require = scopes.get("all", {}).get("require", "")
        game_require = scopes.get("game", {}).get("require", default_require or self.values["require"])
        self.require_values = {"game": requirements_value(game_require),
                               "all": requirements_value(default_require)}
        self.values["require"] = self.require_values[self.scope]
        self.host_seccomp = os.environ.get("SANDBOX_SECCOMP", "")
        # The defaults' protection choices as saved, not as edited in the "all" scope.
        self.saved_defaults = dict(self.security_values["all"])
        # The backend an existing sandbox keeps while nothing chooses one.
        self.uid_backend = request.get("uid_backend", "")
        self.display = display_of(self.values)
        self.resolution, self.fullscreen, _ = gamescope_parts(
            self.values.get("gamescope_args", ""))
        # A dropdown whose keys this scope's file lacks starts on Default.
        self.inherit = {key: self.offers_default(key) and self.files[self.scope].keys().isdisjoint(keys)
                        for key, keys in INHERITED.items()}
        for key in INHERITED:
            if self.inherit[key]:
                self.choose(key, None)
        self.set_runtime(self.runtime)

    @property
    def engine(self):
        if self.defaults_only:
            return ""  # Defaults cover every engine, independently of Launch with.
        return "proton" if self.runtime == "proton" else self.request.get("engine", "")

    @property
    def displays(self):
        if self.engine == "proton":
            return ["wayland", "wayland-x11", "x11", "host-x11"]
        if self.engine == "native" and self.request.get("renpy_x11"):
            return ["x11", "host-x11"]
        if not self.engine:
            # Unknown, e.g. a folder that is gone: keep whatever was chosen.
            return list(DISPLAY_CHOICES)
        return ["wayland", "wayland-gamescope", "x11", "host-x11"]

    @property
    def proton_controls(self):
        return self.engine in ("proton", "")

    @property
    def native(self):
        return self.engine == "native"

    @property
    def dotnet_controls(self):
        """Only for a program recognised as needing a .NET runtime."""
        return self.defaults_only or (self.native and bool(self.request.get("dotnet")))

    @property
    def with_proton_controls(self):
        """A native launcher beside Windows programs may run Wine itself."""
        return self.defaults_only or (self.native and bool(self.request.get("can_proton")))

    @property
    def nwjs_controls(self):
        return self.defaults_only or self.engine == "nwjs"

    @property
    def lan_controls(self):
        return self.values.get("net") == "1"

    @property
    def lan_allow_controls(self):
        return self.lan_controls and self.values.get("lan") != "1"

    @property
    def hosts_controls(self):
        return self.values.get("private_hosts") == "1"

    @property
    def security_controls(self):
        return self.scope in self.security_scopes

    @property
    def require_controls(self):
        return self.scope == "game" or self.scope in self.security_scopes

    @property
    def effective_seccomp(self):
        mode = self.values["seccomp"]
        if not mode and self.scope == "game":
            mode = self.saved_defaults["seccomp"]
        return mode or self.host_seccomp

    def offers_default(self, key):
        scope = self.security_scope
        # For the defaults, None and No override already are the built-in values.
        return scope in self.files and not (scope == "all" and key in ("with_proton", "resolution"))

    def inherited(self, key):
        """The value a Default choice stands for in the scope being edited."""
        value = file_choice(key, self.files.get("all", {}) if self.security_scope == "game" else {})
        if key == "display" and value not in self.displays:
            value = "wayland" if value == "wayland-x11" and "wayland" in self.displays else "x11"
        return value

    def current(self, key):
        return {"launch_with": self.runtime, "display": self.display,
                "resolution": self.resolution}.get(key, self.values.get(key))

    def inherits(self, key):
        # A value set some other way than through choose() is a choice of its own.
        return self.inherit.get(key, False) and self.current(key) == self.inherited(key)

    def choice(self, key):
        """A dropdown's selection: None for Default."""
        return None if self.inherits(key) else self.current(key)

    def choose(self, key, value):
        self.inherit[key] = value is None
        if value is None:
            value = self.inherited(key)
        if key == "launch_with":
            self.set_runtime(value)
        elif key == "display":
            self.display = value
        elif key == "resolution":
            self.resolution = value
        else:
            self.values[key] = value

    def security_default(self, key):
        """What an unset protection choice stands for here: a value, and where it is from.
        The environment is this window's, normally the desktop's that launches games too."""
        if self.security_scope == "game" and self.saved_defaults[key]:
            return self.saved_defaults[key], "from the defaults"
        variable = SECURITY_VARIABLES[key]
        if os.environ.get(variable):
            return environment_choice(key, os.environ[variable]), "from " + variable
        if key == "separate_uid" and self.security_scope == "game" and self.uid_backend in ("1", "systemd"):
            return self.uid_backend, "this sandbox's current backend"
        return {"separate_uid": "0", "seccomp_policy": "denylist", "seccomp": "enforce"}[key], "built-in"

    def security_choices(self, key):
        value, source = self.security_default(key)
        label = dict(SECURITY_CHOICES[key]).get(value)
        if label is None and source == "from the defaults":
            text = f"Default — invalid saved default: {value}"  # games will not start
        elif label is None:
            text = f"Default — invalid {SECURITY_VARIABLES[key]}={os.environ[SECURITY_VARIABLES[key]]}"
        else:
            text = f"Default — {label.split(' — ')[0]} ({source})"
        return security_choices(key, text, self.values[key])

    def mark_saved(self, result=None):
        if self.scope == "all" and self.security_controls:
            self.saved_defaults.update({key: self.values[key] for key in SECURITY_CHOICES})
        # Later Default choices compare against what the files now hold.
        if result is None or self.scope not in self.files and self.scope != "clear":
            return
        if self.scope == "clear":
            self.files["game"] = {}
            return
        own = self.files[self.scope]
        for key in result.get("inherit", "").split(","):
            for name in INHERITED.get(key, ()):
                own.pop(name, None)
        own.update({key: value for key, value in result.items()
                    if any(key in names for names in INHERITED.values())})
        if "gamescope_resolution" in result and "resolution" not in result.get("inherit", "").split(","):
            width, _, height = result["gamescope_resolution"].partition("x")
            own["gamescope_args"] = " ".join(
                (["-W", width, "-H", height] if height else []) + (["-f"] if result["gamescope_fullscreen"] == "1" else []))

    def error(self):
        """Why the visible settings cannot be saved, or None."""
        if self.scope == "clear":
            return None
        for key, choices in SECURITY_CHOICES.items():
            if self.security_controls and self.values[key] not in ("", *(value for value, _ in choices)):
                return f"Unknown {key} setting: {self.values[key]}"
        if self.security_controls and "seccomp" in self.values["require"].split(",") and self.effective_seccomp == "log":
            return "An enforced syscall filter is required; select Enforce instead of Log only."
        if self.lan_allow_controls and lan_error(self.values["lan_allow"]):
            return lan_error(self.values["lan_allow"])
        if self.hosts_controls and hosts_error(self.values["hosts"]):
            return hosts_error(self.values["hosts"])
        if "private-display" in self.values["require"].split(",") and self.display in (
                "host-x11", "wayland", "wayland-x11"):
            return "A private display is required, which the chosen display does not give."
        if self.split_controls and any(c < " " or c == "\x7f" for c in self.values.get("x11_exe", "")):
            return "The X11 executable cannot contain tabs, line breaks or other control characters."
        return None

    @property
    def split_controls(self):
        return self.display == "wayland-x11" and self.proton_controls

    @property
    def hdr_controls(self):
        """X11 has no HDR; every other display can pass it on."""
        return self.display != "host-x11"

    @property
    def uses_gamescope(self):
        return self.display in ("x11", "wayland-gamescope") or (
            self.display == "wayland-x11" and self.values["x11_backend"] == "gamescope")

    def set_runtime(self, runtime):
        inherited = self.inherits("display")
        self.runtime = runtime
        if inherited:
            self.display = self.inherited("display")
        elif self.display not in self.displays:
            self.display = "wayland" if self.display == "wayland-x11" and "wayland" in self.displays else "x11"

    def set_scope(self, scope):
        self.security_values[self.security_scope] = {key: self.values[key] for key in SECURITY_CHOICES}
        self.require_values[self.security_scope] = self.values["require"]
        inherited = [key for key in INHERITED if self.inherits(key)]
        self.scope = scope
        if scope != "clear":
            self.security_scope = scope
            self.values.update(self.security_values[scope])
            self.values["require"] = self.require_values[scope]
            # Default stays Default, now for the new scope -- unless the
            # defaults file has the value shown, which then is saved there.
            for key in inherited:
                if self.offers_default(key) and (
                        scope == "game" or self.files["all"].keys().isdisjoint(INHERITED[key])):
                    self.choose(key, None)
                else:
                    self.inherit[key] = False

    def result(self):
        if self.scope == "clear":
            return {"scope": "clear"}
        result = {"scope": self.scope,
                  "wayland": "1" if self.display.startswith("wayland") else "0",
                  "wayland_x11": "1" if self.display == "wayland-x11" else "0",
                  "gamescope": "1" if self.display == "wayland-gamescope" else "0",
                  "host_x11": "1" if self.display == "host-x11" else "0",
                  "net": self.values.get("net", "0")}
        if self.request.get("can_proton"):
            result["launch_with"] = self.runtime
        if self.engine != "nwjs":
            result["mangohud"] = self.values.get("mangohud", "0")
        if self.hdr_controls:
            result["hdr"] = self.values["hdr"]
        if self.proton_controls:
            if self.split_controls:
                result["x11_exe"] = self.values.get("x11_exe", "").strip()
                result["x11_backend"] = self.values["x11_backend"]
            for key, fallback in (("proton", "auto"), ("mod_loaders", "0"), ("steam", "0"),
                                  ("hide_tray", "0")):
                result[key] = self.values.get(key, fallback)
        if self.nwjs_controls:
            result["nwjs"] = self.values.get("nwjs", "auto")
            result["casefold"] = self.values.get("casefold", "1")
            result["webgl"] = self.values.get("webgl", "auto")
        if self.dotnet_controls:
            result["dotnet"] = self.values["dotnet"]
        if self.with_proton_controls:
            result["with_proton"] = self.values["with_proton"]
        # Controls shown only under another one are returned only when they
        # show; hidden, the saved values stay as they were.
        if self.lan_controls:
            result["lan"] = self.values["lan"]
            result["mac_vendor"] = self.values["mac_vendor"]
        if self.lan_allow_controls:
            result["lan_allow"] = ", ".join(w for w in re.split(r"[\s,]+", self.values["lan_allow"]) if w)
        result["private_hosts"] = self.values["private_hosts"]
        if self.hosts_controls:
            result["hosts"] = hosts_value(self.values["hosts"])
            result["hosts_writable"] = self.values["hosts_writable"]
        if self.require_controls:
            result["require"] = self.values["require"]
        if self.security_controls:
            result.update({key: self.values[key] for key in SECURITY_CHOICES})
        if self.uses_gamescope:
            # Only these controls are editable here. The persistence layer
            # preserves the destination scope's remaining arguments.
            result["gamescope_resolution"] = self.resolution
            result["gamescope_fullscreen"] = "1" if self.fullscreen else "0"
        # Shown dropdowns left on Default: their keys leave the file. The
        # resolution still goes along, for the fullscreen switch beside it.
        inherit = [key for key in INHERITED if self.inherits(key) and
                   ("gamescope_resolution" if key == "resolution" else INHERITED[key][0]) in result]
        for key in inherit:
            if key != "resolution":
                for name in INHERITED[key]:
                    result.pop(name, None)
        if inherit:
            result["inherit"] = ",".join(inherit)
        return result


def preference_group(Gtk, title, description=None):
    """A shared heading and boxed list for dialogs and manager pages."""
    group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    heading = Gtk.Label(label=title, xalign=0, wrap=True)
    heading.add_css_class("heading")
    group.append(heading)
    if description:
        note = Gtk.Label(label=description, xalign=0, wrap=True)
        note.add_css_class("dim-label")
        group.append(note)
    rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
    rows.add_css_class("boxed-list")
    group.append(rows)
    return group, rows


def preference_row(Gtk, Adw, label, widget):
    """Keep a control with its label, including on wide windows."""
    if isinstance(widget, Gtk.Switch):
        # Keep the switch next to its text even in a maximized manager.
        row = Adw.ActionRow(title=label, use_markup=False, title_lines=0)
        row.add_prefix(widget)
        row.set_activatable_widget(widget)
    else:
        # Long choices and descriptions can wrap without competing for width.
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + side)(12)
        if label:
            title = Gtk.Label(label=label, xalign=0, wrap=True)
            box.append(title)
            title.set_mnemonic_widget(widget)
        widget.set_hexpand(True)
        box.append(widget)
        row = Gtk.ListBoxRow(activatable=False)
        row.set_child(box)
    if label:
        widget.set_tooltip_text(label)
    return row


class Dialog:
    def __init__(self, Gtk, app, mode, request, finish, appearance=None):
        self.Gtk = Gtk
        self.finish = finish
        if appearance is None:
            _, _, Adw = gtk_modules()
            Adw.init()
            appearance = Appearance(Adw)
        self.appearance = appearance
        self.window = Gtk.ApplicationWindow(application=app, title=request.get("title", "Sandbox game"))
        self.window.set_default_size(760, 580 if mode == "preferences" else 220)
        self.window.connect("close-request", self.cancel)
        from gi.repository import Gdk
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda controller, key, *rest: self.cancel() if key == Gdk.KEY_Escape else False)
        self.window.add_controller(keys)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        for side in ("top", "bottom", "start", "end"):
            getattr(outer, "set_margin_" + side)(20)
        if mode == "preferences":
            _, _, Adw = gtk_modules()
            clamp = Adw.Clamp(maximum_size=760, tightening_threshold=560)
            clamp.set_child(outer)
            self.window.set_child(clamp)
        else:
            self.window.set_child(outer)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.body)
        outer.append(scroll)
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, halign=Gtk.Align.END)
        outer.append(buttons)
        self.buttons = buttons
        self.rows = {}
        self.widgets = {}
        self.choices = {}
        if mode == "preferences":
            self.build_preferences(request)
            self.button("Cancel", self.cancel)
            save = self.button("Save", self.save_preferences, "suggested-action")
            self.window.set_default_widget(save)
            self.window.set_focus(self.widgets.get("launch_with", self.widgets["display"]))
        elif mode == "pick":
            self.build_picker(request)
            self.button("Cancel", self.cancel)
            self.pick_button = self.button("Launch", self.save_pick, "suggested-action")
            self.pick_button.set_sensitive(bool(request.get("items")))
            self.window.set_default_widget(self.pick_button)
            self.window.set_focus(self.listbox)
        else:
            text = request.get("text", "")
            if mode == "log":
                self.window.set_default_size(960, 600)
                view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                    wrap_mode=Gtk.WrapMode.WORD_CHAR)
                view.get_buffer().set_text(text)
                self.body.append(view)
            else:
                self.body.append(Gtk.Label(label=text, wrap=True, xalign=0, selectable=True))
            if mode == "question":
                cancel = self.button("Cancel", self.cancel)
                self.window.set_default_widget(cancel)
                self.window.set_focus(cancel)
                self.button(request.get("accept", "Stop"), lambda *_: self.finish(0, None), "destructive-action")
            else:
                close = self.button("Close", lambda *_: self.finish(0, None))
                self.window.set_default_widget(close)
                self.window.set_focus(close)

    def button(self, label, callback, style=None):
        button = self.Gtk.Button(label=label)
        if style:
            button.add_css_class(style)
        button.connect("clicked", callback)
        self.buttons.append(button)
        return button

    def cancel(self, *_):
        self.appearance.preview(self.appearance.saved_theme)
        self.finish(1, None)
        return True

    def section(self, title, description=None):
        group, self.preference_list = preference_group(self.Gtk, title, description)
        self.body.append(group)
        return group

    def row(self, key, label, widget):
        row = preference_row(self.Gtk, self.Adw, label, widget)
        self.preference_list.append(row)
        self.rows[key], self.widgets[key] = row, widget

    def dropdown(self, key, label, options, current, callback):
        widget = self.Gtk.DropDown()
        self.row(key, label, widget)
        self.set_options(key, options, current)
        widget.connect("notify::selected", callback)

    def set_options(self, key, options, current):
        self.choices[key] = options
        self.widgets[key].set_model(self.Gtk.StringList.new([label for _, label in options]))
        keys = [value for value, _ in options]
        self.widgets[key].set_selected(keys.index(current) if current in keys else 0)

    def choice(self, key, label, options):
        """A dropdown whose first entry, Default, leaves the setting to the defaults."""
        self.base_options[key] = options
        self.dropdown(key, label, self.choice_options(key), self.state.choice(key),
                      lambda *_: self.choice_changed(key))

    def choice_options(self, key):
        options = self.base_options[key]
        if not self.state.offers_default(key):
            return options
        value = self.state.inherited(key)
        label = next((label for v, label in options if v == value), value)
        return [(None, "Default — " + label), *options]

    def update_choices(self):
        for key in self.base_options:
            options, current = self.choice_options(key), self.state.choice(key)
            if options != self.choices[key] or current != self.selected(key):
                self.set_options(key, options, current)

    def choice_changed(self, key):
        if not self.updating:
            self.state.choose(key, self.selected(key))
            self.refresh()

    def selected(self, key):
        index = self.widgets[key].get_selected()
        options = self.choices[key]
        return options[index][0] if index < len(options) else options[0][0]

    def switch(self, key, label, value, callback):
        widget = self.Gtk.Switch(active=value, valign=self.Gtk.Align.CENTER)
        self.row(key, label, widget)
        widget.connect("notify::active", callback)

    def entry(self, key, label, value, placeholder):
        widget = self.Gtk.Entry(text=value, placeholder_text=placeholder)
        self.row(key, label, widget)
        widget.connect("changed", lambda widget: self.set_value(key, widget.get_text()))

    def text_area(self, key, label, text):
        """A label above a multi-line text field, both in one row."""
        Gtk = self.Gtk
        view = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, accepts_tab=False,
                            top_margin=6, bottom_margin=6, left_margin=6, right_margin=6)
        view.set_size_request(-1, 110)
        view.get_buffer().set_text(text)
        frame = Gtk.Frame()
        frame.set_child(view)
        self.row(key, label, frame)
        self.widgets[key] = view
        view.get_buffer().connect("changed", lambda buffer: self.set_value(
            key, buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)))

    def toggle(self, key):
        """A switch whose value decides which other controls show."""
        def changed(widget, *_):
            self.set_value(key, "1" if widget.get_active() else "0")
            self.refresh_visibility()
        return changed

    def build_preferences(self, request):
        Gtk = self.Gtk
        _, _, self.Adw = gtk_modules()
        self.state = Preferences(request)
        self.updating = False
        self.base_options = {}
        heading = Gtk.Label(label=request.get("game", ""), xalign=0, wrap=True, selectable=True)
        heading.add_css_class("title-2")
        self.body.append(heading)
        if self.state.defaults_only:
            note = Gtk.Label(label="Used when a game has no setting of its own. "
                                   "Individual game settings take precedence.", xalign=0, wrap=True)
            note.add_css_class("dim-label")
            self.body.append(note)
        self.section("Interface")
        self.dropdown("appearance", "Appearance (all dialogs)",
                      [("system", "System"), ("light", "Light"), ("dark", "Dark")],
                      self.appearance.saved_theme, lambda *_: self.appearance.preview(self.selected("appearance")))
        self.section("Launch and display")
        if request.get("can_proton"):
            self.choice("launch_with", "Launch with", [("auto", "Automatic"), ("proton", "Proton (Windows .exe)")])
        self.choice("display", "Display", [(v, DISPLAY_CHOICES[v]) for v in self.state.displays])
        self.choice("x11_backend", "Private X11 backend",
                    [("gamescope", "Gamescope — one launcher window"),
                     ("satellite", "Satellite — separate desktop windows")])
        self.entry("x11_exe", "X11 executable (optional)", self.state.values.get("x11_exe", ""),
                   "Launcher.exe or a Windows path fragment")
        self.split_note = Gtk.Label(xalign=0, wrap=True,
            label="")
        self.split_note.add_css_class("dim-label")
        self.rows["x11_exe"].get_child().append(self.split_note)
        self.switch("mangohud", "MangoHud overlay", self.state.values.get("mangohud") == "1",
                    lambda widget, *_: self.set_value("mangohud", "1" if widget.get_active() else "0"))
        self.switch("hdr", "HDR, for games that offer it (turn it on in the desktop's display settings too)",
                    self.state.values["hdr"] == "1",
                    lambda widget, *_: self.set_value("hdr", "1" if widget.get_active() else "0"))
        protons = list(dict.fromkeys(["auto", *request.get("protons", [])]))
        pinned = self.state.values["proton"]
        if pinned not in protons:
            protons.append(pinned)
        self.choice("proton", "Proton version", [(p, "Newest installed (auto)" if p == "auto" else p) for p in protons])
        self.switch("mod_loaders", "Mod loaders (BepInEx, MelonLoader, …)", self.state.values.get("mod_loaders") == "1",
                    lambda widget, *_: self.set_value("mod_loaders", "1" if widget.get_active() else "0"))
        self.switch("steam", "Start through Proton's Steam stand-in", self.state.values.get("steam") == "1",
                    lambda widget, *_: self.set_value("steam", "1" if widget.get_active() else "0"))
        self.switch("hide_tray", "Hide Wine's tray icon window", self.state.values.get("hide_tray") == "1",
                    lambda widget, *_: self.set_value("hide_tray", "1" if widget.get_active() else "0"))
        nwjs = list(dict.fromkeys(["auto", *request.get("nwjs_versions", [])]))
        pinned = self.state.values["nwjs"]
        if pinned not in nwjs:
            nwjs.append(pinned)
        self.choice("nwjs", "NW.js version", [(p, "Newest installed (auto)" if p == "auto" else p) for p in nwjs])
        self.choice("casefold", "File names", [("1", "Ignore case, like Windows"), ("0", "Match exactly")])
        self.choice("webgl", "WebGL", [("auto", "Chromium's default"), ("vulkan", "Vulkan")])
        self.switch("dotnet", ".NET runtime (yours, read-only)", self.state.values["dotnet"] == "1",
                    lambda widget, *_: self.set_value("dotnet", "1" if widget.get_active() else "0"))
        native_proton = self.state.values["with_proton"]
        choices = [("", "None"), *[(p, "Newest installed (auto)" if p == "auto" else p) for p in protons]]
        if native_proton not in [value for value, _ in choices]:
            choices.append((native_proton, native_proton))
        self.choice("with_proton", "Proton for a program that starts Wine itself", choices)
        resolutions = list(dict.fromkeys(["", self.state.resolution, request.get("resolution", ""),
                                         "3840x2160", "2560x1440", "1920x1080", "1600x900", "1280x720"]))
        self.choice("resolution", "Gamescope resolution",
                    [(r, r or "No override (the game's own size)") for r in resolutions])
        self.switch("fullscreen", "Gamescope fullscreen", self.state.fullscreen,
                    lambda widget, *_: setattr(self.state, "fullscreen", widget.get_active()))
        self.note = Gtk.Label(xalign=0, wrap=True)
        self.note.add_css_class("dim-label")
        self.body.append(self.note)
        self.section("Network")
        self.switch("net", "Internet (no LAN, nothing on this PC)", self.state.values.get("net") == "1",
                    self.toggle("net"))
        self.switch("lan", "The whole LAN too (still nothing on this PC)", self.state.values["lan"] == "1",
                    self.toggle("lan"))
        self.entry("lan_allow", "LAN addresses allowed anyway", self.state.values["lan_allow"],
                   "10.0.50.105:443, 192.168.1.0/24")
        self.switch("mac_vendor", "Network card address with your card's manufacturer prefix",
                    self.state.values["mac_vendor"] == "1",
                    lambda widget, *_: self.set_value("mac_vendor", "1" if widget.get_active() else "0"))
        self.switch("private_hosts", "Private hosts file (names redirected for this game only)",
                    self.state.values["private_hosts"] == "1", self.toggle("private_hosts"))
        self.text_area("hosts", "Hosts entries, one per line: an address, then the names it is for",
                       hosts_lines(self.state.values["hosts"]))
        self.switch("hosts_writable", "The game may edit its hosts file too",
                    self.state.values["hosts_writable"] == "1",
                    lambda widget, *_: self.set_value("hosts_writable", "1" if widget.get_active() else "0"))
        self.security_group = self.section("Sandbox protections", "Saved choices override environment variables. "
                     "Unset game choices use the defaults, then the environment. "
                     "Without a uid choice, an existing sandbox keeps its previous backend. "
                     "Default shows the environment of this window; a launch from elsewhere can differ.")
        for key, label in (("separate_uid", "Separate uid backend"),
                           ("seccomp_policy", "Seccomp filter"), ("seccomp", "Seccomp mode")):
            self.dropdown(key, label, self.state.security_choices(key),
                          self.state.values[key], lambda *_, key=key: self.set_value(key, self.selected(key)))
        self.security_group.set_visible(self.state.security_controls)
        self.require_group = self.section("Required protections", "The game will not start when a selected protection cannot be enforced.")
        for key, label in REQUIREMENTS:
            self.switch("require_" + key, label, key in self.state.values["require"].split(","),
                        lambda widget, *_, key=key: self.require_changed(key, widget.get_active()))
        self.require_group.set_visible(self.state.require_controls)
        if not self.state.defaults_only:
            self.section("Save settings")
            self.dropdown("scope", "Save for", [("game", "This game only"), ("all", "All games (defaults)"),
                                                ("clear", "Clear this game's settings")], "game", self.scope_changed)
        self.scope_note = Gtk.Label(xalign=0, wrap=True)
        self.scope_note.add_css_class("dim-label")
        self.scope_note.set_visible(False)
        self.body.append(self.scope_note)
        self.error_note = Gtk.Label(xalign=0, wrap=True)
        self.error_note.add_css_class("error")
        self.error_note.set_visible(False)
        self.body.append(self.error_note)
        self.refresh()

    def require_changed(self, key, wanted):
        if not self.updating:
            chosen = set(self.state.values["require"].split(","))
            chosen = chosen | {key} if wanted else chosen - {key}
            self.state.values["require"] = ",".join(k for k, _ in REQUIREMENTS if k in chosen)

    def set_value(self, key, value):
        if not self.updating:
            self.state.values[key] = value

    def scope_changed(self, *_):
        self.state.set_scope(self.selected("scope"))
        self.updating = True
        self.security_group.set_visible(self.state.security_controls)
        self.require_group.set_visible(self.state.require_controls)
        for key, _ in REQUIREMENTS:
            self.widgets["require_" + key].set_active(key in self.state.values["require"].split(","))
        self.updating = False
        for key, row in self.rows.items():
            if key not in ("scope", "appearance"):
                row.set_sensitive(self.state.scope != "clear")
        self.scope_note.set_label(
            "This game's settings will be removed when you save." if self.state.scope == "clear" else
            "This game's own settings still take precedence over defaults."
            if self.state.scope == "all" and self.state.request.get("game_settings") else "")
        self.scope_note.set_visible(bool(self.scope_note.get_label()))
        # Default now stands for this scope's fallback, and may show another value.
        self.refresh()

    def refresh(self):
        self.updating = True
        self.base_options["display"] = [(v, DISPLAY_CHOICES[v]) for v in self.state.displays]
        self.update_choices()
        for key in SECURITY_CHOICES:
            options = self.state.security_choices(key)
            if options != self.choices[key] or self.state.values[key] != self.selected(key):
                self.set_options(key, options, self.state.values[key])
        self.widgets["mangohud"].set_sensitive(self.state.engine != "nwjs")
        self.widgets["mangohud"].set_active(self.state.engine != "nwjs" and self.state.values.get("mangohud") == "1")
        self.updating = False
        self.refresh_visibility()

    def refresh_visibility(self):
        self.rows["x11_backend"].set_visible(self.state.split_controls)
        self.split_note.set_label(
            "Uses desktop Wayland for the game and private X11 for launchers. "
            "Requires a runner with per-process graphics selection; leave the executable blank for its built-in selection. "
            + ("Satellite gives launchers separate desktop windows and keeps their X server alive until the game exits."
               if self.state.values["x11_backend"] == "satellite" else
               "Gamescope stays windowed beside the game; its resolution applies to the X11 windows."))
        self.rows["x11_exe"].set_visible(self.state.split_controls)
        self.split_note.set_visible(self.state.split_controls)
        self.rows["hdr"].set_visible(self.state.hdr_controls)
        self.rows["proton"].set_visible(self.state.proton_controls)
        self.rows["mod_loaders"].set_visible(self.state.proton_controls)
        self.rows["steam"].set_visible(self.state.proton_controls)
        self.rows["hide_tray"].set_visible(self.state.proton_controls)
        for key in ("nwjs", "casefold", "webgl"):
            self.rows[key].set_visible(self.state.nwjs_controls)
        self.rows["resolution"].set_visible(self.state.uses_gamescope)
        # Split display keeps gamescope windowed (see sandbox-game).
        self.rows["fullscreen"].set_visible(self.state.uses_gamescope and self.state.display != "wayland-x11")
        self.rows["dotnet"].set_visible(self.state.dotnet_controls)
        self.rows["with_proton"].set_visible(self.state.with_proton_controls)
        self.rows["lan"].set_visible(self.state.lan_controls)
        self.rows["lan_allow"].set_visible(self.state.lan_allow_controls)
        self.rows["mac_vendor"].set_visible(self.state.lan_controls)
        for key in ("hosts", "hosts_writable"):
            self.rows[key].set_visible(self.state.hosts_controls)
        self.note.set_label("MangoHud is unavailable with NW.js." if self.state.engine == "nwjs" else "")
        self.note.set_visible(self.state.engine == "nwjs")

    def save_preferences(self, *_):
        error = self.state.error()
        if error:
            self.error_note.set_label(error)
            self.error_note.set_visible(True)
            return
        try:
            self.appearance.save(self.selected("appearance"))
        except OSError as error:
            self.error_note.set_label(f"Cannot save appearance: {error}")
            self.error_note.set_visible(True)
            return
        self.finish(0, self.state.result())

    def build_picker(self, request):
        Gtk = self.Gtk
        self.items = request.get("items", [])
        self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        for item in self.items:
            label = Gtk.Label(label=item, xalign=0, selectable=False, wrap=True)
            label.set_margin_top(10)
            label.set_margin_bottom(10)
            self.listbox.append(label)
        self.body.append(self.listbox)
        if self.items:
            self.listbox.select_row(self.listbox.get_row_at_index(0))
        self.listbox.connect("row-activated", self.save_pick)

    def save_pick(self, *_):
        row = self.listbox.get_selected_row()
        if row is not None:
            self.finish(0, self.items[row.get_index()])


def gtk_modules():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio, Gtk
    return Gio, Gtk, Adw


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["check", "preferences", "pick", "info", "error", "question", "log"])
    parser.add_argument("--title", default="Sandbox game")
    parser.add_argument("--text", default="")
    args = parser.parse_args()
    try:
        Gio, Gtk, Adw = gtk_modules()
    except (ImportError, ValueError) as error:
        print(f"sandbox-game: GTK 4, libadwaita and PyGObject are needed for dialogs: {error}", file=sys.stderr)
        return 2
    if args.mode == "check":
        return 0
    Adw.init()
    appearance = Appearance(Adw)
    request = {"title": args.title, "text": args.text.replace("\\n", "\n")}
    if args.mode in ("preferences", "pick"):
        request.update(json.load(sys.stdin))
    elif args.mode == "log":
        # Game output can use a Windows encoding. Bypass stdin's locale/error
        # policy so undecodable bytes never become surrogates handed to GTK.
        request["text"] = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    result = 1
    app = Gtk.Application(application_id="eu.nosini.SandboxGame.Dialog", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def finish(code, response):
        nonlocal result
        result = code
        if response is not None:
            print(json.dumps(response) if isinstance(response, dict) else response, flush=True)
        app.quit()

    def activate(application):
        dialog = Dialog(Gtk, application, args.mode, request, finish, appearance)
        # Keep signal callbacks and their state alive until the window closes.
        application.dialog = dialog
        dialog.window.present()

    app.connect("activate", activate)
    app.run([])
    return result


if __name__ == "__main__":
    sys.exit(main())
