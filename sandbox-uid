#!/usr/bin/env -S python3 -I
"""sandbox-uid: run a sandbox as a user of its own, as Android runs each app.

Opt-in (SANDBOX_SEPARATE_UID=1, read by sandbox-game). Everything else keeps
the game away from what is yours: its own mounts, PIDs and network, Landlock,
the seccomp filter. All of that still runs as your uid, though, and to the
kernel the game is you: any file of yours it can name, any socket of yours it
can reach -- the session bus, the user manager, ssh-agent, PipeWire's full
socket -- takes it for you. Under a uid of its own a slip in any of those
layers lands on ordinary permissions that are not yours, and those services
turn it away.

An unprivileged process can map only its own uid into a user namespace; any
other takes newuidmap/newgidmap and a subordinate range in /etc/subuid and
/etc/subgid, the same as rootless Podman. So the sandbox gets a namespace of
its own, around bwrap's:

  outer uid  YOUR_UID  = subordinate uid  BASE + OFFSET + INDEX  (the game)
  outer uid  0         = your uid         (sets up, then is dropped)
  outer gid  YOUR_GID  = subordinate gid  BASE + OFFSET + INDEX
  outer gid  CLIENTS   = subordinate gid  BASE + OFFSET          (every sandbox)
  outer gid  RENDER    = the GPU's render group, when /etc/subgid lists it

The game keeps the uid number it always saw -- bwrap maps it to itself -- but
on the host its files and processes belong to a uid that owns nothing else.
INDEX is per sandbox (CAP/uid), so no two sandboxes share one either. OFFSET
keeps clear of the uids rootless Podman's containers use, which are the same
range read from the bottom.

As outer root, before dropping to that uid:
  - The capture's writable folders become the sandbox user's (see own()),
    and stay so between runs, with ACL entries that let you change them by
    hand all the same, also while it runs (see share()).
  - Folders it may not traverse on the way to anything bwrap binds -- your
    0700 home, /run/user/UID -- are covered, in this namespace only, by an
    empty tmpfs holding just those paths, so bwrap finds them while the rest
    stays as closed to that uid as your permissions make it. Nothing on the
    disk changes.
  - bwrap's overlays become fuse-overlayfs mounts served as the sandbox user
    (see overlays()), and standard output and error a pipe of its own when
    they are yours (see relay_output()).

Sockets it must connect to (Wayland for gamescope, the sandbox sound server)
need write permission for the CLIENTS group; sandbox-game grants that with an
ACL entry, which the socket's owner may add without root.

SANDBOX_SEPARATE_UID=systemd is another way to the same end, with no
/etc/subuid and no fuse-overlayfs (see "The systemd backend" below): the
game's uid is a transient one of systemd-nsresourced's, and its folders stay
yours on disk, idmapped to it by systemd-mountfsd.

Commands:
  sandbox-uid index CAP            print CAP's index, allocating it once
  sandbox-uid ids CAP              print "UID CLIENTS_GID" on the host,
                                   allocating CAP's index once
  sandbox-uid launch CAP -- BWRAP...
  sandbox-uid run CAP -- CMD...    CMD as outer root: owner of your files and
                                   the sandbox's alike (like `podman unshare`);
                                   only for a CAP that has an index (one of
                                   the systemd backend's: just CMD, as you)
  sandbox-uid share CAP            after a run: open what the game changed in
                                   its own folder (CAP/rw) to you again
  sandbox-uid forget CAP           once CAP is yours again: drop the ACL
                                   entries its uid had
  sandbox-uid managed-available    whether the systemd backend's services
                                   answer
  sandbox-uid managed-adopt CAP    make CAP's overlay readable to the kernel's
                                   overlayfs (once, on switching to systemd)
  sandbox-uid managed-launch CAP [--net SPEC] -- BWRAP...
                                   SPEC: sandbox-game's network rules (see
                                   NET_HELPER there), as JSON
"""
import array
import ctypes
import errno
import fcntl
import json
import os
import pwd
import re
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import time

OFFSET = 50000
MS_BIND, MS_REC, MS_NOSUID, MS_NODEV, MS_NOEXEC = 4096, 16384, 2, 4, 8
MS_PRIVATE = 1 << 18
CLONE_NEWNS, CLONE_NEWUSER = 0x20000, 0x10000000
CLONE_NEWNET, CLONE_NEWIPC = 0x40000000, 0x8000000
PR_SET_PDEATHSIG, PR_SET_NO_NEW_PRIVS = 1, 38
# In CAP once own() has handed all of it over and shared it with you; `run`,
# which may change any of that, removes it, and the next launch does it all
# again. (".handed-over" was the same before the sharing.)
HANDED_OVER, OLD_HANDED_OVER = ".shared", ".handed-over"
# Outer gids for the groups that are not the sandbox's own. Above anything a
# desktop allocates, and checked against your own gid below.
CLIENTS_OUTER, RENDER_OUTER = 4000000000, 4000000001


def fail(msg):
    sys.stderr.write(f"sandbox-uid: {msg}\n")
    sys.exit(1)


def subordinate(path, need):
    """(start, count) of the first range for this user covering NEED ids."""
    me = pwd.getpwuid(os.getuid()).pw_name
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = []
    ranges = []
    for line in lines:
        parts = line.strip().split(":")
        if len(parts) == 3 and parts[0] in (me, str(os.getuid())) \
           and parts[1].isdigit() and parts[2].isdigit():
            ranges.append((int(parts[1]), int(parts[2])))
    return ranges, next(((s, c) for s, c in ranges if c >= need), None)


def listed(ranges, gid):
    return any(s <= gid < s + c for s, c in ranges)


def index_of(cap, allocate=True):
    """CAP/uid, allocated under a lock on the sandboxes' folder."""
    path = os.path.join(cap, "uid")
    try:
        with open(path) as f:
            value = f.read().strip()
        if value.isdigit() and int(value) > 0:
            return int(value)
    except FileNotFoundError:
        pass
    if not allocate:
        fail(f"{cap} has no uid of its own")
    root = os.path.dirname(os.path.abspath(cap))
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        used = set()
        for name in os.listdir(root):
            try:
                with open(os.path.join(root, name, "uid")) as f:
                    value = f.read().strip()
            except OSError:
                continue
            if value.isdigit():
                used.add(int(value))
        n = 1
        while n in used:
            n += 1
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write(f"{n}\n")
        os.replace(tmp, path)
        return n
    finally:
        os.close(fd)


def layout(cap, allocate=True):
    """Everything about this sandbox's ids, from /etc/sub[ug]id."""
    n = index_of(cap, allocate)
    _, uids = subordinate("/etc/subuid", OFFSET + n + 1)
    granges, gids = subordinate("/etc/subgid", OFFSET + n + 1)
    if not uids or not gids:
        fail(f"no subordinate range of at least {OFFSET + n + 1} ids for "
             f"{pwd.getpwuid(os.getuid()).pw_name} in /etc/subuid and /etc/subgid "
             "(see \"A uid of its own\" in the README)")
    if os.getgid() in (CLIENTS_OUTER, RENDER_OUTER):
        fail("your gid collides with the outer group ids")
    lay = {"uid": uids[0] + OFFSET + n, "gid": gids[0] + OFFSET + n,
           "clients": gids[0] + OFFSET, "user": pwd.getpwuid(os.getuid()).pw_name}
    # The render nodes' group, but never root's: that one owns far more than
    # devices. Only when an administrator listed it for you in /etc/subgid.
    render = {os.stat(f"/dev/dri/{d}").st_gid for d in sorted(os.listdir("/dev/dri"))
              if d.startswith("renderD")} if os.path.isdir("/dev/dri") else set()
    render = [g for g in render if g != 0 and listed(granges, g)]
    if render:
        lay["render"] = render[0]
    return lay


libc = ctypes.CDLL(None, use_errno=True)


def check(ret, what=None):
    if ret != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), what)


def mount(src, dst, fstype, flags, data=None):
    check(libc.mount(src and src.encode(), dst and dst.encode(), fstype and fstype.encode(),
                     flags, data and data.encode()), dst)


def unshare(flags):                     # os.unshare is Python 3.12's
    check(libc.unshare(flags))


def enter(lay):
    """Make this process root of a user and mount namespace of the
    sandbox's. Only a process outside may map ids for one, so a child does,
    with newuidmap and newgidmap -- what unshare(1) does too, but older
    releases of that take one mapping per kind."""
    u, g = os.getuid(), os.getgid()
    uids = [0, u, 1, u, lay["uid"], 1]
    gids = [0, g, 1, g, lay["gid"], 1, CLIENTS_OUTER, lay["clients"], 1]
    if "render" in lay:
        gids += [RENDER_OUTER, lay["render"], 1]
    parent = os.getpid()
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        status = 1
        try:
            os.close(w)
            if os.read(r, 1) == b"1":
                status = 0
                for tool, ids in (("newuidmap", uids), ("newgidmap", gids)):
                    status = status or os.spawnvp(os.P_WAIT, tool,
                                                  [tool, str(parent), *map(str, ids)])
        except BaseException as e:
            os.write(2, f"sandbox-uid: {e}\n".encode())
            status = 1
        os._exit(1 if status else 0)
    os.close(r)
    try:
        unshare(CLONE_NEWUSER | CLONE_NEWNS)
        os.write(w, b"1")
    except OSError as e:
        fail(f"cannot make a user namespace: {e}")
    finally:
        os.close(w)
        mapped = os.waitpid(pid, 0)[1] == 0
    if not mapped:
        fail("newuidmap or newgidmap could not map the sandbox's ids")
    mount(None, "/", None, MS_REC | MS_PRIVATE)


# ---- inside the outer namespace, as its root ------------------------------

# bwrap's options and how many arguments each takes; the sources are what
# bwrap opens on the host side, and the writable ones need to be the game's.
ARITY = {
    "--args": 1, "--argv0": 1, "--userns": 1, "--userns2": 1, "--pidns": 1,
    "--uid": 1, "--gid": 1, "--hostname": 1, "--chdir": 1, "--unsetenv": 1,
    "--lock-file": 1, "--sync-fd": 1, "--remount-ro": 1, "--exec-label": 1,
    "--file-label": 1, "--proc": 1, "--dev": 1, "--tmpfs": 1, "--mqueue": 1,
    "--dir": 1, "--seccomp": 1, "--add-seccomp-fd": 1, "--block-fd": 1,
    "--userns-block-fd": 1, "--info-fd": 1, "--json-status-fd": 1,
    "--cap-add": 1, "--cap-drop": 1, "--perms": 1, "--size": 1, "--chmod": 2,
    "--overlay-src": 1, "--tmp-overlay": 1, "--ro-overlay": 1, "--overlay": 3,
    "--setenv": 2, "--symlink": 2, "--file": 2, "--bind-data": 2,
    "--ro-bind-data": 2, "--bind": 2, "--bind-try": 2, "--dev-bind": 2,
    "--dev-bind-try": 2, "--ro-bind": 2, "--ro-bind-try": 2, "--bind-fd": 2,
    "--ro-bind-fd": 2,
}


def sources(argv):
    """[(path, writable)] of what bwrap will open on the host."""
    out, i = [], 1
    while i < len(argv):
        a = argv[i]
        if a == "--":
            break
        if not a.startswith("--"):
            break
        n = ARITY.get(a, 0)
        if a in ("--bind", "--bind-try"):
            out.append((argv[i + 1], True))
        elif a in ("--ro-bind", "--ro-bind-try", "--dev-bind", "--dev-bind-try",
                   "--overlay-src"):
            out.append((argv[i + 1], False))
        elif a == "--overlay":
            out += [(argv[i + 1], True), (argv[i + 2], True)]
        i += 1 + n
    return [(p, w) for p, w in out if os.path.lexists(p)]


def overlays(argv, mounts):
    """bwrap's overlays, which it cannot mount for this uid: overlayfs keeps
    a copied-up file's owner, which is you, and you do not exist in the
    sandbox's namespace (EOVERFLOW). Each becomes a --bind of MOUNTS/N, where
    fuse-overlayfs, running as the sandbox user, shows the layers as that
    user's. Returns (new argv, [(mountpoint, lowers, upper, work)]); an upper
    of None is a throwaway layer, in a tmpfs."""
    out, specs, lowers, i = argv[:1], [], [], 1
    while i < len(argv):
        a = argv[i]
        if a == "--" or not a.startswith("--"):
            out += argv[i:]
            break
        n = ARITY.get(a, 0)
        if a == "--overlay-src":
            lowers.append(argv[i + 1])
        elif a in ("--overlay", "--tmp-overlay"):
            upper, work, dest = (argv[i + 1:i + 4] if a == "--overlay"
                                 else (None, None, argv[i + 1]))
            mp = os.path.join(mounts, str(len(specs)))
            specs.append((mp, lowers, upper, work))
            out += ["--bind", mp, dest]
            lowers = []
        elif a == "--ro-overlay":
            fail("--ro-overlay is not supported under a uid of its own")
        else:
            out += argv[i:i + 1 + n]
        i += 1 + n
    return out, specs


def close_others(keep):
    """Every descriptor above 2 but those in KEEP."""
    edges = sorted(set(keep))
    for lo, hi in zip([2, *edges], [*edges, 1 << 20]):
        os.closerange(lo + 1, hi)


def fuse_overlay(mp, lowers, upper, work, uid, gid):
    """Mount MP as fuse-overlayfs, served by a daemon that is the sandbox
    user and nothing more. Root here mounts /dev/fuse (the daemon could not),
    the daemon gets the descriptor and the layers as descriptors -- no paths
    to traverse or to parse commas and colons in -- and ends with bwrap.
    served() says when it is ready."""
    dev = os.open("/dev/fuse", os.O_RDWR)
    mount("fuse-overlayfs", mp, "fuse.fuse-overlayfs", MS_NOSUID | MS_NODEV,
          f"fd={dev},rootmode=40000,user_id={uid},group_id={gid},default_permissions")
    # bwrap names the bottom layer first, fuse-overlayfs the top one.
    layers = list(reversed(lowers))
    parent = os.getpid()
    pid = os.fork()
    if pid == 0:
        try:
            keep = [dev, *layers, *(fd for fd in (upper, work) if isinstance(fd, int))]
            for fd in keep:
                os.set_inheritable(fd, True)
            close_others(keep)
            # It answers the game's every file request, from outside the
            # sandbox's namespaces, filter and Landlock: should the game take
            # it over, it is the sandbox user still, with no network either.
            unshare(CLONE_NEWNET | CLONE_NEWIPC)
            libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
            os.setgroups([])
            os.setgid(gid)
            os.setuid(uid)
            # After the uid change, which clears it; bwrap is this pid soon.
            libc.prctl(PR_SET_PDEATHSIG, 15, 0, 0, 0)
            if os.getppid() != parent:
                os._exit(1)
            opts = ["lowerdir=" + ":".join(f"/proc/self/fd/{fd}" for fd in layers),
                    f"upperdir=/proc/self/fd/{upper}", f"workdir=/proc/self/fd/{work}",
                    f"squash_to_uid={uid}", f"squash_to_gid={gid}"]
            os.execvp("fuse-overlayfs", ["fuse-overlayfs", "-f", "-o", ",".join(opts),
                                         f"/dev/fd/{dev}"])
        except BaseException as e:
            os.write(2, f"sandbox-uid: fuse-overlayfs: {e}\n".encode())
        os._exit(127)
    os.close(dev)
    return pid


def served(mounts, uid, gid):
    """Wait until each fuse-overlayfs answers. A stat of its mount waits for
    that, and fails once the daemon is gone; it has to come from the sandbox
    user, the only one the mount lets in."""
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(gid)
            os.setuid(uid)
            for mp in mounts:
                os.stat(mp)
            os._exit(0)
        except BaseException as e:
            os.write(2, f"sandbox-uid: fuse-overlayfs: {e}\n".encode())
        os._exit(1)
    # One that hangs instead would leave every access to its mount hanging.
    deadline = time.monotonic() + 30
    while not (done := os.waitpid(pid, os.WNOHANG))[0]:
        if time.monotonic() > deadline:
            os.kill(pid, 9)
            os.waitpid(pid, 0)
            fail("fuse-overlayfs did not answer")
        time.sleep(0.002)
    if done[1] != 0:
        fail("fuse-overlayfs could not serve the game's folders")


def own(cap, srcs, uid, gid, user):
    """The capture's writable folders become the sandbox user's, and are
    shared with you: in full the first time, and again whenever HANDED_OVER is
    gone; otherwise only what has become yours since -- a file you moved in,
    which has no ACL of its own."""
    cap = os.path.realpath(cap)
    stamp = os.path.join(cap, HANDED_OVER)
    whole = not os.path.exists(stamp)
    shared, given = [], []
    for path, writable in srcs:
        real = os.path.realpath(path)
        if not writable or not (real == cap or real.startswith(cap + "/")) \
           or not os.path.lexists(real):
            continue
        st = os.lstat(real)
        if st.st_uid not in (0, uid):
            # The uid of a range /etc/subuid no longer gives, most likely.
            fail(f"{real} belongs to a uid this sandbox does not have; to give the "
                 f"capture back to you, as root: chown -R {user}: {cap}")
        if st.st_uid == 0:
            os.lchown(real, uid, gid)
            given.append(real)
        shared.append(real)
        if stat.S_ISDIR(st.st_mode):
            hand_over(real, st.st_dev, uid, gid, given)
    if whole:
        share(shared, uid, recurse=True)
        os.close(os.open(stamp, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o644))
        try:
            os.unlink(os.path.join(cap, OLD_HANDED_OVER))
        except FileNotFoundError:
            pass
    else:
        share(given, uid)


def share(paths, uid, recurse=False):
    """PATHS -- with RECURSE, and all under them -- get an ACL entry each for
    you (outer 0) and for the sandbox user, and folders the same as defaults,
    which all that is made in them takes on: by the game, or by you. You can
    then change its files by hand, while it runs too, and what you put there
    it can change in turn.

    It takes the game's umask to keep that up (see inside_launch()): through
    fuse-overlayfs the mode a file is made with, after the umask, caps every
    entry. What is copied up from the game's own folder keeps the mode it has
    there, which keep_shared() makes up for during the run, and `share`
    after it."""
    spec = f"u:0:rwX,u:{uid}:rwX,m::rwX"
    defaults = f",d:u::rwx,d:u:0:rwx,d:u:{uid}:rwx,d:g::rwx,d:m::rwx,d:o::r-x"
    if recurse:
        batches = [(["-R", "-m", spec + defaults], paths)]
    else:
        # Only folders can have defaults; links have no ACL at all.
        kinds = [(p, os.lstat(p).st_mode) for p in paths]
        batches = [(["-m", spec + defaults], [p for p, m in kinds if stat.S_ISDIR(m)]),
                   (["-m", spec], [p for p, m in kinds if not stat.S_ISDIR(m)
                                   and not stat.S_ISLNK(m)])]
    for args, todo in batches:
        for i in range(0, len(todo), 1000):
            r = subprocess.run(["setfacl", "-P", *args, "--", *todo[i:i + 1000]])
            if r.returncode:
                fail("could not share the sandbox's files with you (setfacl)")


ACL_ACCESS, ACL_DEFAULT = "system.posix_acl_access", "system.posix_acl_default"
ACL_USER_OBJ, ACL_USER, ACL_GROUP_OBJ, ACL_MASK, ACL_OTHER = 1, 2, 4, 0x10, 0x20
NO_ID = 0xFFFFFFFF
IN_ATTRIB, IN_MOVED_TO, IN_CREATE = 0x4, 0x80, 0x100
IN_Q_OVERFLOW, IN_IGNORED, IN_ISDIR = 0x4000, 0x8000, 0x40000000
IN_ONLYDIR, IN_DONT_FOLLOW = 0x01000000, 0x02000000


def acl_unpack(data):
    """{(tag, id): perm} of an ACL attribute."""
    return {(tag, i): perm for tag, perm, i in struct.iter_unpack("<HHI", data[4:])}


def acl_pack(entries):
    return struct.pack("<I", 2) + b"".join(
        struct.pack("<HHI", tag, perm, i) for (tag, i), perm in sorted(entries.items()))


def reshare(path, uid):
    """share() for one entry of the sandbox user's, as that user: an owner
    may set its own files' ACLs. One that is not its own -- yours, or a link
    put in the way -- it cannot change, nor wants to."""
    try:
        st = os.lstat(path)
        if st.st_uid != uid or not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
            return
        is_dir = stat.S_ISDIR(st.st_mode)
        want = 6 | (1 if is_dir or st.st_mode & 0o111 else 0)
        try:
            old = os.getxattr(path, ACL_ACCESS, follow_symlinks=False)
            acl = acl_unpack(old)
        except OSError:
            old, m = None, st.st_mode
            acl = {(ACL_USER_OBJ, NO_ID): m >> 6 & 7, (ACL_GROUP_OBJ, NO_ID): m >> 3 & 7,
                   (ACL_OTHER, NO_ID): m & 7}
        for key in ((ACL_USER, 0), (ACL_USER, uid), (ACL_MASK, NO_ID)):
            acl[key] = acl.get(key, acl.get((ACL_GROUP_OBJ, NO_ID), 0) if key[0] == ACL_MASK
                               else 0) | want
        new = acl_pack(acl)
        if new != old:
            os.setxattr(path, ACL_ACCESS, new, follow_symlinks=False)
        if is_dir:
            try:
                os.getxattr(path, ACL_DEFAULT, follow_symlinks=False)
            except OSError:
                os.setxattr(path, ACL_DEFAULT, acl_pack({
                    (ACL_USER_OBJ, NO_ID): 7, (ACL_USER, 0): 7, (ACL_USER, uid): 7,
                    (ACL_GROUP_OBJ, NO_ID): 7, (ACL_MASK, NO_ID): 7, (ACL_OTHER, NO_ID): 5}),
                    follow_symlinks=False)
    except OSError:
        pass                                # gone again, or renamed: share after the run


def forget(cap, uid):
    """Once the capture is yours again (see reclaim in sandbox-game), the ACL
    entries share() gave the sandbox's uid go: another sandbox may get that
    uid later. Yours stay; they grant you nothing you do not have."""
    cap = os.path.realpath(cap)
    dev = os.lstat(cap).st_dev
    todo = [cap]
    while todo:
        d = todo.pop()
        try:
            with os.scandir(d) as it:
                entries = [d] + [e.path for e in it]
        except OSError as e:
            fail(f"could not remove the sandbox's ACL entries from {d}: {e}")
        for path in entries:
            try:
                st = os.lstat(path)
            except OSError as e:
                fail(f"could not inspect {path} while removing the sandbox's ACL entries: {e}")
            if st.st_dev != dev or not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
                continue
            if stat.S_ISDIR(st.st_mode) and path != d:
                todo.append(path)
            for name in (ACL_ACCESS, ACL_DEFAULT):
                try:
                    acl = acl_unpack(os.getxattr(path, name, follow_symlinks=False))
                except OSError as e:
                    if e.errno in (errno.ENODATA, errno.ENOTSUP):
                        continue
                    fail(f"could not read {path}'s ACL: {e}")
                if acl.pop((ACL_USER, uid), None) is not None:
                    os.setxattr(path, name, acl_pack(acl), follow_symlinks=False)


def keep_shared(rw, uid, gid):
    """Beside the game, as the sandbox user: what appears in RW -- above all
    what fuse-overlayfs copies up from the game's folder, with the mode it
    has there -- is shared with you as it comes (see share()), so a save
    you edit while the game runs may be in a folder the game shipped. Ends
    with bwrap; the game starts once it watches, or it could miss the first."""
    parent = os.getpid()
    ready_r, ready = os.pipe()
    if os.fork():
        os.close(ready)
        os.read(ready_r, 1)                 # or end of file: it gave up
        os.close(ready_r)
        return
    try:
        os.close(ready_r)
        devnull = os.open("/dev/null", os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        close_others([ready])
        unshare(CLONE_NEWNET | CLONE_NEWIPC)
        libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)
        os.setgroups([])
        os.setgid(gid)
        os.setuid(uid)
        libc.prctl(PR_SET_PDEATHSIG, 15, 0, 0, 0)
        if os.getppid() != parent:
            os._exit(0)
        ino = libc.inotify_init1(os.O_CLOEXEC)
        if ino < 0:
            os._exit(0)
        events = IN_ATTRIB | IN_MOVED_TO | IN_CREATE | IN_ONLYDIR | IN_DONT_FOLLOW
        dirs = {}

        def watch(top, fix):
            # Each folder watched before it is read: what arrives in between
            # is then in one or the other, or both.
            todo = [top]
            while todo:
                d = todo.pop()
                wd = libc.inotify_add_watch(ino, os.fsencode(d), events)
                if wd >= 0:
                    dirs[wd] = d
                if fix:
                    reshare(d, uid)
                try:
                    with os.scandir(d) as it:
                        entries = list(it)
                except OSError:
                    continue
                for e in entries:
                    if e.is_dir(follow_symlinks=False):
                        todo.append(e.path)
                    elif fix:
                        reshare(e.path, uid)

        watch(rw, False)                    # the run before was shared after it
        os.write(ready, b"1")
        os.close(ready)
        while True:
            data = os.read(ino, 65536)
            i = 0
            while i < len(data):
                wd, mask, _, size = struct.unpack_from("<iIII", data, i)
                name = data[i + 16:i + 16 + size].rstrip(b"\0")
                i += 16 + size
                if mask & IN_Q_OVERFLOW:
                    watch(rw, True)
                elif mask & IN_IGNORED:
                    dirs.pop(wd, None)
                elif name and wd in dirs:
                    path = os.path.join(dirs[wd], os.fsdecode(name))
                    if mask & IN_ISDIR and mask & (IN_CREATE | IN_MOVED_TO):
                        watch(path, True)   # with whatever it holds already
                    else:
                        reshare(path, uid)
    except BaseException:
        pass
    os._exit(0)


def hand_over(top, dev, uid, gid, given):
    """Everything under TOP that is yours (outer 0) -- never a stranger's,
    nor anything mounted there -- becomes the sandbox user's, and is added
    to GIVEN."""
    todo = [top]
    while todo:
        try:
            with os.scandir(todo.pop()) as it:
                entries = list(it)
        except OSError:
            continue
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if st.st_dev != dev:
                continue
            if st.st_uid == 0:
                os.lchown(e.path, uid, gid)
                given.append(e.path)
            if stat.S_ISDIR(st.st_mode):
                todo.append(e.path)


def as_user(fn, uid, gid, groups):
    """fn()'s result, as the sandbox user: from a child that becomes it."""
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r)
        try:
            os.setgroups(groups)
            os.setgid(gid)
            os.setuid(uid)
            data = json.dumps(fn()).encode()
            while data:
                data = data[os.write(w, data):]
            os._exit(0)
        except BaseException as e:
            os.write(2, f"sandbox-uid: checking paths: {e}\n".encode())
            os._exit(1)
    os.close(w)
    data = b""
    while chunk := os.read(r, 65536):
        data += chunk
    os.close(r)
    if os.waitpid(pid, 0)[1] != 0:
        sys.exit(1)
    return json.loads(data)


def blocked(paths):
    """For each path, the first folder on the way the caller cannot traverse."""
    out = {}
    for p in paths:
        d = ""
        for part in p.split("/")[1:-1]:
            d += "/" + part
            if not os.access(d, os.X_OK):
                out[p] = d
                break
    return out


def unreadable(paths, deep):
    """Those of PATHS the caller cannot read; for those in DEEP, also the
    first of what each holds that it cannot. Enough to tell a folder open to
    you alone, or a drive mounted that way (dmask=077, fmask=177)."""
    def closed(p):
        try:
            st = os.stat(p)
        except OSError:
            return False                    # gone: bwrap's to report
        if stat.S_ISDIR(st.st_mode):
            return not os.access(p, os.R_OK | os.X_OK)
        return stat.S_ISREG(st.st_mode) and not os.access(p, os.R_OK)
    out = []
    for p in paths:
        if closed(p):
            out.append(p)
        elif p in deep and os.path.isdir(p):
            with os.scandir(p) as it:
                out += [e.path for _, e in zip(range(200), it) if closed(e.path)][:1]
    return out


def stage(paths, block):
    """Cover each blocked folder with a tmpfs holding only PATHS."""
    tops = sorted(set(block.values()), key=len)
    tops = [t for t in tops if not any(t.startswith(o + "/") for o in tops if o != t)]
    # Every one opened before any folder is covered: a link under one may
    # lead under another.
    opened = []
    for top in tops:
        under = sorted({p for p in paths if p.startswith(top + "/")}, key=len)
        # Parents first; a source inside another bound one comes along with it.
        keep = []
        for p in under:
            if not any(p.startswith(k + "/") for k in keep):
                keep.append(p)
        fds = {}
        for p in keep:
            # Links followed: bwrap would, and their targets may be no nearer.
            # One that leads nowhere gets the folders on its way, so that
            # bwrap finds nothing there -- and skips it, as a -try bind.
            try:
                fds[p] = os.open(p, os.O_PATH | os.O_CLOEXEC)
            except OSError:
                fds[p] = None
        opened.append((top, fds))
    for top, fds in opened:
        mount("tmpfs", top, "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=0711")
        for p, fd in fds.items():
            d = top
            for part in os.path.relpath(os.path.dirname(p), top).split("/"):
                if part in ("", "."):
                    continue
                d = os.path.join(d, part)
                if not os.path.isdir(d):
                    os.mkdir(d, 0o711)
            if fd is None:
                continue
            if stat.S_ISDIR(os.fstat(fd).st_mode):
                os.mkdir(p, 0o711)
            else:
                os.close(os.open(p, os.O_CREAT | os.O_WRONLY | os.O_CLOEXEC, 0o600))
            mount(f"/proc/self/fd/{fd}", p, None, MS_BIND | MS_REC)
            os.close(fd)


def relay_output(uid):
    """Standard output and error, when they are a file or pipe of yours open
    for writing: the game may reopen them through /proc/self/fd -- the file
    manager's log file reaches it that way -- and reopening is checked
    against their owner. Put a pipe of the sandbox user's in between, and a
    process copying from it, which ends when the last writer has. The pipe
    is write-only even to its owner, so it reopens as far as the descriptor
    went: written, not read back."""
    seen = {}
    for fd in (1, 2):
        try:
            st = os.fstat(fd)
        except OSError:
            continue
        if (not (stat.S_ISREG(st.st_mode) or stat.S_ISFIFO(st.st_mode)) or st.st_uid == uid
                or fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE == os.O_RDONLY):
            continue
        key = (st.st_dev, st.st_ino)
        if key in seen:
            os.dup2(seen[key], fd)
            continue
        r, w = os.pipe()
        if os.fork() == 0:
            try:
                out = os.dup(fd)
                close_others([r, out])
                os.dup2(os.open("/dev/null", os.O_RDWR), 0)
                os.dup2(0, 1)
                os.dup2(0, 2)
                while data := os.read(r, 65536):
                    while data:
                        data = data[os.write(out, data):]
            except BaseException:
                pass
            os._exit(0)
        os.close(r)
        os.fchmod(w, 0o200)
        os.dup2(w, fd)
        seen[key] = fd
        os.close(w)


def inside_launch(cap, argv):
    lay = json.loads(os.environ.pop("SANDBOX_UID_LAYOUT"))
    g_uid, g_gid = lay["outer_uid"], lay["outer_gid"]
    groups = [CLIENTS_OUTER] + ([RENDER_OUTER] if "render" in lay else [])
    own(cap, sources(argv), g_uid, g_gid, lay["user"])
    # The overlays' mount points: a tmpfs in this namespace alone, on a
    # folder of the capture's, which also holds the throwaway layers.
    mounts = os.path.join(cap, ".mounts")
    argv, specs = overlays(argv, mounts)
    layers = []
    if specs:
        os.makedirs(mounts, exist_ok=True)
        mount("tmpfs", mounts, "tmpfs", MS_NOSUID | MS_NODEV, "mode=0755")
        for mp, lowers, upper, work in specs:
            os.mkdir(mp)
            if upper is None:
                upper, work = mp + ".upper", mp + ".work"
                for d in (upper, work):
                    os.mkdir(d, 0o700)
                    os.chown(d, g_uid, g_gid)
            layers.append((mp, lowers, upper, work))
    # fuse-overlayfs follows its layers' descriptors back to paths, which it
    # must be able to reach as well; upper and work as one, to rename across.
    paths = [os.path.abspath(p) for p, _ in sources(argv)] + [os.path.abspath(argv[0])]
    for mp, lowers, upper, work in layers:
        paths += [os.path.abspath(p) for p in lowers]
        paths.append(os.path.commonpath([os.path.abspath(upper), os.path.abspath(work)]))
    # Where a link leads may be closed to the sandbox user too: a game folder
    # in your home, named by a link from somewhere open. Staged as well.
    paths = list(dict.fromkeys(paths + [os.path.realpath(p) for p in paths]))
    stage(paths, as_user(lambda: blocked(paths), g_uid, g_gid, groups))
    # Staging gets the sandbox user to each path, not into it: what is open to
    # you alone stays so. The game's own folders it must read; anything else
    # it may do without, as a -try bind would.
    game = {f(p) for _, lowers, _, _ in layers for p in lowers
            for f in (os.path.abspath, os.path.realpath)}
    for p in as_user(lambda: unreadable(paths, game), g_uid, g_gid, groups):
        if any(p == q or p.startswith(q + "/") for q in game):
            fail(f"the sandbox's user cannot read {p}, which is open to you alone; make "
                 "the game's folder readable to others (chmod -R o+rX), or mount its "
                 "drive so, or run this game as you (SANDBOX_SEPARATE_UID=0)")
        sys.stderr.write(f"sandbox-uid: warning: the sandbox's user cannot read {p}\n")
    # Opened only now, through the staged paths: upper and work on one mount.
    for mp, lowers, upper, work in layers:
        fds = [os.open(p, os.O_PATH | os.O_DIRECTORY) for p in (*lowers, upper, work)]
        fuse_overlay(mp, fds[:-2], fds[-2], fds[-1], g_uid, g_gid)
        for fd in fds:
            os.close(fd)
    if layers:
        served([mp for mp, *_ in layers], g_uid, g_gid)
    rw = os.path.join(os.path.realpath(cap), "rw")
    if any(os.path.realpath(upper) == rw for _, _, upper, _ in layers):
        keep_shared(rw, g_uid, g_gid)
    os.chdir("/")
    os.setgroups(groups)
    os.setgid(g_gid)
    os.setuid(g_uid)                        # drops every capability with root
    relay_output(g_uid)
    # What it makes is then open to its group, and so to you (see share()).
    os.umask(0o002)
    os.execv(argv[0], argv)


# ---- the systemd backend ---------------------------------------------------
#
# systemd-nsresourced gives an unprivileged caller a user namespace mapped to
# a transient range of 64K host uids, and systemd-mountfsd idmapped mounts of
# folders the caller owns for it, which show the caller's files as that
# namespace's root's. The game is that root, mapped once more, in a child
# namespace, to the uid it always saw:
#
#   game uid YOUR_UID  =  managed root  =  a transient host uid, this launch's
#   managed root, through an idmapped mount  =  you, on disk
#
# So the capture stays yours on disk, between runs and during them, and the
# kernel's overlayfs serves the game's folders. Everything of yours that is not
# delegated stays as closed to the game as your permissions make it, and
# every launch gets a range of its own, gone with its namespace.
NSRESOURCE = "/run/systemd/io.systemd.NamespaceResource"
MOUNTFS = "/run/systemd/io.systemd.MountFileSystem"
SYS_MOVE_MOUNT, SYS_FSOPEN, SYS_FSCONFIG, SYS_FSMOUNT = 429, 430, 431, 432
MOVE_MOUNT_F_EMPTY_PATH, FSCONFIG_SET_FLAG, FSCONFIG_SET_STRING = 4, 0, 1
FSCONFIG_CMD_CREATE, MOUNT_ATTR_NOSUID, MOUNT_ATTR_NODEV = 6, 2, 4
PR_SET_DUMPABLE = 4


class VarlinkError(Exception):
    pass


def varlink(path, method, parameters, fds=()):
    """One Varlink call, descriptors going both ways: (parameters, fds)."""
    received = []
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC) as s:
            s.settimeout(30)
            s.connect(path)
            request = json.dumps({"method": method, "parameters": parameters}).encode() + b"\0"
            sent = s.sendmsg([request], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                          array.array("i", fds))] if fds else [])
            s.sendall(request[sent:])
            reply = b""
            while b"\0" not in reply:
                data, ancillary, flags, _ = s.recvmsg(
                    65536, socket.CMSG_SPACE(16 * array.array("i").itemsize),
                    socket.MSG_CMSG_CLOEXEC)
                for level, kind, value in ancillary:
                    if (level, kind) == (socket.SOL_SOCKET, socket.SCM_RIGHTS):
                        ids = array.array("i")
                        ids.frombytes(value[:len(value) - len(value) % ids.itemsize])
                        received += ids
                if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC):
                    raise VarlinkError("truncated reply")
                if not data:
                    raise VarlinkError("no reply")
                reply += data
                if len(reply) > 1 << 20:
                    raise VarlinkError("reply too long")
        response = json.loads(reply.split(b"\0", 1)[0])
        if "error" in response:
            raise VarlinkError(f"{response['error']} {json.dumps(response.get('parameters', {}))}")
        return response.get("parameters", {}), received
    except BaseException:
        for fd in received:
            os.close(fd)
        raise


def managed_available():
    """Both services answer (their sockets start them)."""
    for path, interface in ((NSRESOURCE, "io.systemd.NamespaceResource"),
                            (MOUNTFS, "io.systemd.MountFileSystem")):
        try:
            reply, fds = varlink(path, "org.varlink.service.GetInterfaceDescription",
                                 {"interface": interface})
        except (OSError, VarlinkError) as e:
            return f"{path}: {e}"
        for fd in fds:
            os.close(fd)
        if interface == "io.systemd.MountFileSystem" \
           and "MountDirectory" not in reply.get("description", ""):
            return "systemd-mountfsd cannot mount directories (systemd 258 or later can)"
    return None


def managed_namespace(name):
    """A user namespace, by descriptor, with a range of nsresourced's: made
    empty by a child that hands it over and exits, then given its 64K ids."""
    ours, theirs = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET | socket.SOCK_CLOEXEC)
    pid = os.fork()
    if pid == 0:
        try:
            ours.close()
            unshare(CLONE_NEWUSER)
            fd = os.open("/proc/self/ns/user", os.O_RDONLY | os.O_CLOEXEC)
            socket.send_fds(theirs, [b"ns"], [fd])
            os._exit(0)
        except BaseException as e:
            os.write(2, f"sandbox-uid: {e}\n".encode())
        os._exit(1)
    theirs.close()
    try:
        _, fds, _, _ = socket.recv_fds(ours, 16, 1, socket.MSG_CMSG_CLOEXEC)
    finally:
        ours.close()
        os.waitpid(pid, 0)
    if len(fds) != 1:
        fail("cannot make a user namespace")
    try:
        _, extra = varlink(NSRESOURCE, "io.systemd.NamespaceResource.AllocateUserRange", {
            "name": name, "mangleName": True, "size": 65536, "target": 0,
            "userNamespaceFileDescriptor": 0}, fds)
    except (OSError, VarlinkError) as e:
        os.close(fds[0])
        fail(f"systemd-nsresourced gave no user namespace: {e}")
    for fd in extra:
        os.close(fd)
    return fds[0]


def delegate(path, ns, read_only):
    """A detached mount of PATH, a folder of yours, idmapped for NS: your
    files its root's."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        reply, fds = varlink(MOUNTFS, "io.systemd.MountFileSystem.MountDirectory", {
            "directoryFileDescriptor": 0, "userNamespaceFileDescriptor": 1, "mode": "root",
            "readOnly": read_only, "allowInteractiveAuthentication": False}, [fd, ns])
    except (OSError, VarlinkError) as e:
        fail(f"systemd-mountfsd would not mount {path} for the sandbox: {e}")
    finally:
        os.close(fd)
    index = reply.get("mountFileDescriptor")
    mnt = fds.pop(index) if type(index) is int and 0 <= index < len(fds) else None
    for extra in fds:
        os.close(extra)
    if mnt is None:
        fail(f"systemd-mountfsd returned no mount for {path}")
    return mnt


def mount_points():
    """Every mount point here, decoded."""
    out = set()
    with open("/proc/self/mountinfo") as f:
        for line in f:
            out.add(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), line.split()[4]))
    return out


def canonical(argv):
    """ARGV with every source bwrap opens on the host taken to its real
    path: bwrap resolves them itself, and what is delegated is mounted where
    a link leads, not where it is."""
    out, i = argv[:1], 1
    while i < len(argv):
        a = argv[i]
        if a == "--" or not a.startswith("--"):
            out += argv[i:]
            break
        n = ARITY.get(a, 0)
        args = argv[i + 1:i + 1 + n]
        if a in ("--bind", "--bind-try", "--ro-bind", "--ro-bind-try", "--dev-bind",
                 "--dev-bind-try", "--overlay-src") and os.path.lexists(args[0]):
            args[0] = os.path.realpath(args[0])
        elif a == "--overlay":
            args[:2] = [os.path.realpath(p) for p in args[:2]]
        out += [a, *args]
        i += 1 + n
    return out


def reachable(path, want):
    """Whether a uid that is neither the owner of PATH and its folders nor in
    their group may get there and use it (WANT: os.R_OK and the like), by
    their permissions for others."""
    d = ""
    for part in path.split("/")[1:-1]:
        d += "/" + part
        if not os.stat(d).st_mode & 0o001:
            return False
    mode = os.stat(path).st_mode
    if stat.S_ISDIR(mode):
        want |= os.X_OK
    return all(mode & bit for ok, bit in ((os.R_OK, 0o004), (os.W_OK, 0o002), (os.X_OK, 0o001))
               if want & ok)


def delegations(argv, specs, extra=()):
    """[(folder, writable)] to delegate, parents first, so that every source
    of ARGV and every layer of SPECS can be reached and used by the managed
    root: a folder of yours itself, or the folder of yours it is in.
    mountfsd mounts only that folder, without what is mounted below it."""
    me, mounts = os.getuid(), mount_points()
    needs = [(p, w) for p, w in sources(argv)] + list(extra)
    for _, lowers, upper, work in specs:
        needs += [(p, False) for p in lowers]
        if upper is not None:
            # One mount for both, or overlayfs cannot rename between them.
            needs.append((os.path.commonpath([upper, work]), True))
    want = {}
    for path, writable in needs:
        st = os.stat(path)
        parent = os.path.dirname(path)
        if stat.S_ISDIR(st.st_mode) and st.st_uid == me:
            folder = path
        elif os.stat(parent).st_uid == me:
            folder = parent
        elif reachable(path, 0 if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode))
                       else os.R_OK | (os.W_OK if writable else 0)):
            continue                        # a device or socket: bwrap needs only the way
        else:
            fail(f"the sandbox's user cannot reach {path}, and neither it nor its folder "
                 "is yours to share with it")
        want[folder] = want.get(folder, False) or writable
    out = []
    for folder in sorted(want, key=len):
        # One already delegated covers it, unless a mount lies in between.
        cover = next((f for f in reversed(out) if folder.startswith(f[0].rstrip("/") + "/")),
                     None)
        if cover and (cover[1] or not want[folder]) and not any(
                m == folder or (m.startswith(cover[0].rstrip("/") + "/")
                                and folder.startswith(m.rstrip("/") + "/"))
                for m in mounts):
            continue
        out.append((folder, want[folder]))
    return out


def attach(fd, path):
    check(libc.syscall(SYS_MOVE_MOUNT, fd, b"", -100, os.fsencode(path),
                       MOVE_MOUNT_F_EMPTY_PATH), path)


def place(delegated):
    """Each delegated folder's mount where the folder is. One the managed
    root cannot get to -- in your 0700 home, say -- is first covered, in this
    namespace alone, by an empty tmpfs holding just the folders on the way."""
    tops = {}
    for path, _ in delegated:
        if any(path.startswith(p.rstrip("/") + "/") for p, _ in delegated if p != path):
            continue                        # in another one: placed with it
        d = ""
        for part in path.split("/")[1:-1]:
            d += "/" + part
            if not os.access(d, os.X_OK):
                tops[path] = d
                break
    covered = set()
    for top in sorted(set(tops.values()), key=len):
        if not any(top.startswith(c + "/") for c in covered):
            mount("tmpfs", top, "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC, "mode=0755")
            covered.add(top)
    for path, fd in delegated:
        if path in tops:
            d = ""
            for part in path.split("/")[1:]:
                d += "/" + part
                if len(d) > len(tops[path]) and not os.path.isdir(d):
                    os.mkdir(d, 0o755)
        attach(fd, path)
        os.close(fd)


def kernel_overlay(mp, lowers, upper, work):
    """overlayfs at MP, set up through descriptors: no commas or colons in a
    path read as anything else. Its errors are in the context's log."""
    ctx = libc.syscall(SYS_FSOPEN, b"overlay", 1)
    check(-1 if ctx < 0 else 0, "fsopen overlay")

    def conf(cmd, key=None, value=None):
        if libc.syscall(SYS_FSCONFIG, ctx, cmd, key and key.encode(),
                        value and os.fsencode(value), 0) < 0:
            e = ctypes.get_errno()
            log = b""
            try:
                os.set_blocking(ctx, False)
                while msg := os.read(ctx, 4096):
                    log += msg + b"; "
            except OSError:
                pass
            fail(f"cannot mount the overlay for {mp}: {os.strerror(e)} {log.decode(errors='replace')}")

    try:
        # bwrap names the bottom layer first, overlayfs the top one.
        for lower in reversed(lowers):
            conf(FSCONFIG_SET_STRING, "lowerdir+", lower)
        conf(FSCONFIG_SET_STRING, "upperdir", upper)
        conf(FSCONFIG_SET_STRING, "workdir", work)
        conf(FSCONFIG_SET_FLAG, "userxattr")
        conf(FSCONFIG_CMD_CREATE)
        fd = libc.syscall(SYS_FSMOUNT, ctx, 1, MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV)
        check(-1 if fd < 0 else 0, f"fsmount {mp}")
    finally:
        os.close(ctx)
    attach(fd, mp)
    os.close(fd)


def managed_network(net):
    """The game's network namespace, made here, so that it belongs to the
    managed namespace, where the game has no capabilities -- and set up as
    sandbox-game's NET_HELPER sets up bwrap's for the other backends: pasta
    stays in the network we are in, as the game's way out, and sandbox-game's
    rules go in. pasta runs under a keeper, which the kernel tells when the
    sandbox ends (the outer bwrap, this process now): no pid file, and
    nothing that can outlive it."""
    target = f"/proc/{os.getpid()}/ns/net"
    # Which pasta opens as the managed root: changing to it cleared
    # dumpability, and with it left /proc/PID to the host's root.
    check(libc.prctl(PR_SET_DUMPABLE, 1, 0, 0, 0), "PR_SET_DUMPABLE")
    go_r, go = os.pipe()
    keeper = os.fork()
    if keeper == 0:
        try:
            os.close(go)
            parent = os.getppid()
            libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0)
            ends = {signal.SIGTERM, signal.SIGINT, signal.SIGHUP}
            signal.pthread_sigmask(signal.SIG_BLOCK, ends | {signal.SIGCHLD})
            if os.getppid() != parent:
                os._exit(0)
            devnull = os.open("/dev/null", os.O_RDWR)
            os.dup2(devnull, 0)
            os.dup2(devnull, 1)
            close_others([go_r])
            if os.read(go_r, 1) != b"1":
                os._exit(0)                 # setup failed: nothing to serve
            os.close(go_r)
            pasta = os.fork()
            if pasta == 0:
                signal.pthread_sigmask(signal.SIG_SETMASK, set())
                os.execv(net["pasta"], [
                    net["pasta"], "--quiet", "--foreground", "--config-net", "--netns-only",
                    "--netns", target, "--no-netns-quit",
                    "-t", "none", "-u", "none", "-T", "none", "-U", "none",
                    "--map-host-loopback", "none", "--map-guest-addr", "none",
                    "--dns-forward", net["dns"], "--ns-mac-addr", net["mac"],
                    *([] if net["ipv6"] else ["-4"])])
            while True:
                sig = signal.sigwait(ends | {signal.SIGCHLD})
                if sig != signal.SIGCHLD:
                    os.kill(pasta, signal.SIGTERM)
                    os.waitpid(pasta, 0)
                    break
                if os.waitpid(pasta, os.WNOHANG)[0]:
                    break
        except BaseException as e:
            os.write(2, f"sandbox-uid: pasta: {e}\n".encode())
        os._exit(0)
    os.close(go_r)
    unshare(CLONE_NEWNET)
    os.write(go, b"1")
    os.close(go)
    ip = shutil.which("ip", path="/usr/sbin:/sbin:/usr/bin:/bin")
    if not ip:
        fail("the network needs ip (iproute2)")

    def configured():
        for ver in ("4", "6") if net["ipv6"] else ("4",):
            out = subprocess.run([ip, "-j", f"-{ver}", "route", "show", "default"],
                                 capture_output=True, text=True).stdout
            if json.loads(out or "[]"):
                return True
        return False

    deadline = time.monotonic() + 15
    while not configured():
        if os.waitpid(keeper, os.WNOHANG)[0] or time.monotonic() > deadline:
            fail("pasta did not set up the sandbox's network")
        time.sleep(0.02)
    for ver, rules in net["rules"].items():
        if subprocess.run([ip, f"-{ver}", "-batch", "-"], input="\n".join(rules) + "\n",
                          text=True).returncode:
            fail("could not apply the sandbox's network rules")


def managed_launch(cap, argv, net=None):
    me, my_gid = os.getuid(), os.getgid()
    argv = canonical(argv)
    mounts = os.path.join(os.path.realpath(cap), ".mounts")
    argv, specs = overlays(argv, mounts)
    if specs:
        os.makedirs(mounts, exist_ok=True)
    if net:
        # bwrap keeps the network namespace made here (see managed_network).
        if "--unshare-all" not in argv:
            fail("managed-launch --net: the command does not unshare the network")
        at = argv.index("--unshare-all") + 1
        argv[at:at] = ["--share-net"]
    # pasta runs from its folder too: sandbox-game names a copy after the game.
    wanted = delegations(argv, specs, [(os.path.realpath(net["pasta"]), False)] if net else ())
    ns = managed_namespace(f"sandbox-game-{os.getpid()}")
    # How sandbox-game --stop and sandbox-attach tell this sandbox's processes
    # from any others (see sandbox_user in sandbox-game-lib): the outer bwrap
    # runs in a namespace whose parent is this one. Where the game cannot
    # reach it: the capture's own folder is not in the sandbox.
    st = os.fstat(ns)
    record = os.path.join(os.path.realpath(cap), ".managed-userns")
    with open(record + ".tmp", "w") as f:
        f.write(f"{st.st_dev} {st.st_ino}\n")
    os.replace(record + ".tmp", record)
    delegated = [(path, delegate(path, ns, not writable)) for path, writable in wanted]
    # In there, root: but not yours, so none of your files is ours but
    # through those mounts. setns leaves the ids unmapped until changed.
    check(libc.setns(ns, CLONE_NEWUSER), "setns")
    os.close(ns)
    os.setgroups([])
    os.setresgid(0, 0, 0)
    os.setresuid(0, 0, 0)
    unshare(CLONE_NEWNS)
    mount(None, "/", None, MS_REC | MS_PRIVATE)
    place(delegated)
    if specs:
        mount("tmpfs", mounts, "tmpfs", MS_NOSUID | MS_NODEV, "mode=0755")
    for mp, lowers, upper, work in specs:
        os.mkdir(mp)
        if upper is None:
            upper, work = mp + ".upper", mp + ".work"
            for d in (upper, work):
                os.mkdir(d, 0o700)
        kernel_overlay(mp, lowers, upper, work)
    if net:
        managed_network(net)
    # What is yours of standard output and error, the game could not reopen.
    relay_output(0)
    # The game's own namespace inside, its root seen as your uid: what the
    # game always was. Changing to root above cleared dumpability, without
    # which the map files would be the initial namespace's root's.
    check(libc.prctl(PR_SET_DUMPABLE, 1, 0, 0, 0), "PR_SET_DUMPABLE")
    unshare(CLONE_NEWUSER)
    for name, text in (("setgroups", "deny"), ("uid_map", f"{me} 0 1\n"),
                       ("gid_map", f"{my_gid} 0 1\n")):
        with open(f"/proc/self/{name}", "w") as f:
            f.write(text)
    check(libc.prctl(PR_SET_DUMPABLE, 1, 0, 0, 0), "PR_SET_DUMPABLE")
    os.chdir("/")
    os.execv(argv[0], argv)


def managed_adopt(cap):
    """CAP/rw as the kernel's overlayfs reads it. fuse-overlayfs -- the
    subordinate-uid backend's, or this script's fallback -- marks a folder
    the game replaced as opaque in a way of its own, which overlayfs ignores,
    and the folder's old files would show through again. Its whiteouts are
    overlayfs's own. Both kinds of marks are kept: fuse-overlayfs reads
    overlayfs's too, so the capture can go back."""
    rw = os.path.join(os.path.realpath(cap), "rw")
    if not os.path.isdir(rw) or os.path.islink(rw):
        return
    dev = os.lstat(rw).st_dev
    todo = [rw]
    while todo:
        d = todo.pop()
        try:
            opaque = os.getxattr(d, "user.fuseoverlayfs.opaque", follow_symlinks=False) == b"y"
        except OSError:
            opaque = False
        marker = os.path.join(d, ".wh..wh..opq")
        if opaque or os.path.lexists(marker):
            os.setxattr(d, "user.overlay.opaque", b"y", follow_symlinks=False)
            if os.path.lexists(marker):
                os.unlink(marker)
        with os.scandir(d) as it:
            for e in it:
                st = e.stat(follow_symlinks=False)
                if st.st_dev != dev:
                    continue
                if stat.S_ISDIR(st.st_mode):
                    todo.append(e.path)
                elif e.name.startswith(".wh.") and stat.S_ISREG(st.st_mode):
                    # A whiteout fuse-overlayfs could not make as a device.
                    os.unlink(e.path)
                    os.mknod(os.path.join(d, e.name[4:]), stat.S_IFCHR | 0o000, 0)


def main():
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "--inside":
        cap, rest = args[1], args[2:]
        if rest[:1] == ["--"]:
            rest = rest[1:]
        inside_launch(cap, rest)
    if args == ["managed-available"]:
        why = managed_available()
        if why:
            fail(f"the systemd backend is not available: {why}")
        return
    if len(args) >= 2 and args[0] in ("managed-adopt", "managed-launch"):
        cap, rest, net = args[1], args[2:], None
        if args[0] == "managed-launch" and rest[:1] == ["--net"] and len(rest) > 1:
            net, rest = json.loads(rest[1]), rest[2:]
        if rest[:1] == ["--"]:
            rest = rest[1:]
        if args[0] == "managed-adopt":
            managed_adopt(cap)
            return
        if not rest:
            fail("managed-launch: no command")
        managed_launch(cap, rest, net)
    if len(args) < 2:
        fail(__doc__.split("Commands:")[1])
    cmd, cap, rest = args[0], args[1], args[2:]
    if rest[:1] == ["--"]:
        rest = rest[1:]
    if cmd not in ("index", "ids", "run", "launch", "share", "forget"):
        fail(f"unknown command: {cmd}")
    if cmd == "run" and os.path.exists(os.path.join(cap, "managed-uid")) \
       and not os.path.exists(os.path.join(cap, "uid")):
        # The systemd backend's: its files are yours on disk already.
        if not rest:
            fail("run: no command")
        try:
            os.execvp(rest[0], rest)
        except OSError as e:
            fail(f"{rest[0]}: {e.strerror}")
    if cmd == "index":
        print(index_of(cap))
        return
    # Maintenance gives no capture a uid it did not have: that is
    # SANDBOX_SEPARATE_UID's.
    lay = layout(cap, allocate=cmd not in ("run", "share", "forget"))
    if cmd == "ids":
        print(lay["uid"], lay["clients"])
        return
    if cmd == "forget":
        forget(cap, lay["uid"])
        return
    if cmd == "share":
        # Copied up during the run, those files have the mode of the game's
        # own (see share()). The sandbox user is your uid in there.
        rw, uid = os.path.join(os.path.realpath(cap), "rw"), os.getuid()
        enter(lay)
        if os.path.isdir(rw) and not os.path.islink(rw):
            share([rw], uid, recurse=True)
        return
    if not rest:
        fail(f"{cmd}: no command")
    uid, gid = os.getuid(), os.getgid()
    if cmd == "run":
        # It may well leave files of yours in there: the next launch looks.
        try:
            os.unlink(os.path.join(cap, HANDED_OVER))
        except FileNotFoundError:
            pass
        enter(lay)
        try:
            os.execvp(rest[0], rest)
        except OSError as e:
            fail(f"{rest[0]}: {e.strerror}")
    enter(lay)
    # Started again in here. For ptrace and much of /proc a process belongs
    # to the user namespace it was started in; once it has dropped to the
    # sandbox's uid, only one with that capability there may look into it --
    # in yours, root alone. This way the output relay (forked after that)
    # stays open to you, as bwrap and the rest of the sandbox are.
    os.environ["SANDBOX_UID_LAYOUT"] = json.dumps({**lay, "outer_uid": uid, "outer_gid": gid})
    os.execv(sys.executable, [sys.executable, "-I", os.path.realpath(__file__),
                              "--inside", cap, "--", *rest])


if __name__ == "__main__":
    main()
