[Unit]
Description=Reconcile experimental sandbox render-device aliases
BindsTo=run-sandboxgame-render.mount
After=systemd-udevd.service run-sandboxgame-render.mount
Before=systemd-user-sessions.service
RequiresMountsFor=/usr/local/libexec/sandbox-game

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/sandbox-game/systemd-render-devices --enable
# The udev rule reloads on render-node events.
ExecReload=/usr/local/libexec/sandbox-game/systemd-render-devices
# Also runs after a failed start. Ordering keeps the mount available until
# this finishes; systemd ends a running reload first.
ExecStopPost=/usr/local/libexec/sandbox-game/systemd-render-devices --disable
UMask=0077
NoNewPrivileges=yes
# CAP_SYS_RESOURCE: the mount's usrquota limits apply to root's files too,
# and only this capability lets the aliases and their records, and handing a
# revoked user's ones back to root, go past them.
CapabilityBoundingSet=CAP_MKNOD CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SYS_RESOURCE
ProtectSystem=strict
ReadWritePaths=/run/sandboxgame/render
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=none
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
