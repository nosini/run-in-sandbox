#!/usr/bin/env bash
# sandbox-attach [--name NAME] [--list] [--shell|--exec] [CMD...]
#   Launch a second program inside a sandbox that is already running, in the
#   same Wine session as the game -- which is what Cheat Engine, regedit or
#   winetricks need in order to see the game at all.
#
#   Starting a second sandbox-game would not do: --unshare-all gives every
#   launch its own PID and mount namespace, so the new process could not see
#   the game's processes, and Wine's server socket lives in /tmp/.wine-$UID,
#   which is a tmpfs private to each sandbox. Same prefix on disk, second
#   wineserver, no contact. So have the running sandbox start it instead:
#   its sandbox-landlock stays behind for that (see --attach there), and puts
#   what it starts under the game's own Landlock rules, one level above the
#   game -- where it can read the game's memory and the game cannot reach it.
#
#   Windows programs are run with Proton's own wine binary against the live
#   prefix, NOT with `proton run`: the run verb re-enters prefix setup, which
#   has no business touching a prefix a game is currently using, and in
#   practice it exits silently without starting anything.
#
#   Without --name it attaches to the only sandbox running, or asks which one
#   when there are several. Without a program it starts Cheat Engine from the
#   shared tools folder, which every sandbox has read-only at /tools:
#     ~/.local/share/sandbox-game/tools/     ($SANDBOX_TOOLS_DIR overrides)
#
#   sandbox-attach                         # Cheat Engine, into the running game
#   sandbox-attach --list
#   sandbox-attach --name witcher3 ~/game-sandboxes/witcher3/home/setup.exe
#   sandbox-attach --shell                 # a shell inside, to look around
#   sandbox-attach --exec -- ps -ef        # a native command inside
#
# Host paths into the tools folder or ~/game-sandboxes/NAME/home -- which is
# $HOME inside -- are translated to where they appear in there. Anything copied
# into that home shows up at once; the tools folder is only mounted at launch,
# so a game started before it existed has to be restarted to see it.
set -euo pipefail

SELF="${0##*/}"
usage() {
    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//; $d'
    exit "${1:-0}"
}

NAME=""; MODE=wine; LIST=0
# Must match sandbox-game, which mounts this folder at /tools.
TOOLS="${SANDBOX_TOOLS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sandbox-game/tools}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --list)   LIST=1; shift ;;
        --shell)  MODE=shell; shift ;;
        --exec)   MODE="exec"; shift ;;
        --name)   NAME="$2"; shift 2 ;;
        --name=*) NAME="${1#--name=}"; shift ;;
        -h|--help) usage 0 ;;
        --)       shift; break ;;
        -*)       echo "$SELF: unknown option: $1" >&2; usage 1 >&2 ;;
        *)        break ;;
    esac
done

# ---- find the running sandboxes -------------------------------------------
# As sandbox-game --stop finds them: by the outer bwrap, which runs in our own
# user namespace -- where nothing a game starts can be -- and binds the
# capture's home: `--bind ~/game-sandboxes/NAME/home $HOME`. Its one child is
# the sandbox's pid 1, whose root is the sandbox's: the way in to its socket.
# A process inside a game could name any capture dir on its command line, so
# that alone says nothing.
#
# Sets SB_PIDS / SB_NAMES / SB_PROTON in parallel, one entry per sandbox.
SB_PIDS=(); SB_NAMES=(); SB_PROTON=()
scan() {
    local p args i name child
    for p in /proc/[0-9]*; do
        p="${p##*/}"
        [[ "/proc/$p/ns/user" -ef /proc/self/ns/user ]] || continue
        # Grouped so a process exiting mid-scan does not print anything.
        { mapfile -d '' -t args < "/proc/$p/cmdline"; } 2>/dev/null || continue
        [ "${#args[@]}" -gt 1 ] && [ "${args[0]##*/}" = bwrap ] || continue
        name=""
        for ((i = 1; i < ${#args[@]}; i++)); do
            [ "${args[i-1]}" = --bind ] || continue
            [[ "${args[i]}" == "$HOME/game-sandboxes/"*/home ]] || continue
            name="${args[i]#"$HOME/game-sandboxes/"}"; name="${name%/home}"; break
        done
        [ -n "$name" ] && [[ "$name" != */* ]] || continue
        # No newline after the last PID, so read fails even when it got one.
        child=""; { read -r child _ < "/proc/$p/task/$p/children"; } 2>/dev/null || true
        [ -n "$child" ] && ! [[ "/proc/$child/ns/user" -ef /proc/self/ns/user ]] || continue
        SB_PIDS+=( "$child" ); SB_NAMES+=( "$name" )
        [[ " ${args[*]} " == *" STEAM_COMPAT_DATA_PATH "* ]] && SB_PROTON+=( 1 ) || SB_PROTON+=( 0 )
    done
}
scan

if [ "$LIST" = 1 ]; then
    [ "${#SB_PIDS[@]}" -gt 0 ] || { echo "no sandboxes running"; exit 0; }
    printf '%-28s %-8s %s\n' NAME PID KIND
    for i in "${!SB_PIDS[@]}"; do
        [ "${SB_PROTON[$i]}" = 1 ] && k=proton || k=native
        printf '%-28s %-8s %s\n' "${SB_NAMES[$i]}" "${SB_PIDS[$i]}" "$k"
    done
    exit 0
fi

[ "${#SB_PIDS[@]}" -gt 0 ] || { echo "$SELF: no sandbox is running" >&2; exit 1; }

TARGET=""; TNAME=""; TPROTON=0
if [ -n "$NAME" ]; then
    for i in "${!SB_PIDS[@]}"; do
        [ "${SB_NAMES[$i]}" = "$NAME" ] || continue
        TARGET="${SB_PIDS[$i]}"; TNAME="${SB_NAMES[$i]}"; TPROTON="${SB_PROTON[$i]}"; break
    done
    [ -n "$TARGET" ] || { echo "$SELF: no running sandbox named '$NAME'" >&2
                          echo "try: $SELF --list" >&2; exit 1; }
elif [ "${#SB_PIDS[@]}" = 1 ]; then
    TARGET="${SB_PIDS[0]}"; TNAME="${SB_NAMES[0]}"; TPROTON="${SB_PROTON[0]}"
elif [ -t 0 ] && [ -t 2 ]; then
    # Guessing between two running games would attach the debugger to the
    # wrong one. At a terminal, ask.
    LABELS=()
    for i in "${!SB_PIDS[@]}"; do
        [ "${SB_PROTON[$i]}" = 1 ] && k=proton || k=native
        LABELS+=( "${SB_NAMES[$i]} ($k)" )
    done
    PS3="Attach to which sandbox? "; PICK=""
    select label in "${LABELS[@]}"; do
        [ -n "${label:-}" ] && { PICK=$((REPLY - 1)); break; }
        echo "pick a number from the list" >&2
    done
    [ -n "$PICK" ] || exit 1                   # Ctrl-D
    TARGET="${SB_PIDS[$PICK]}"; TNAME="${SB_NAMES[$PICK]}"; TPROTON="${SB_PROTON[$PICK]}"
else
    # And anywhere else, say which are open and stop.
    echo "$SELF: several sandboxes are running -- pick one with --name:" >&2
    for i in "${!SB_PIDS[@]}"; do echo "  ${SB_NAMES[$i]}" >&2; done
    exit 1
fi

[ "$MODE" != wine ] || [ "$TPROTON" = 1 ] || {
    echo "$SELF: '$TNAME' is not a Proton sandbox; use --exec for a native command" >&2
    exit 1; }
# No program named: Cheat Engine is what this is for nine times out of ten.
# The 64-bit build handles 32-bit games too, so it wins when both are there.
if [ "$MODE" = wine ] && [ "$#" -eq 0 ]; then
    for exe in cheatengine-x86_64.exe cheatengine-i386.exe; do
        CE="$(find "$TOOLS" -maxdepth 3 -type f -iname "$exe" 2>/dev/null | sort | head -n1 || true)"
        [ -z "$CE" ] || break
    done
    [ -n "$CE" ] || {
        echo "$SELF: nothing to run, and no Cheat Engine found under $TOOLS" >&2
        echo "unpack it there (e.g. \"$TOOLS/Cheat Engine/\"), or name a program" >&2
        exit 1; }
    set -- "$CE"
fi
[ "$MODE" = shell ] || [ "$#" -gt 0 ] || { echo "$SELF: nothing to run" >&2; usage 1 >&2; }

# The capture dir is $HOME inside and the tools folder is /tools, so a host
# path into either is almost certainly meant as the copy visible in there.
# Translate rather than fail with a path that plainly exists.
CAPHOME="$HOME/game-sandboxes/$TNAME/home"
ARGS=(); WANT_TOOLS=0
for a in ${@+"$@"}; do
    case "$a" in
        "$CAPHOME"/*) a="$HOME/${a#"$CAPHOME"/}" ;;
        "$TOOLS"/*)   a="/tools/${a#"$TOOLS"/}"; WANT_TOOLS=1 ;;
    esac
    ARGS+=( "$a" )
done
# Mounts are fixed at launch, so a game started before the tools folder
# existed -- or by an older sandbox-game -- has none. Say that, rather than
# leave Wine to report a missing file with a path that exists on the host.
[ "$WANT_TOOLS" = 0 ] || [ -d "/proc/$TARGET/root/tools" ] || {
    echo "$SELF: '$TNAME' has no /tools -- it was started before $TOOLS existed;" >&2
    echo "restart the game to mount it" >&2; exit 1; }

# ---- what to run once inside ----------------------------------------------
# The sandbox's sandbox-landlock starts it (see --attach there): in the
# sandbox's namespaces, filter and scope, under the game's Landlock rules, in a
# domain one level above the game's -- able to read the game's memory, out of
# the game's reach -- with the game's own environment, as bwrap and gamescope
# gave it. Nothing of ours goes in but the arguments, TERM and stdin, stdout
# and stderr, or a terminal of the sandbox's own when this runs in one.
#
# A Windows program also takes Proton's run-time settings -- library and DLL
# paths -- from wineserver, since Proton works them out only once it runs. The
# game could hand it anything there, as it could through the prefix the
# program loads DLLs and settings from; what it would get is a program as
# confined as itself. The shell reads no rc files, which are the game's too.
INNER='
set -e
mode="$1"; shift
if [ "$mode" = wine ]; then
    donor="$(pgrep -x wineserver 2>/dev/null | head -n1 || true)"
    [ -z "$donor" ] || while IFS= read -r -d "" kv; do
        case "${kv%%=*}" in
            PATH|DISPLAY|XAUTHORITY|WAYLAND_DISPLAY|\
            WINE*|PROTON*|STEAM_COMPAT_*|LD_LIBRARY_PATH|\
            PULSE_*|SDL_*|DXVK_*|VKD3D_*|MESA_*|__*) export "$kv" ;;
        esac
    done < "/proc/$donor/environ"
fi
: "${HOME:=/home/$(id -un)}"; export HOME
: "${PATH:=/usr/bin:/bin}"; export PATH
export WINEPREFIX="${WINEPREFIX:-/compat/pfx}"
case "$mode" in
    shell) exec /bin/bash --norc --noprofile -i ;;
    exec)  exec "$@" ;;
    wine)
        [ -x /proton/files/bin/wine ] || {
            echo "sandbox-attach: /proton/files/bin/wine not found inside" >&2; exit 1; }
        exec /proton/files/bin/wine "$@" ;;
esac
'

# Talks to the starter: sends the request, then either relays a terminal or
# passes on signals, and exits as the program did. Only stdin, stdout and
# stderr go in, never another descriptor of ours.
read -r -d '' CLIENT <<'EOF' || true
import fcntl, json, os, selectors, signal, socket, struct, sys, termios, tty
path, argv = sys.argv[1], sys.argv[2:]
conn = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
try:
    conn.connect(path)
except OSError as e:
    sys.exit(f"sandbox-attach: cannot reach the sandbox: {e.strerror}")
terminal = os.isatty(0) and os.isatty(1)
req = {"argv": argv, "env": {"TERM": os.environ.get("TERM") or "dumb"}, "terminal": terminal}
stdio = []
if terminal:
    req["size"] = list(struct.unpack("4H", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))[:2])
else:
    for fd in (0, 1, 2):
        try:
            os.fstat(fd)
            stdio.append(fd)
        except OSError:
            stdio.append(os.open(os.devnull, os.O_RDWR))
socket.send_fds(conn, [json.dumps(req).encode()], stdio)


def status_of(msg):
    if not msg:
        sys.exit("sandbox-attach: the sandbox ended")
    code = json.loads(msg)["status"]
    return code if code >= 0 else 128 - code


if not terminal:
    def forward(sig, _frame):
        try:
            conn.send(json.dumps({"signal": sig}).encode())
        except OSError:
            pass
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, forward)
    sys.exit(status_of(conn.recv(4096)))

msg, fds, _, _ = socket.recv_fds(conn, 4096, 1)
if not fds:
    status_of(msg)
    sys.exit("sandbox-attach: the sandbox gave no terminal")
master = fds[0]
wake_read, wake = os.pipe()
signal.signal(signal.SIGWINCH, lambda *_: os.write(wake, b"x"))
saved = termios.tcgetattr(0)
tty.setraw(0, termios.TCSADRAIN)        # not TCSAFLUSH: keep what was typed ahead
status = None
try:
    sel = selectors.DefaultSelector()
    sel.register(0, selectors.EVENT_READ, "in")
    sel.register(master, selectors.EVENT_READ, "out")
    sel.register(conn, selectors.EVENT_READ, "status")
    sel.register(wake_read, selectors.EVENT_READ, "size")
    output = True
    while output:
        # Once the program has ended, only what it left behind to read.
        events = sel.select(0.2 if status is not None else None)
        if not events:
            break
        for key, _ in events:
            if key.data == "in":
                data = os.read(0, 65536)
                if data:
                    os.write(master, data)
                else:
                    sel.unregister(0)
            elif key.data == "out":
                try:
                    data = os.read(master, 65536)
                except OSError:             # EIO: nothing has it open any more
                    data = b""
                if data:
                    os.write(1, data)
                else:
                    output = False
            elif key.data == "size":
                os.read(wake_read, 64)
                fcntl.ioctl(master, termios.TIOCSWINSZ,
                            fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
            else:
                status = status_of(conn.recv(4096))
                sel.unregister(conn)
    if status is None:
        status = status_of(conn.recv(4096))
finally:
    termios.tcsetattr(0, termios.TCSADRAIN, saved)
sys.exit(status)
EOF

# On the sandbox's own root, where sandbox-game made it; a sandbox started by
# an older sandbox-game has none.
SOCK="/proc/$TARGET/root/run/sandbox-attach/socket"
[ -S "$SOCK" ] || {
    echo "$SELF: '$TNAME' was started by an older sandbox-game; restart it to attach" >&2
    exit 1; }
exec python3 -I -c "$CLIENT" "$SOCK" /bin/bash -c "$INNER" "$SELF" "$MODE" ${ARGS[@]+"${ARGS[@]}"}
