                                    top_margin=8, left_margin=8, right_margin=8, bottom_margin=8,
                                    accepts_tab=False)
            self.env.set_size_request(-1, 110)
            # Each file's own list, never the merged view: saving that would copy
            # the defaults into this game, or this game's list into the defaults.
            self.env_text = {scope: "\n".join(value.split()) for scope, value in request["env"].items()}
            self.env_scope = "game"
            self.env.get_buffer().set_text(self.env_text["game"])
            self.body.append(Gtk.Label(label="Environment variables for the selected scope (one NAME=value "
                                       "per line). A game's own list replaces the defaults' list.",
                                       xalign=0, wrap=True))
            frame = Gtk.Frame()
            frame.set_child(self.env)
            self.body.append(frame)
            save = Gtk.Button(label="Save settings", halign=Gtk.Align.END)
