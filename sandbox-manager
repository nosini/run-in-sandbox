        def reload(self, select=None, rescan=False, search=False):
            """SEARCH: look for missing games in the game folders too. Only when
            opening, refreshing or changing those folders: it walks them all."""
            selected_name = select or (self.selected or {}).get("name")
            request = object()
            self.reload_request = request
            self.descriptions, self.program_lists = {}, {}
            if rescan:
                with self.proton_lock:
                    self.proton_list = None
            self.count.set_label("Refreshing library…")
            def refresh():
                # Where each game lives, found here once rather than on every keystroke,
                # and whether its folder is there: never looked at on the main thread.
                entries = self.library.refresh() if search else self.library.entries()
                return [(entry, self.library.installation(entry), self.library.folder_state(entry))
                        for entry in entries]
            def loaded(located, error):
                if self.reload_request is not request:
                    return
                if error:
                    self.count.set_label("Could not refresh library")
                    return
                entries = [entry for entry, _, _ in located]
                self.entries = entries
                self.clear(self.listbox)
                self.rows = {}
                for entry, location, folder in located:
                    row = Gtk.ListBoxRow()
                    row.entry = entry
                    row.location = location
                    row.folder = folder
                    box = Gtk.Box(spacing=10)
                    for side in ("top", "bottom", "start", "end"):
                        getattr(box, "set_margin_" + side)(10)
                    row.icon = Gtk.Image(icon_name="applications-games-symbolic", pixel_size=32)
                    if self.icon_paths.get(entry["name"]):
                        row.icon.set_from_file(str(self.icon_paths[entry["name"]]))
                    box.append(row.icon)
                    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, hexpand=True)
                    title = Gtk.Label(label=entry["title"], xalign=0, ellipsize=3)
                    row.state = Gtk.Label(label="Ready", xalign=0)
                    row.state.add_css_class("dim-label")
                    text.append(title)
                    text.append(row.state)
                    box.append(text)
                    row.set_child(box)
                    self.listbox.append(row)
                    self.rows[entry["name"]] = row
                    self.load_icon(entry)
                self.count.set_label(f"{len(entries)} sandbox{'es' if len(entries) != 1 else ''}")
                self.selected = None
                if entries:
                    self.listbox.select_row(self.rows.get(selected_name, self.rows[entries[0]["name"]]))
                else:
                    self.content.set_visible_child_name("empty")
                    self.window_title.set_title("Sandbox Manager")
                self.poll(True)
            self.work(refresh, loaded)

        def select_row(self, _, row):
            if row is None:
                return
            self.appearance.preview(self.appearance.saved_theme)
            self.selected = row.entry
            entry = self.selected
            self.content.set_visible_child_name("detail")
            self.title.set_label(entry["title"])
            # Requested for every row as the library loads; show what it found.
            self.show_icon(self.game_icon, self.icon_paths.get(entry["name"]))
            self.window_title.set_title(entry["title"])
            self.window_title.set_subtitle("Windows sandbox" if entry["kind"] == "windows" else "Game sandbox")
            self.build_overview(entry)
            self.build_programs(entry)
            self.build_settings(entry)
            self.update_log()
            self.update_state()
            self.split.set_show_content(True)

        def load_icon(self, entry):
            with self.icon_wakeup:
                self.icon_requests[entry["name"]] = dict(entry)
                self.icon_wakeup.notify()

        def icon_worker(self):
            while True:
                with self.icon_wakeup:
                    while not self.icon_requests and not self.closed:
                        self.icon_wakeup.wait()
                    if self.closed:
                        return
                    name = next(iter(self.icon_requests))
                    entry = self.icon_requests.pop(name)
                try:
                    path = self.library.icon(entry)
                except Exception:
                    continue  # keep whichever icon is shown
                GLib.idle_add(self.icon_loaded, name, path)

        def icon_loaded(self, name, path):
            with self.icon_wakeup:
                if self.closed or name in self.icon_requests:
                    return False  # a newer request for this game is still to come
            self.icon_paths[name] = path
            row = self.rows.get(name)
            if row:
                self.show_icon(row.icon, path)
            if self.selected and self.selected["name"] == name:
                self.show_icon(self.game_icon, path)
            return False

        @staticmethod
        def show_icon(image, path):
            if path:
                image.set_from_file(str(path))
            else:
                image.set_from_icon_name("applications-games-symbolic")

        def build_overview(self, entry):
            self.clear(self.overview)
            self.label(self.overview, "Game details", "title-3")
            name = Gtk.Entry(text=entry["title"], placeholder_text="Display name")
            name_label = self.label(self.overview, "Display name")
            name_label.set_mnemonic_widget(name)
            self.overview.append(name)
            self.label(self.overview, "Shown in the library. Your sandbox folder and saves keep their existing locations.",
                       "dim-label")
            self.label(self.overview, "Launch", "title-3")
            self.label(self.overview, entry.get("program") or entry.get("selection") or
                       "Locate this game's folder to enable launching.", "dim-label")
            args = Gtk.Entry(text=entry.get("arguments", ""), placeholder_text="Launch arguments (optional)")
            args.set_visible(entry["kind"] == "windows")
            self.overview.append(args)
            def save(*_):
                # Only what was edited, over the entry as saved now: a search
                # may have reconnected the game since this page was built. A
                # name left as shown stays free to follow the game folder.
                changes = {}
                if name.get_text().strip() != entry["title"]:
                    changes.update(title=name.get_text().strip(), title_custom=True)
                if args.get_text() != entry.get("arguments", ""):
                    changes["arguments"] = args.get_text()
                try:
                    self.library.update_entry(entry["name"], **changes)
                    self.reload(entry["name"])
                except (OSError, ValueError) as error:
                    self.toast(error)
            self.button(self.overview, "Save game details", save)
            total, last = self.library.stats(entry["name"])
            played = f"{total // 3600}h {total % 3600 // 60}m" if total else "Not played yet"
            last_text = datetime.fromtimestamp(last).strftime("%d %b %Y, %H:%M") if last else "Never"
            self.label(self.overview, "Activity", "title-3")
            self.activity = self.label(self.overview, f"Time played: {played}\nLast played: {last_text}")
            self.label(self.overview, "Files", "title-3")
