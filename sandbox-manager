        def scope_changed(self, *_):
            super().scope_changed()
            if not hasattr(self, "env"):
                return
            buffer = self.env.get_buffer()
            if self.env_scope != "clear":
                self.env_text[self.env_scope] = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
            self.env_scope = self.state.scope
            if self.env_scope != "clear":
                buffer.set_text(self.env_text[self.env_scope])
            self.env.set_sensitive(self.env_scope != "clear")

        def save(self, *_):
            try:
                error = self.state.error()
                if error:
                    raise ValueError(error)
                result = self.state.result()
                if result["scope"] != "clear":
                    buffer = self.env.get_buffer()
                    # Saved space-separated, so values cannot hold spaces, and
                    # spaces separate entries here as well as new lines do.
                    words = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False).split()
                    for word in words:
                        if not re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*=\S*", word):
                            raise ValueError(f"Use NAME=value, one per line; values cannot contain spaces: {word}")
                        if word.startswith("env="):
                            raise ValueError(f"Leave out the env= in front: {word[4:]}")
                    result["env"] = " ".join(words)
                self.manager.library.save_preferences(self.name, result)
                self.appearance.save(self.selected("appearance"))
                self.error_note.set_visible(False)
                self.manager.toast("Settings saved")
            except (OSError, ValueError) as error:
                self.error_note.set_label(str(error))
                self.error_note.set_visible(True)

