        def close(self, *_):
            self.closed = True
            with self.icon_wakeup:
                self.icon_wakeup.notify()
            self.appearance.preview(self.appearance.saved_theme)
            return False

        def work(self, function, done=None):
            def finish(value, error):
                if self.closed:
                    return False
                if error:
                    self.toast(str(error))
                if done:
                    try:
                        done(value, error)
                    except Exception as failure:
                        self.toast(str(failure))
                return False
            def run():
                try:
                    value, error = function(), None
                except Exception as failure:
                    value, error = None, failure
                GLib.idle_add(finish, value, error)
            threading.Thread(target=run, daemon=True).start()

        def toast(self, message):
            toast = Adw.Toast.new(str(message))
            toast.set_timeout(6)
            if hasattr(toast, "set_use_markup"):
                toast.set_use_markup(False)
            self.overlay.add_toast(toast)

