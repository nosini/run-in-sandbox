        def protons(self):
            with self.proton_lock:
                if self.proton_list is None:
                    self.proton_list = self.library.protons()
                return self.proton_list

        def scan_programs(self, entry, rescan=False):
            if entry["kind"] != "windows":
                self.clear(self.program_list)
                self.program_list.append(Gtk.Label(label="Launchers in an existing game are selected when you press Play.",
                                                  wrap=True, margin_top=14, margin_bottom=14))
                self.install_button.set_visible(entry.get("engine") == "proton")
                return
            def loaded(programs, error):
                if error:
                    return
                self.program_lists[entry["name"]] = programs
                if not self.selected or self.selected["name"] != entry["name"]:
                    return
                self.clear(self.program_list)
                if not programs:
                    self.program_list.append(Gtk.Label(label="No programs found yet. Run an installer to get started.",
                                                      wrap=True, margin_top=18, margin_bottom=18))
                for target, label in programs:
                    row = Adw.ActionRow(title=Path(label.replace("\\", "/")).name, subtitle=label,
                                        use_markup=False)
                    chosen = target == entry.get("program")
                    select = Gtk.Button(label="Selected" if chosen else "Use for Play", valign=Gtk.Align.CENTER)
                    select.set_sensitive(not chosen)
                    def choose(*_, program=target):
                        entry["program"] = program
                        self.library.save_entry(entry)
                        self.load_icon(entry)
                        self.build_overview(entry)
                        self.scan_programs(entry)
                        self.update_state()
                    select.connect("clicked", choose)
                    row.add_suffix(select)
                    self.program_list.append(row)
            if not rescan and entry["name"] in self.program_lists:
                loaded(self.program_lists[entry["name"]], None)
                return
            self.work(lambda: self.library.programs(entry), loaded)

        def build_settings(self, entry):
            self.clear(self.settings_page)
            self.label(self.settings_page, "Loading settings…", "dim-label")
            def load():
                if entry["kind"] == "windows":
                    request = dict(engine="proton", can_proton=False, dotnet=False)
                elif entry.get("selection") and Path(entry["selection"]).exists():
                    key = (entry["name"], entry["selection"])
                    if key not in self.descriptions:
                        self.descriptions[key] = self.library.describe(entry["selection"], entry["name"])
                    request = dict(self.descriptions[key])
                else:
                    request = dict(engine="", can_proton=False)
                request.update(game=entry["title"], values=self.library.settings(entry["name"]),
                               env={"game": self.library.scope_settings(entry["name"]).get("env", ""),
                                    "all": self.library.scope_settings(entry["name"], True).get("env", "")},
                               protons=self.protons(),
                               game_settings=(self.library.config / "games" / entry["name"]).exists())
                return request
            def loaded(request, error):
                if not self.selected or self.selected["name"] != entry["name"]:
                    return
                self.clear(self.settings_page)
                if error:
                    self.label(self.settings_page, str(error))
                    return
                self.preferences = PreferencePane(self, request)
                self.settings_page.append(self.preferences.body)
                if entry["kind"] == "existing":
                    entry["engine"] = self.preferences.state.engine
                    self.install_button.set_visible(entry["engine"] == "proton")
                    self.tools.set_visible(entry["engine"] == "proton")
            self.work(load, loaded)

        def tab_changed(self, *_):
            if self.tabs.get_visible_child_name() == "logs" and self.selected:
                self.update_log()

        def update_log(self):
            if self.selected:
                text = self.library.read_log(self.selected["name"])
                buffer = self.log_view.get_buffer()
                old = buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), False)
                if old != text:
                    buffer.set_text(text)

        def update_state(self):
            live = self.running | {name for name, process in self.processes.items() if process.poll() is None}
            for name, row in self.rows.items():
                row.state.set_label("Starting…" if name in self.pending else "Running" if name in live else
                                    "Choose a launcher" if row.entry["kind"] == "windows" and not row.entry.get("program") else
                                    "Locate game folder" if not row.entry.get("selection") else "Ready")
            if not self.selected:
                return
            entry = self.selected
            name = entry["name"]
            busy = name in live or name in self.pending
            self.status.set_label(self.rows[name].state.get_label())
            self.play.set_label("Stop" if name in self.running else "Starting…" if busy else "Play")
            self.play.set_sensitive(name not in self.pending and (name in self.running or not busy) and
                                    (busy or bool(entry.get("program") if entry["kind"] == "windows" else entry.get("selection"))))
            self.maintenance.set_sensitive(not busy)
            self.install_button.set_sensitive(not busy)
            self.tools.set_sensitive(not busy)

        def poll(self, force=False):
            if self.closed:
                return False
            if self.refreshing:
                return True
            # sandbox-attach scans every process. Every 2 s only while this window
            # is in use or something it started may still run; else every 10 s.
            if not force and not self.pending and not self.processes and not self.window.is_active() \
                    and time.monotonic() - self.last_poll < 10:
                return True
            self.last_poll = time.monotonic()
            self.refreshing = True
            def loaded(running, error):
                self.refreshing = False
                if not error:
                    self.running = running
                finished = []
                for name, process in self.processes.items():
                    code = process.poll()
                    if code is not None:
                        finished.append(name)
                        if code:
                            self.toast(f"{self.rows[name].entry['title'] if name in self.rows else name} exited with code {code}. See Logs for details.")
                        installed = name in self.installers
                        if installed:
                            self.program_lists.pop(name, None)
                        if self.selected and self.selected["name"] == name:
                            self.build_overview(self.selected)
                            if installed:
                                self.scan_programs(self.selected)
                for name in finished:
                    del self.processes[name]
                    self.installers.discard(name)
                self.update_state()
                if self.selected and self.tabs.get_visible_child_name() == "logs":
                    self.update_log()
            self.work(self.library.running, loaded)
            return True

        def play_clicked(self, *_):
            if self.selected["name"] in self.running:
                self.run_operation(self.selected, "stop")
            else:
                self.start(self.selected)

        def start(self, entry, **kwargs):
            name = entry["name"]
            if name in self.pending or name in self.running or \
                    (name in self.processes and self.processes[name].poll() is None):
                self.toast("This sandbox is already running")
                return
            self.pending.add(name)
            self.update_state()
            def started(process, error):
                self.pending.discard(name)
                if not error:
                    self.processes[name] = process
                    if "installer" in kwargs:
                        self.installers.add(name)
                self.update_state()
                self.poll(True)
            self.work(lambda: self.library.start(entry, **kwargs), started)

        def choose_file(self, title, callback, folder=False, windows=False, parent=None):
            chooser = Gtk.FileChooserNative.new(title, parent or self.window,
                Gtk.FileChooserAction.SELECT_FOLDER if folder else Gtk.FileChooserAction.OPEN,
                "Select", "Cancel")
            if windows:
                file_filter = Gtk.FileFilter()
                file_filter.set_name("Windows installers (*.exe, *.msi)")
                for pattern in ("*.exe", "*.EXE", "*.msi", "*.MSI"):
                    file_filter.add_pattern(pattern)
                chooser.add_filter(file_filter)
            def response(dialog, code):
                file = dialog.get_file()
                dialog.destroy()
                if code == Gtk.ResponseType.ACCEPT and file and file.get_path():
                    callback(Path(file.get_path()))
            chooser.connect("response", response)
            chooser.show()

        def choose_installer(self, entry):
            self.choose_file("Choose Windows installer", lambda path: self.start(entry, installer=path), windows=True)

        def locate(self, entry):
            if entry["kind"] == "windows":
                try:
                    # Never open a game-planted link or file on the host.
                    drive = self.library.windows_drive(entry["name"])
                except ValueError as error:
                    self.toast(error)
                    return
                self.open_path(drive)
                return
            def selected(path):
                self.work(lambda: self.library.reconnect(entry, path),
                          lambda value, error: self.reload(entry["name"]) if not error else None)
            def browse(*_):
                self.choose_file("Locate game folder", selected, folder=True)
            def search():
                # Off the main thread: the saved location may be on a drive
                # that is gone, where even looking can take a while.
                if self.library.folder_state(entry) == "present":
                    return []
                return self.library.find_game_folders([entry])[entry["name"]]
            def found(paths, error):
                # A failed search (already reported) still leaves the chooser.
                if error or not paths:
                    browse()
                    return
                # Asked, even for one: a folder can share a name with another game.
                window, box = self.dialog_window("Matching game folders", 600, 360)
                self.label(box, "Choose a folder for " + entry["title"], "title-3")
                self.label(box, "A folder matches this sandbox. Use it, or choose another one." if len(paths) == 1
                           else "Several folders match this sandbox. Choose the installation to use.")
                choices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
                def use(path):
                    window.close()
                    selected(path)
                for path in paths:
                    self.button(choices, path, lambda *_, path=path: use(path))
                scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=120)
                scroll.set_child(choices)
                box.append(scroll)
                footer = Gtk.Box(spacing=8)
                self.button(footer, "Choose another folder…", lambda *_: (window.close(), browse()))
                self.button(footer, "Cancel", lambda *_: window.close())
                box.append(footer)
                window.present()
            self.work(search, found)

        def dialog_window(self, title, width, height):
            """A modal window over the manager, and the box for its contents."""
            window = Gtk.Window(title=title, transient_for=self.window, modal=True,
                                default_width=width, default_height=height)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, "set_margin_" + side)(24)
            window.set_child(box)
            return window, box

        def game_folders(self):
            window, box = self.dialog_window("Game folders", 640, 470)
            self.label(box, "Default locations for external games", "title-3")
            self.label(box, "Search these locations and up to three folder levels below them when the library "
                       "opens or refreshes. Missing games are matched by their original folder or sandbox name. "
                       "Display names and saves stay as they are. If several folders match, use Locate game.")
            paths = [str(path) for path in self.library.game_folders()]
            rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=100)
            scroll.set_child(rows)
            box.append(scroll)
            def rebuild():
                self.clear(rows)
                if not paths:
                    self.label(rows, "No search locations added.", "dim-label")
                for path in paths:
                    row = Gtk.Box(spacing=8)
                    label = Gtk.Label(label=path, xalign=0, wrap=True, selectable=True, hexpand=True)
                    row.append(label)
                    def remove(*_, path=path):
                        paths.remove(path)
                        rebuild()
                    self.button(row, "Remove", remove)
                    rows.append(row)
            rebuild()
            add_row = Gtk.Box(spacing=8)
            location = Gtk.Entry(placeholder_text="Folder path", hexpand=True)
            add_row.append(location)
            note = Gtk.Label(xalign=0, wrap=True)
            note.add_css_class("error")
            def add(path):
                # Checked as typed only; the disk is looked at when saving,
                # away from the main thread.
                try:
                    value = str(self.library.game_folder_path(path))
                except ValueError as error:
                    note.set_label(str(error))
                    return False
                if value not in paths:
                    paths.append(value)
                location.set_text("")
                note.set_label("")
                rebuild()
                return True
            self.button(add_row, "Add", lambda *_: add(location.get_text()))
            self.button(add_row, "Browse…", lambda *_: self.choose_file(
                "Choose game location", add, folder=True, parent=window))
            location.connect("activate", lambda *_: add(location.get_text()))
            box.append(add_row)
            box.append(note)
            footer = Gtk.Box(spacing=8, halign=Gtk.Align.END)
            self.button(footer, "Cancel", lambda *_: window.close())
            def save(*_):
                if location.get_text().strip() and not add(location.get_text()):
                    return
                def saved(_, error):
                    if error:
                        box.set_sensitive(True)
                        note.set_label(str(error))
                        return
                    window.close()
                    self.reload(search=True)
                box.set_sensitive(False)
                self.work(lambda: self.library.save_game_folders(list(paths)), saved)
            self.button(footer, "Save and search", save, "suggested-action")
            box.append(footer)
            window.present()

        def open_path(self, path):
            try:
                if not path.exists():
                    raise ValueError("This file or folder does not exist yet")
                Gio.AppInfo.launch_default_for_uri(path.as_uri(), None)
            except Exception as error:
                self.toast(error)

        def storage(self, entry):
            def calculate():
                result = subprocess.run(["du", "-sh", "--", str(self.library.capture(entry["name"]))],
                                        capture_output=True, text=True, timeout=60)
                if not result.stdout.strip():
                    raise ValueError(result.stderr.strip() or "Cannot calculate storage")
                return result.stdout.split()[0]
            self.work(calculate, lambda size, error: self.size_label.set_label(f"Storage used: {size}")
                      if not error and self.selected and self.selected["name"] == entry["name"] else None)

        def confirm_operation(self, entry, operation):
            delete = operation == "delete"
            dialog = Adw.AlertDialog(heading="Delete sandbox?" if delete else "Reset install changes?",
                body=(f"Delete {entry['title']} and all of its sandbox data, including saves and the Windows prefix? "
                      "An existing game folder outside the sandbox is kept." if delete else
                      "Discard changes written to the game folder? Files named like saves and the Windows prefix are kept."))
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("accept", "Delete" if delete else "Reset")
            dialog.set_response_appearance("accept", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.set_default_response("cancel")
            dialog.set_close_response("cancel")
            dialog.connect("response", lambda _, response: self.run_operation(entry, operation) if response == "accept" else None)
            dialog.present(self.window)

        def run_operation(self, entry, operation):
            name = entry["name"]
            self.pending.add(name)
            self.update_state()
            def done(value, error):
                self.pending.discard(name)
                if not error:
                    self.toast("Sandbox deleted" if operation == "delete" else "Sandbox stopped" if operation == "stop" else "Install changes reset")
                    self.reload()
                self.update_state()
            self.work(lambda: self.library.operate(name, operation), done)

        def check_system(self):
            def check():
                result = subprocess.run([str(self.library.backend), "--check"], capture_output=True,
                                        text=True, errors="replace", timeout=40)
                return result.stdout + result.stderr
            def loaded(text, error):
                if error:
                    return
                window = Gtk.Window(title="System check", transient_for=self.window, modal=True,
                                    default_width=800, default_height=550)
                scroll = Gtk.ScrolledWindow()
                view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                    left_margin=16, top_margin=16)
                view.get_buffer().set_text(text)
                scroll.set_child(view)
                window.set_child(scroll)
                window.present()
            self.work(check, loaded)

        def add_game(self):
            window = Gtk.Window(title="Add game", transient_for=self.window, modal=True,
                                default_width=560, default_height=550)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, "set_margin_" + side)(24)
            window.set_child(box)
            self.label(box, "Add to your library", "title-1")
            modes = Gtk.DropDown.new_from_strings(["Install a Windows game", "Add an existing game"])
            box.append(modes)
            form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            name = Gtk.Entry(placeholder_text="Game name")
            form.append(name)
            self.label(form, "Proton runner", "title-4")
            runners = Gtk.DropDown.new_from_strings(["Newest installed (auto)"])
            runner_paths = ["auto"]
            form.append(runners)
            def set_runners(paths, error):
                if error:
                    return
                runner_paths[:] = ["auto", *paths]
                runners.set_model(Gtk.StringList.new(["Newest installed (auto)", *[Path(p).name for p in paths]]))
            self.work(self.protons, set_runners)
            def custom_runner(path):
                if not (path / "proton").is_file() or not os.access(path / "proton", os.X_OK):
                    self.toast("Choose a Proton folder containing an executable proton script")
                    return
                runner_paths.append(str(path))
                runners.get_model().append(path.name)
                runners.set_selected(len(runner_paths) - 1)
            self.button(form, "Choose another Proton folder…", lambda *_: self.choose_file(
                "Choose Proton folder", custom_runner, folder=True))
            installer = [None]
            installer_label = self.label(form, "No installer selected. You can install later.", "dim-label")
            def chosen(path):
                installer[0] = path
                installer_label.set_label(path.name)
                if not name.get_text():
                    name.set_text(path.stem)
            self.button(form, "Choose installer…", lambda *_: self.choose_file(
                "Choose Windows installer", chosen, windows=True))
            network = Gtk.CheckButton(label="Allow internet access for installation and play")
            form.append(network)
            box.append(form)
            existing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            self.label(existing, "Select an unpacked game folder or its launcher. Its files stay in place; saves and changes go into its sandbox.")
            selection = [None]
            selected_label = self.label(existing, "No game selected", "dim-label")
            def selected(path):
                selection[0] = path
                selected_label.set_label(str(path))
            self.button(existing, "Choose game folder…", lambda *_: self.choose_file("Choose game folder", selected, folder=True))
            self.button(existing, "Choose launcher…", lambda *_: self.choose_file("Choose game launcher", selected))
            existing.set_visible(False)
            box.append(existing)
            modes.connect("notify::selected", lambda *_: (
                form.set_visible(modes.get_selected() == 0), existing.set_visible(modes.get_selected() == 1)))
            note = self.label(box, "", "error")
            footer = Gtk.Box(spacing=8, halign=Gtk.Align.END, vexpand=True, valign=Gtk.Align.END)
            self.button(footer, "Cancel", lambda *_: window.close())
            def create(*_):
                windows = modes.get_selected() == 0
                if windows and not name.get_text().strip():
                    note.set_label("Give the sandbox a name.")
                    return
                if not windows and not selection[0]:
                    note.set_label("Choose a game folder or launcher.")
                    return
                create_button.set_sensitive(False)
                # Read widgets only on the GTK thread.
                title, runner, internet, media, source = (name.get_text(), runner_paths[runners.get_selected()],
                    network.get_active(), installer[0], selection[0])
                def perform():
                    if windows:
                        return self.library.create(title, runner, internet)
                    return self.library.add_existing(source)
                def done(entry, error):
                    create_button.set_sensitive(True)
                    if error:
                        note.set_label(str(error))
                        return
                    window.close()
                    self.reload(entry["name"])
                    if windows and media:
                        self.start(entry, installer=media)
                self.work(perform, done)
            create_button = self.button(footer, "Add game", create, "suggested-action")
            box.append(footer)
            window.present()

    app = Adw.Application(application_id="eu.nosini.SandboxManager", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
    def activate(application):
        try:
            if not hasattr(application, "manager") or application.manager.closed:
                application.manager = Manager(application)
            application.manager.window.present()
        except Exception as error:
            print(f"Cannot open Sandbox Manager: {error}", file=sys.stderr)
            application.quit()
    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
