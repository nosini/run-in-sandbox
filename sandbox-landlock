#!/usr/bin/env -S python3 -I
"""sandbox-landlock [--rw PATH | --ro PATH | --ls PATH | --unix-connect PATH]...
                 [--unix-connect-where-writable] [--no-abstract-scope]
                 [--attach DIR | --gamescope-on-demand] -- CMD...
   sandbox-landlock --abi     print the kernel's Landlock ABI version, 0 for none
   sandbox-landlock --has-unix-connect   exit 0 if the kernel can restrict
                                         connecting to Unix sockets by path

Runs inside the sandbox, as the first step of the game's command:
restricts itself with Landlock to the paths it is given, then execs CMD,
which inherits the restriction along with everything it starts.
Until then nothing holds it, and $HOME is the game's: hence python3 -I,
or a .pth file the game left in its user site-packages would run here.

sandbox-game passes the sandbox's own mount plan: every writable mount as
--rw, every read-only one as --ro, and the root as --ls (listing only). So
Landlock allows nothing the mounts do not -- and goes on refusing when
something reaches past them anyway: a file descriptor inherited from outside,
reopened through /proc/self/fd/N, or a mistake in the mount plan itself. It
is the second lock on the same door. The exception is the game's own stdin,
stdout and stderr -- from the file manager, the launch log -- which it may
reopen as far as the descriptors already go (see main).

--rw   read, write, create, remove, execute, ioctl on devices
--ro   read and execute
--ls   list directories only
--unix-connect-where-writable, --no-abstract-scope, --unix-connect   see below

Landlock also scopes signals and abstract unix sockets to the game's own
processes, where the kernel supports that (ABI 6).

Run a second time, below gamescope, it puts the game in a domain of its own
inside gamescope's. Landlock lets no process reach into one outside its
domain -- no ptrace, no /proc/PID/fd, no pidfd_getfd -- so the game cannot
use gamescope's connections to the desktop. With
--unix-connect-where-writable it may also connect to a Unix socket by path
only under a --rw rule: the desktop's Wayland socket, mounted read-only for
gamescope, is then out of its reach. (A kernel without that right gets a
warning.) --unix-connect PATH grants connecting to the sockets at or under
PATH and nothing else there: how split display (sandbox-game --wayland-x11)
hands the game that one socket back. That layer does not scope abstract sockets, --no-abstract-scope:
gamescope's Xwayland listens on one, and X11 clients do not fall back to its
socket file when refused.

--gamescope-on-demand: split display (sandbox-game --wayland-x11), where
the game draws on the desktop and only its X11 windows -- a launcher, a
helper -- go through gamescope. CMD is gamescope's command, then --, then the
game's. Started above the game, as everywhere else, gamescope would take the
game along when its window is closed: it sends SIGTERM to everything it
started, and as the sandbox's main process it ends the sandbox too. So this
process starts the game beside gamescope instead, and gives it a display of
its own, :0, whose connections it passes on to gamescope's Xwayland --
bytes, and the descriptors DRI3, Present and MIT-SHM send along with them.
Gamescope is started when an X11 program connects and none is running: the
first time, and again after its window was closed, which ends only the X11
programs that were in it. A display of our own because Wine keeps the
DISPLAY a program started with, and a gamescope started afresh picks its
display number itself. When the game ends, gamescope is stopped.

Passing connections on gives the game nothing new: its X11 programs could
connect to gamescope's display socket themselves. Which display gamescope
took is read from the X lock files, which the game can write to; it can
only send its own X11 programs to a socket of its own that way, since the
connection goes to an abstract socket, which no symlink redirects.

On a kernel without Landlock the command runs anyway, with a warning, the way
sandbox-game carries on without a systemd scope: it is defence in depth, and
everything else still stands. Any other failure stops the launch.

--attach DIR: stay behind as the starter for what sandbox-attach brings in,
listening on DIR/socket. The socket is made before anything is restricted, in
a directory the rules give no one the right to change, so the game can
neither remove nor replace it. Then this process restricts itself, starts the
game, which restricts itself once more with the same rules, and waits for it,
passing on the signals it gets and exiting as the game did.

That puts what sandbox-attach starts -- a child of this process -- in a
Landlock domain with the game's rules, one level above the game's own. From
there it may ptrace the game and read its memory, which is Cheat Engine's job
(Proton reads another process's memory with process_vm_readv, from the
reading process), while the game cannot reach into it. And should the game
take it over anyway -- through its Wine session, which it controls -- it gets
nothing it did not have: the same rules, the same mounts, the same filter.

Only a process outside the sandbox may ask: one inside has a PID in its PID
namespace, and SO_PEERCRED shows anyone outside it as PID 0. A request names
the command and a few variables to set on top of this process's environment,
which is the game's own as bwrap and gamescope gave it, and either passes
stdin, stdout and stderr or asks for a terminal, whose master side is sent
back. The command runs in a session of its own, in /; its exit status is
sent back when it ends, and closing the connection hangs it up.
"""
import array
import ctypes
import fcntl
import json
import os
import re
import resource
import select
import selectors
import signal
import socket
import stat
import struct
import sys
import termios

# The same numbers on every architecture: allocated after the syscall
# tables were unified.
SYS_CREATE_RULESET, SYS_ADD_RULE, SYS_RESTRICT_SELF = 444, 445, 446
CREATE_RULESET_VERSION = 1
RULE_PATH_BENEATH = 1
PR_SET_NO_NEW_PRIVS = 38

EXECUTE, WRITE_FILE, READ_FILE, READ_DIR = 1 << 0, 1 << 1, 1 << 2, 1 << 3
REMOVE_DIR, REMOVE_FILE = 1 << 4, 1 << 5
MAKE_CHAR, MAKE_DIR, MAKE_REG, MAKE_SOCK = 1 << 6, 1 << 7, 1 << 8, 1 << 9
MAKE_FIFO, MAKE_BLOCK, MAKE_SYM = 1 << 10, 1 << 11, 1 << 12
REFER, TRUNCATE, IOCTL_DEV = 1 << 13, 1 << 14, 1 << 15
RESOLVE_UNIX = 1 << 16          # connecting to a Unix socket by its path
SCOPE_ABSTRACT_UNIX_SOCKET, SCOPE_SIGNAL = 1 << 0, 1 << 1

# What each ABI version can handle; anything newer is left alone.
ABI_FS = {1: (1 << 13) - 1}
ABI_FS[2] = ABI_FS[1] | REFER
ABI_FS[3] = ABI_FS[2] | TRUNCATE
ABI_FS[4] = ABI_FS[3]
ABI_FS[5] = ABI_FS[4] | IOCTL_DEV
FILE_ONLY = EXECUTE | WRITE_FILE | READ_FILE | TRUNCATE | IOCTL_DEV | RESOLVE_UNIX
RO = EXECUTE | READ_FILE | READ_DIR


class RulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_uint64),
                ("handled_access_net", ctypes.c_uint64),
                ("scoped", ctypes.c_uint64)]


class PathBeneathAttr(ctypes.Structure):
    _pack_ = 1
    _fields_ = [("allowed_access", ctypes.c_uint64),
                ("parent_fd", ctypes.c_int32)]


def fail(what):
    err = ctypes.get_errno()
    print(f"sandbox-landlock: {what}: {os.strerror(err)}", file=sys.stderr)
    sys.exit(1)


# What the starter passes on to the game, and resets for what it starts.
FORWARDED = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT,
             signal.SIGUSR1, signal.SIGUSR2)


def reset_signals():
    # Python ignores SIGPIPE and SIGXFSZ, and an ignored signal stays ignored
    # across exec: the game would never be stopped by writing to a closed pipe.
    for sig in (signal.SIGPIPE, signal.SIGXFSZ) + FORWARDED:
        signal.signal(sig, signal.SIG_DFL)


def execute(cmd):
    reset_signals()
    os.execvp(cmd[0], cmd)


def listen(directory):
    path = os.path.join(directory, "socket")
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET | socket.SOCK_CLOEXEC)
    listener.bind(path)
    listener.listen(8)
    return listener


def start_game(cmd, listener, restrict):
    pid = os.fork()
    if pid:
        return pid
    status = 127
    try:
        listener.close()
        restrict()
        execute(cmd)
    except SystemExit as e:
        status = e.code if isinstance(e.code, int) else 1
    except OSError as e:
        print(f"sandbox-landlock: {cmd[0]}: {e.strerror}", file=sys.stderr)
    os._exit(status)


def run_attached(argv, env, stdio, terminal):
    try:
        os.setsid()
        if terminal:
            fcntl.ioctl(stdio[0], termios.TIOCSCTTY, 0)
        for target, fd in enumerate(stdio):
            os.dup2(fd, target)
        os.closerange(3, 1 << 20)
        os.chdir("/")
        reset_signals()
        os.execvpe(argv[0], argv, env)
    except OSError as e:
        os.write(2, f"sandbox-attach: {argv[0]}: {e.strerror}\n".encode())
    os._exit(127)


def attach(conn):
    """Start what a request asks for; returns (pid, master or None)."""
    # Only from outside the sandbox: inside, every process has a PID here.
    pid, uid, _ = struct.unpack("3i", conn.getsockopt(
        socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    if pid != 0 or uid != os.getuid():
        raise PermissionError("not from outside the sandbox")
    conn.settimeout(5)
    msg, fds, flags, _ = socket.recv_fds(conn, 1 << 20, 3)
    conn.settimeout(None)
    master = None
    try:
        req = json.loads(msg)
        argv, extra = req["argv"], req.get("env", {})
        if (flags & (socket.MSG_CTRUNC | socket.MSG_TRUNC) or not argv
                or not all(isinstance(a, str) for a in argv)
                or not all(isinstance(k, str) and isinstance(v, str) and k and "=" not in k
                           for k, v in extra.items())):
            raise ValueError("malformed request")
        env = {**os.environ, **extra}
        if req.get("terminal"):
            master, slave = os.openpty()
            fds.append(slave)
            rows, cols = req.get("size", [24, 80])
            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("4H", rows, cols, 0, 0))
            stdio = [slave] * 3
        elif len(fds) == 3:
            stdio = fds
        else:
            raise ValueError("malformed request")
        child = os.fork()
        if child == 0:
            run_attached(argv, env, stdio, master is not None)
        return child, master
    except BaseException:
        if master is not None:
            os.close(master)
        raise
    finally:
        for fd in fds:
            os.close(fd)


def finish(status):
    """Exit as the game did."""
    if os.WIFSIGNALED(status):
        sig = os.WTERMSIG(status)
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        if sig in FORWARDED:
            signal.signal(sig, signal.SIG_DFL)
        os.kill(os.getpid(), sig)
        os._exit(128 + sig)
    os._exit(os.waitstatus_to_exitcode(status))


def serve(listener, game):
    def forward(sig, _frame):
        try:
            os.kill(game, sig)
        except ProcessLookupError:
            pass
    for sig in FORWARDED:
        signal.signal(sig, forward)
    sel = selectors.DefaultSelector()
    sel.register(os.pidfd_open(game), selectors.EVENT_READ, ("game", game))
    sel.register(listener, selectors.EVENT_READ, ("listen", None))
    clients = {}                        # attached PID -> its connection
    while True:
        for key, _ in sel.select():
            kind, pid = key.data
            if kind == "game":
                finish(os.waitpid(game, 0)[1])
            elif kind == "listen":
                try:
                    conn, _ = listener.accept()
                except OSError:
                    continue
                try:
                    child, master = attach(conn)
                    if master is not None:
                        socket.send_fds(conn, [b"{}"], [master])
                        os.close(master)
                except (OSError, ValueError, KeyError, TypeError) as e:
                    if not isinstance(e, PermissionError):
                        print(f"sandbox-landlock: attach: {e}", file=sys.stderr)
                    conn.close()
                    continue
                clients[child] = conn
                sel.register(conn, selectors.EVENT_READ, ("client", child))
                sel.register(os.pidfd_open(child), selectors.EVENT_READ, ("child", child))
            elif kind == "client":
                if clients.get(pid) is not key.fileobj:
                    continue                # its program ended in this round
                # A signal to pass on, or the end of the connection: a hangup.
                try:
                    msg = key.fileobj.recv(4096)
                    sig = json.loads(msg).get("signal") if msg else signal.SIGHUP
                except (OSError, ValueError, AttributeError):
                    msg, sig = b"", signal.SIGHUP
                if not msg:
                    sel.unregister(key.fileobj)
                    key.fileobj.close()
                    clients.pop(pid, None)
                if sig in [int(s) for s in FORWARDED]:
                    try:
                        os.killpg(pid, sig)
                    except ProcessLookupError:
                        pass
            elif kind == "child":
                sel.unregister(key.fileobj)
                os.close(key.fileobj)
                status = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
                conn = clients.pop(pid, None)
                if conn is not None:
                    try:
                        conn.send(json.dumps({"status": status}).encode())
                    except OSError:
                        pass
                    sel.unregister(conn)
                    conn.close()


X11_DIR = "/tmp/.X11-unix"
CHUNK = 1 << 16
MAX_FDS = 64                            # XCB passes at most 16 with a request


def hold_display():
    """Display :0 for the game: its lock file, then its socket."""
    try:
        fd = os.open("/tmp/.X0-lock", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o444)
        os.write(fd, b"%10d\n" % os.getpid())
        os.close(fd)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        listener.bind(f"{X11_DIR}/X0")
        listener.listen(64)
    except OSError as e:
        sys.exit(f"sandbox-landlock: holding display :0: {e.strerror}")
    listener.setblocking(False)
    return listener


def descends(pid, ancestor):
    """Whether PID is ANCESTOR or a process below it."""
    for _ in range(64):
        if pid == ancestor:
            return True
        try:
            with open(f"/proc/{pid}/stat", "rb") as f:
                pid = int(f.read().rsplit(b")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
        if pid <= 1:
            return False
    return False


def gamescope_display(pid):
    """The lowest display whose lock file names PID or a process below it --
    a wrapper script's gamescope -- or None so far."""
    found = []
    for name in os.listdir("/tmp"):
        number = re.fullmatch(r"\.X([0-9]{1,4})-lock", name)
        if not number:
            continue
        # The game can put anything there: a FIFO would block a plain open.
        try:
            fd = os.open(f"/tmp/{name}", os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError:
            continue
        # The PID padded to ten characters, then a newline from X servers and
        # a NUL from wlroots, which makes gamescope's Xwayland display.
        try:
            owner = re.fullmatch(rb" *([0-9]{1,10})[\n\0]?", os.read(fd, 16)) \
                if stat.S_ISREG(os.fstat(fd).st_mode) else None
            if owner and descends(int(owner[1]), pid):
                found.append(int(number[1]))
        except OSError:
            pass
        finally:
            os.close(fd)
    return min(found, default=None)


class Link:
    """One X11 client joined to gamescope's display, both ways."""

    def __init__(self, owner, client, server):
        self.owner, self.sel = owner, owner.sel
        self.peer = {client: server, server: client}
        self.queue = {client: [], server: []}   # (bytes, descriptors) to send to each
        self.events = {}
        self.closed = False
        self.update()

    def update(self):
        # Nothing more is read from one side while the other is behind.
        for sock, peer in self.peer.items():
            want = (0 if self.queue[peer] else selectors.EVENT_READ) \
                | (selectors.EVENT_WRITE if self.queue[sock] else 0)
            have = self.events.get(sock, 0)
            if want == have:
                continue
            if not have:
                self.sel.register(sock, want, self.pump)
            elif not want:
                self.sel.unregister(sock)
            else:
                self.sel.modify(sock, want, self.pump)
            self.events[sock] = want

    def flush(self, sock):
        queue = self.queue[sock]
        while queue:
            data, fds = queue[0]
            anc = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))] if fds else []
            try:
                sent = sock.sendmsg([data], anc)
            except BlockingIOError:
                return
            for fd in fds:
                os.close(fd)
            if sent < len(data):
                queue[0] = (data[sent:], [])
            else:
                queue.pop(0)

    def pump(self, sock, mask):
        if self.closed:                 # closed earlier in the same round
            return
        peer = self.peer[sock]
        try:
            if mask & selectors.EVENT_WRITE:
                self.flush(sock)
            if mask & selectors.EVENT_READ:
                data, anc, flags, _ = sock.recvmsg(CHUNK, socket.CMSG_SPACE(MAX_FDS * 4),
                                                   socket.MSG_CMSG_CLOEXEC)
                fds = array.array("i")
                for level, kind, raw in anc:
                    if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                        fds.frombytes(raw[:len(raw) - len(raw) % fds.itemsize])
                if data or fds:
                    self.queue[peer].append((data, list(fds)))
                self.flush(peer)
                # The end, or descriptors lost and the two sides out of step.
                if not data or flags & socket.MSG_CTRUNC:
                    return self.close()
        except BlockingIOError:
            pass
        except OSError:
            return self.close()
        self.update()

    def close(self):
        if self.closed:
            return
        self.closed = True
        for sock in self.peer:
            if self.events.get(sock):
                self.sel.unregister(sock)
            sock.close()
        for queue in self.queue.values():
            for _, fds in queue:
                for fd in fds:
                    os.close(fd)
        self.owner.links.discard(self)


class OnDemand:
    """Gamescope, started for X11 programs that connect to display :0."""

    def __init__(self, listener, command):
        self.sel = selectors.DefaultSelector()
        self.listener, self.command = listener, command
        self.pid = self.pidfd = self.display = None
        self.shown = False              # whether this gamescope's display was ever found
        self.waiting = []               # accepted, not yet passed on
        self.links = set()
        self.sel.register(listener, selectors.EVENT_READ, self.accept)

    def start(self):
        pid = os.fork()
        if pid == 0:
            try:
                execute(self.command)
            except OSError as e:
                print(f"sandbox-landlock: {self.command[0]}: {e.strerror}", file=sys.stderr)
            os._exit(127)
        self.pid, self.display, self.shown = pid, None, False
        self.pidfd = os.pidfd_open(pid)
        self.sel.register(self.pidfd, selectors.EVENT_READ, lambda *_: self.ended(pid))

    def ended(self, pid):
        if pid != self.pid:             # seen to already, earlier in the same round
            return
        self.sel.unregister(self.pidfd)
        os.close(self.pidfd)
        os.waitpid(pid, 0)
        # Programs that came as its window closed get a new one; those that
        # came while it was starting and failing do not get another try.
        again = self.shown and self.waiting
        self.pid = self.pidfd = self.display = None
        for link in list(self.links):
            link.close()
        if again:
            self.start()
        else:
            for client in self.waiting:
                client.close()
            self.waiting = []

    def accept(self, *_):
        try:
            client, _ = self.listener.accept()
        except OSError:
            return
        client.setblocking(False)
        self.waiting.append(client)
        if self.pid is None:
            self.start()
        self.connect()

    def connect(self):
        if self.display is None:
            self.display = gamescope_display(self.pid)
            self.shown = self.shown or self.display is not None
        while self.display is not None and self.waiting:
            server = socket.socket(socket.AF_UNIX,
                                   socket.SOCK_STREAM | socket.SOCK_CLOEXEC | socket.SOCK_NONBLOCK)
            try:
                server.connect(f"\0{X11_DIR}/X{self.display}")
            except BlockingIOError:     # a full backlog, until Xwayland is up
                server.close()
                return
            except OSError:             # closing, most likely: look again shortly
                server.close()
                self.display = None
                return
            self.links.add(Link(self, self.waiting.pop(0), server))

    def stop(self):
        if self.pid is None:
            return
        try:
            os.kill(self.pid, signal.SIGTERM)
            if not select.select([self.pidfd], [], [], 3)[0]:
                os.kill(self.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        os.waitpid(self.pid, 0)

    def serve(self, game):
        def forward(sig, _frame):
            try:
                os.kill(game, sig)
            except ProcessLookupError:
                pass
        for sig in FORWARDED:
            signal.signal(sig, forward)
        self.sel.register(os.pidfd_open(game), selectors.EVENT_READ, None)
        while True:
            starting = self.waiting and self.pid is not None
            for key, mask in self.sel.select(0.05 if starting else None):
                if key.data is None:
                    status = os.waitpid(game, 0)[1]
                    self.stop()
                    finish(status)
                key.data(key.fileobj, mask)
            if self.waiting and self.pid is not None:
                self.connect()


def beside_gamescope(cmd):
    """--gamescope-on-demand: see the top. Does not return."""
    if "--" not in cmd or cmd.index("--") in (0, len(cmd) - 1):
        sys.exit(__doc__.split("\n\n")[0])
    gamescope, game_cmd = cmd[:cmd.index("--")], cmd[cmd.index("--") + 1:]
    listener = hold_display()
    game = os.fork()
    if game == 0:
        os.environ["DISPLAY"] = ":0"
        try:
            execute(game_cmd)
        except OSError as e:
            print(f"sandbox-landlock: {game_cmd[0]}: {e.strerror}", file=sys.stderr)
        os._exit(127)
    OnDemand(listener, gamescope).serve(game)


def main():
    args = sys.argv[1:]
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    abi = libc.syscall(ctypes.c_long(SYS_CREATE_RULESET), None, ctypes.c_size_t(0),
                       ctypes.c_uint32(CREATE_RULESET_VERSION))
    if args == ["--abi"]:               # for sandbox-game --check
        print(max(abi, 0))
        return
    # Not tied to an ABI number here: the kernel says whether it knows the
    # right by accepting a ruleset that handles it.
    probe = RulesetAttr(handled_access_fs=RESOLVE_UNIX)
    fd = libc.syscall(ctypes.c_long(SYS_CREATE_RULESET), ctypes.byref(probe),
                      ctypes.c_size_t(8), ctypes.c_uint32(0))
    has_unix = fd >= 0
    if has_unix:
        os.close(fd)
    if args == ["--has-unix-connect"]:  # for sandbox-game --check
        sys.exit(0 if has_unix else 1)
    rules, unix, abstract, attach_dir, on_demand = [], False, True, None, False
    while args and args[0] != "--":
        if args[0] == "--gamescope-on-demand":
            on_demand = True
            args = args[1:]
            continue
        if args[0] == "--attach" and len(args) > 1:
            attach_dir = args[1]
            args = args[2:]
            continue
        if args[0] in ("--unix-connect-where-writable", "--no-abstract-scope"):
            unix = unix or args[0] == "--unix-connect-where-writable"
            abstract = abstract and args[0] != "--no-abstract-scope"
            args = args[1:]
            continue
        if len(args) < 2 or args[0] not in ("--rw", "--ro", "--ls", "--unix-connect"):
            sys.exit(__doc__.split("\n\n")[0])
        rules.append((args[0], args[1]))
        args = args[2:]
    cmd = args[1:]
    if not cmd or (on_demand and attach_dir):
        sys.exit(__doc__.split("\n\n")[0])
    run = beside_gamescope if on_demand else execute

    # Made while this process can still create it there.
    listener = listen(attach_dir) if attach_dir else None

    if abi < 1:
        print("sandbox-landlock: warning: no Landlock in this kernel; running without it", file=sys.stderr)
        if listener is None:
            run(cmd)
        serve(listener, start_game(cmd, listener, lambda: None))

    handled = ABI_FS[min(abi, 5)]
    if unix and has_unix:
        handled |= RESOLVE_UNIX         # granted by --rw, as everything handled is
    elif unix:
        print("sandbox-landlock: warning: this kernel's Landlock cannot restrict connecting to"
              " sockets; under gamescope the game can reach the desktop's compositor",
              file=sys.stderr)
    access = {"--rw": handled, "--ro": RO & handled, "--ls": READ_DIR,
              "--unix-connect": RESOLVE_UNIX & handled}
    attr = RulesetAttr(handled_access_fs=handled)
    size = 8
    if abi >= 6:
        attr.scoped = SCOPE_SIGNAL | (SCOPE_ABSTRACT_UNIX_SOCKET if abstract else 0)
        size = 24
    ruleset = libc.syscall(ctypes.c_long(SYS_CREATE_RULESET), ctypes.byref(attr),
                           ctypes.c_size_t(size), ctypes.c_uint32(0))
    if ruleset < 0:
        fail("creating the ruleset")

    for kind, path in rules:
        try:
            fd = os.open(path, os.O_PATH | os.O_CLOEXEC)
        except FileNotFoundError:
            continue                    # an optional mount (--ro-bind-try) left out
        allowed = access[kind]
        if not stat.S_ISDIR(os.fstat(fd).st_mode):
            allowed &= FILE_ONLY
        if not allowed:                 # --unix-connect where connecting is not handled
            os.close(fd)
            continue
        rule = PathBeneathAttr(allowed_access=allowed, parent_fd=fd)
        if libc.syscall(ctypes.c_long(SYS_ADD_RULE), ctypes.c_int(ruleset),
                        ctypes.c_int(RULE_PATH_BENEATH), ctypes.byref(rule),
                        ctypes.c_uint32(0)) < 0:
            fail(f"adding {path}")
        os.close(fd)

    # The game's own stdin, stdout and stderr: `echo ... >/dev/stderr` opens
    # the file behind them afresh, through /proc/self/fd, and that file -- the
    # launch log, the host terminal -- is in no mount. So whatever they point
    # at, no further than each descriptor goes: read if it was opened for
    # reading, write if for writing, and truncate with write, which `>` asks
    # for and the descriptor could do anyway. The log, opened write-only, is
    # not read back; a terminal gets no ioctls on the new descriptor.
    # Pipes and sockets need nothing: Landlock does not look at those.
    for std in (0, 1, 2):
        try:
            mode = os.fstat(std).st_mode
            flags = fcntl.fcntl(std, fcntl.F_GETFL)
            if not (stat.S_ISREG(mode) or stat.S_ISCHR(mode)) or flags & os.O_PATH:
                continue
            fd = os.open(f"/proc/self/fd/{std}", os.O_PATH | os.O_CLOEXEC)
        except OSError:
            continue
        acc = flags & os.O_ACCMODE
        allowed = (READ_FILE if acc in (os.O_RDONLY, os.O_RDWR) else 0) \
            | (WRITE_FILE | TRUNCATE if acc in (os.O_WRONLY, os.O_RDWR) else 0)
        # Not every file takes a path rule -- a memfd, for one, is refused
        # with EBADFD. Such a descriptor keeps working as it is; it only
        # cannot be reopened by path, as before this rule existed.
        rule = PathBeneathAttr(allowed_access=allowed & handled, parent_fd=fd)
        libc.syscall(ctypes.c_long(SYS_ADD_RULE), ctypes.c_int(ruleset),
                     ctypes.c_int(RULE_PATH_BENEATH), ctypes.byref(rule), ctypes.c_uint32(0))
        os.close(fd)

    def restrict():
        if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0:
            fail("setting no_new_privs")
        if libc.syscall(ctypes.c_long(SYS_RESTRICT_SELF), ctypes.c_int(ruleset),
                        ctypes.c_uint32(0)) < 0:
            fail("restricting")
    restrict()
    if listener is None:
        os.close(ruleset)
        run(cmd)
    # The same rules once more for the game: a domain below this one.
    game = start_game(cmd, listener, restrict)
    os.close(ruleset)
    serve(listener, game)


if __name__ == "__main__":
    main()
