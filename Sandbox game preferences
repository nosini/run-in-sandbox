#!/usr/bin/env bash
# Nautilus script: right-click a game and choose how the sandbox should launch
# it. "Sandbox game" then reads these back, so there is one launcher entry
# rather than one per flag combination.
#
# Settings are per game and fall back to a shared set, so one fussy title can
# pin its own Proton without dragging the rest of the library with it:
#   ~/.config/sandbox-game/games/<name>   <- "This game only"
#   ~/.config/sandbox-game/defaults       <- "All games"
# The key is whatever sandbox-game files the sandbox under, so preferences and
# captured writes stay in step even when two games share a folder name.
#
# Install beside the launcher:
#   D=~/.local/share/nautilus/scripts
#   install -Dm755 "Sandbox game" "$D/Sandbox game"
#   install -Dm755 "Sandbox game preferences" "$D/Sandbox game preferences"
#   install -Dm644 sandbox-game-lib ~/.local/bin/sandbox-game-lib
#
# The files are plain key=value and meant to be hand-editable:
#   wayland=0|1   mangohud=0|1   gamescope=0|1   proton=auto|<install name>
#   host_x11=0|1                        # explicit host X server access
#   net=0|1                             # internet access, never the LAN
#   gamescope_args=<gamescope options>   e.g. -f -W 2560 -H 1440
#   env=K=V K=V ...                      e.g. WAYLANDDRV_PRIMARY_MONITOR=HDMI-1
# Resolution and fullscreen get a second dialog when gamescope will run; the rest
# of gamescope_args, and all of env, are set by hand and carried through saves
# untouched. env explicitly adds values to the clean sandbox environment.
# Values cannot contain spaces, the list being split on them.
set -uo pipefail

SANDBOX="$HOME/.local/bin/sandbox-game"
[ -x "$SANDBOX" ] || SANDBOX="$(command -v sandbox-game || true)"
die() { command -v zenity >/dev/null && zenity --error --no-wrap --text="$1" 2>/dev/null \
            || notify-send "sandbox-game" "$1" 2>/dev/null; exit 1; }
[ -n "$SANDBOX" ] || die "sandbox-game not found in ~/.local/bin or PATH."
command -v zenity >/dev/null || die "zenity is needed for the preferences dialog."

LIB="$(dirname "$SANDBOX")/sandbox-game-lib"
# shellcheck source=sandbox-game-lib
. "$LIB" 2>/dev/null || die "sandbox-game-lib not found beside sandbox-game:\n$LIB"

SEL="$(head -n1 <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")"
[ -n "$SEL" ] || SEL="$(pwd)"
SEL="$(realpath "$SEL")"
[ -e "$SEL" ] || die "Selection not found:\n$SEL"
# Same mapping the launcher uses, so a game gets one key however it was picked
# -- an NW.js "www" folder belongs to the game above it.
resolve_selection "$SEL"
GAMEDIR="$R_GAMEDIR"
BASE="$(basename "$GAMEDIR")"
NAME="$("$SANDBOX" --print-name "$GAMEDIR")" \
    || die "sandbox-game could not derive a name for:\n$GAMEDIR"
# What the launcher will run it with, so that only what that can do is offered.
game_engine "$SEL"

# ---- build the menus -------------------------------------------------------
# zenity combos have no "select this one" switch: they open on their first
# entry. So each list is rotated to put the current setting at the front.
first() {                                      # $1 = current, rest = all values
    local cur="$1" v; shift
    printf '%s\n' "$cur"
    for v in "$@"; do [ "$v" = "$cur" ] || printf '%s\n' "$v"; done
}
join_pipe() { local IFS='|'; printf '%s' "$*"; }

# For offering "the size of your screen" in the gamescope menu. xrandr answers
# through Xwayland on compositors that do not speak wlr-output-management.
native_res() {
    local r
    r="$(xrandr --current 2>/dev/null | awk '/\*/ {print $1; exit}')"
    [ -n "$r" ] || r="$(wlr-randr 2>/dev/null | awk '/current/ {print $1; exit}')"
    [[ "$r" =~ ^[0-9]+x[0-9]+$ ]] && printf '%s\n' "$r"
}

WAYLAND_NOW="$(cfg_get wayland 0)"; MHUD_NOW="$(cfg_get mangohud 0)"
PROTON_NOW="$(cfg_get proton auto)"; GS_NOW="$(cfg_get gamescope 0)"
NET_NOW="$(cfg_get net 0)"

M_OFF="Off"; M_ON="On"
P_AUTO="Newest installed (auto)"

# Display: where the game draws, and whether gamescope is in between, as one
# choice -- each entry says what happens, and only what this game can do is
# offered. Saved as wayland=, gamescope= and host_x11= as ever.
D_W="Native Wayland"; D_WG="Native Wayland, in gamescope"
D_X="X11, in gamescope (private Xwayland)"
D_H="Host X11 (other X apps can watch and control it)"
if [ "$R_ENGINE" = native ] && renpy_without_wayland "$GAMEDIR"; then
    D_OK=( "$D_X" "$D_H" )          # its SDL has no Wayland driver
elif [ "$R_ENGINE" = proton ]; then
    # Wine's Wayland driver needs wl_subcompositor and wp_viewporter, which
    # gamescope's Wayland server lacks; the launcher uses its Xwayland there.
    D_OK=( "$D_W" "$D_X" "$D_H" )
else
    D_OK=( "$D_W" "$D_WG" "$D_X" "$D_H" )
fi
if [ "$(cfg_get host_x11 0)" = 1 ]; then D_CUR="$D_H"
elif [ "$WAYLAND_NOW" = 1 ] && [ "$GS_NOW" = 1 ]; then D_CUR="$D_WG"
elif [ "$WAYLAND_NOW" = 1 ]; then D_CUR="$D_W"
else D_CUR="$D_X"; fi
# A setting this game cannot have opens as what it gets instead.
[[ "|$(join_pipe "${D_OK[@]}")|" == *"|$D_CUR|"* ]] || D_CUR="$D_X"
[ "$MHUD_NOW"    = 1 ] && M_CUR="$M_ON" || M_CUR="$M_OFF"
[ "$PROTON_NOW" = auto ] && P_CUR="$P_AUTO" || P_CUR="$PROTON_NOW"

mapfile -t PROTONS < <("$SANDBOX" --list-proton 2>/dev/null)
# A version pinned earlier and since uninstalled must still be offered, or the
# combo would silently reopen on something else and quietly change the setting.
mapfile -t P_ALL < <(first "$P_CUR" "$P_AUTO" "${PROTONS[@]}")

mapfile -t D_ALL < <(first "$D_CUR" "${D_OK[@]}")
# MangoHud's preload shim hangs Chromium's zygote, so for NW.js it stays off.
M_NA="Off (forced: hangs NW.js)"
if [ -n "$R_APPDIR" ]; then M_ALL=( "$M_NA" )
else mapfile -t M_ALL < <(first "$M_CUR" "$M_OFF" "$M_ON"); fi

N_OFF="Off"; N_ON="Internet only (no LAN, nothing on this PC)"
[ "$NET_NOW" = 1 ] && N_CUR="$N_ON" || N_CUR="$N_OFF"
mapfile -t N_ALL < <(first "$N_CUR" "$N_OFF" "$N_ON")

S_GAME="This game only"; S_ALL="All games (defaults)"; S_CLEAR="Clear this game's settings"
SCOPE_ALL=( "$S_GAME" "$S_ALL" "$S_CLEAR" )

FORM=( --add-combo="Display"          --combo-values="$(join_pipe "${D_ALL[@]}")"
       --add-combo="MangoHud overlay" --combo-values="$(join_pipe "${M_ALL[@]}")" )
FIELDS=( display mhud )
ASK_PROTON=0
case "$R_ENGINE" in proton|"") ASK_PROTON=1 ;; esac
if [ "$ASK_PROTON" = 1 ]; then
    FORM+=( --add-combo="Proton version" --combo-values="$(join_pipe "${P_ALL[@]}")" )
    FIELDS+=( proton )
fi
FORM+=( --add-combo="Network"  --combo-values="$(join_pipe "${N_ALL[@]}")"
        --add-combo="Save for" --combo-values="$(join_pipe "${SCOPE_ALL[@]}")" )
FIELDS+=( net scope )
OUT="$(zenity --forms --title="Sandbox preferences" \
    --text="$BASE" --separator=$'\t' "${FORM[@]}" 2>/dev/null)" || exit 0   # cancelled

# Split with awk, not read: tab counts as IFS whitespace, so read would fold
# consecutive tabs together and shift every field left of an empty one.
fld() {                                        # $1 = field name
    local i
    for i in "${!FIELDS[@]}"; do
        [ "${FIELDS[$i]}" = "$1" ] || continue
        awk -F'\t' -v n="$((i + 1))" 'NR==1 {print $n}' <<<"$OUT"; return
    done
}
F_DISPLAY="$(fld display)"; F_MHUD="$(fld mhud)"; F_PROTON="$(fld proton)"
F_NET="$(fld net)"; F_SCOPE="$(fld scope)"

# An untouched combo can come back empty on some zenity builds; keep the
# current value rather than silently resetting it to the built-in default.
[ -n "${F_DISPLAY:-}" ] || F_DISPLAY="$D_CUR"
[ -n "${F_MHUD:-}"   ] || F_MHUD="$M_CUR"
[ -n "${F_PROTON:-}" ] || F_PROTON="$P_CUR"
[ -n "${F_NET:-}"    ] || F_NET="$N_CUR"
[ -n "${F_SCOPE:-}"  ] || F_SCOPE="$S_GAME"

# ---- save ------------------------------------------------------------------
if [ "$F_SCOPE" = "$S_CLEAR" ]; then
    rm -f "$CFGDIR/games/$NAME"
    zenity --info --no-wrap --title="Sandbox preferences" \
        --text="Cleared settings for <b>$BASE</b>.\nIt will use the defaults from now on." 2>/dev/null
    exit 0
fi

if [ "$F_SCOPE" = "$S_ALL" ]; then TARGET="$CFGDIR/defaults"; SCOPE_TXT="all games"
else                               TARGET="$CFGDIR/games/$NAME"; SCOPE_TXT="$BASE"; fi

# Values the dialog did not ask about have to come out of the file being
# written, never out of cfg_get: its answer is the two scopes merged, and
# writing that back would copy a game's setting into the defaults, or pin an
# inherited default into a game that then stops following it.
kept() { file_get "$TARGET" "$1" || printf '%s\n' "$2"; }

# gamescope=1 means always; X11 in gamescope is stored as 0, the launcher
# putting gamescope around private Xwayland by itself -- so that a switch to
# native Wayland later does not find it pinned on.
case "$F_DISPLAY" in
    "$D_W")  W=1 G=0 HX=0 ;;
    "$D_WG") W=1 G=1 HX=0 ;;
    "$D_H")  W=0 G=0 HX=1 ;;
    *)       W=0 G=0 HX=0 ;;
esac
# Whether gamescope will actually run, which is when its options matter.
USES_GS=0
[ "$F_DISPLAY" = "$D_WG" ] || [ "$F_DISPLAY" = "$D_X" ] && USES_GS=1
# The forced entry carries no choice, so keep whatever this file already said.
if [ "$F_MHUD" = "$M_NA" ]; then M="$(kept mangohud 0)"
elif [ "$F_MHUD" = "$M_ON" ]; then M=1
else M=0; fi
[ "$F_NET" = "$N_ON" ] && NET=1 || NET=0

# ---- gamescope options -----------------------------------------------------
# Only worth asking when gamescope will run -- either display in gamescope --
# so it is a second dialog rather than four more fields nobody without it
# would want. Resolution and
# fullscreen are the two knobs; anything else in gamescope_args was put there
# by hand and is parsed out, left alone, and put back.
# A game's own file that says nothing gets the defaults' options, so those are
# what the dialog starts from; the file only gets a line of its own once the
# answer differs from them -- an empty one included, which is how a game turns
# off the defaults' fullscreen or resolution.
# Options into the two the dialog asks about and the rest, and back in one
# order -- which is also how two answers are compared, whatever order a hand
# edit left them in.
ga_parse() {                                   # $1 = options -> GA_W GA_H GA_F GA_REST
    local in i=0
    GA_W=""; GA_H=""; GA_F=0; GA_REST=()
    read -r -a in <<<"$1"
    while [ "$i" -lt "${#in[@]}" ]; do
        case "${in[$i]}" in
            -W|--output-width)  GA_W="${in[$((i+1))]:-}"; i=$((i+2)) ;;
            -H|--output-height) GA_H="${in[$((i+1))]:-}"; i=$((i+2)) ;;
            -f|--fullscreen)    GA_F=1; i=$((i+1)) ;;
            *)                  GA_REST+=( "${in[$i]}" ); i=$((i+1)) ;;
        esac
    done
}
ga_join() {
    local out=()
    [ -n "$GA_W" ] && [ -n "$GA_H" ] && out+=( -W "$GA_W" -H "$GA_H" )
    [ "$GA_F" = 1 ] && out+=( -f )
    out+=( "${GA_REST[@]}" )
    printf '%s\n' "${out[*]}"
}
ga_same() { [ "$(ga_parse "$1"; ga_join)" = "$(ga_parse "$2"; ga_join)" ]; }

GA_INHERITED=""
[ "$TARGET" = "$CFGDIR/defaults" ] \
    || GA_INHERITED="$(file_get "$CFGDIR/defaults" gamescope_args || true)"
if GA_OUT="$(file_get "$TARGET" gamescope_args)"; then GA_OWN=1
else GA_OUT="$GA_INHERITED"; GA_OWN=0; fi
if [ "$USES_GS" = 1 ]; then
    ga_parse "$GA_OUT"

    R_NONE="Game default (no override)"
    R_CUR="$R_NONE"
    [ -n "$GA_W" ] && [ -n "$GA_H" ] && R_CUR="${GA_W}x${GA_H}"
    RES=( "$R_NONE" )
    NATIVE="$(native_res)"
    [ -n "$NATIVE" ] && RES+=( "$NATIVE" )
    RES+=( 3840x2160 2560x1440 1920x1080 1600x900 1280x720 )
    mapfile -t RES_ALL < <(first "$R_CUR" "${RES[@]}" | awk '!seen[$0]++')
    [ "$GA_F" = 1 ] && FS_CUR="Yes" || FS_CUR="No"
    mapfile -t FS_ALL < <(first "$FS_CUR" "Yes" "No")

    GOUT="$(zenity --forms --title="Gamescope options" \
        --text="$BASE" --separator=$'\t' \
        --add-combo="Resolution" --combo-values="$(join_pipe "${RES_ALL[@]}")" \
        --add-combo="Fullscreen" --combo-values="$(join_pipe "${FS_ALL[@]}")" \
        2>/dev/null)"
    # Backing out of this one keeps the options as they were rather than
    # throwing away the main dialog's answers too.
    if [ -n "$GOUT" ]; then
        F_RES="$(awk -F'\t' 'NR==1 {print $1}' <<<"$GOUT")"
        F_FS="$( awk -F'\t' 'NR==1 {print $2}' <<<"$GOUT")"
        [ -n "$F_RES" ] || F_RES="$R_CUR"
        [ -n "$F_FS"  ] || F_FS="$FS_CUR"
        GA_W=""; GA_H=""
        [ "$F_RES" != "$R_NONE" ] && [[ "$F_RES" =~ ^([0-9]+)x([0-9]+)$ ]] \
            && GA_W="${BASH_REMATCH[1]}" GA_H="${BASH_REMATCH[2]}"
        [ "$F_FS" = Yes ] && GA_F=1 || GA_F=0
        GA_OUT="$(ga_join)"
    fi
fi
if [ "$ASK_PROTON" = 0 ]; then P="$(kept proton auto)"
elif [ "$F_PROTON" = "$P_AUTO" ]; then P=auto
else P="$F_PROTON"; fi

ENV_KEEP="$(kept env "")"        # no dialog field; carried through untouched

mkdir -p "$(dirname "$TARGET")" || die "Cannot create $(dirname "$TARGET")"
{   echo "# sandbox-game preferences -- edit by hand or via the Nautilus script"
    echo "wayland=$W"
    echo "host_x11=$HX"
    echo "mangohud=$M"
    echo "gamescope=$G"
    echo "net=$NET"
    if [ "$TARGET" = "$CFGDIR/defaults" ]; then
        [ -n "$GA_OUT" ] && echo "gamescope_args=$GA_OUT"
    elif [ "$GA_OWN" = 1 ] || ! ga_same "$GA_OUT" "$GA_INHERITED"; then
        echo "gamescope_args=$GA_OUT"
    fi
    [ -n "$ENV_KEEP" ] && echo "env=$ENV_KEEP"
    echo "proton=$P"
} > "$TARGET" || die "Cannot write $TARGET"

NOTE=""
[ "$F_SCOPE" = "$S_ALL" ] && [ -f "$CFGDIR/games/$NAME" ] \
    && NOTE="\n\n<i>$BASE has its own settings, which still win over these.</i>"

zenity --info --no-wrap --title="Sandbox preferences" \
    --text="Saved for <b>$SCOPE_TXT</b>:\n\nDisplay: $F_DISPLAY${GA_OUT:+ <tt>($GA_OUT)</tt>}\nMangoHud: $F_MHUD${F_PROTON:+\nProton: $F_PROTON}\nNetwork: $F_NET\n\n<tt>$TARGET</tt>$NOTE" \
    2>/dev/null
