#!/usr/bin/env bash
# Nautilus preferences: one GTK window, shared detection and key=value config.
# Runtime, display, gamescope and engine-specific controls update in place.
set -uo pipefail

SANDBOX="$HOME/.local/bin/sandbox-game"
[ -x "$SANDBOX" ] || SANDBOX="$(command -v sandbox-game || true)"
die() {
    printf '%b\n' "$1" >&2
    if declare -F dialog >/dev/null; then dialog error --text="$1" 2>/dev/null && exit 1; fi
    notify-send "sandbox-game" "$1" 2>/dev/null || true
    exit 1
}
[ -n "$SANDBOX" ] || die "sandbox-game not found in ~/.local/bin or PATH."
LIB="$(dirname "$(realpath "$SANDBOX")")/sandbox-game-lib"
[ -f "$LIB" ] || LIB="$HOME/.local/lib/sandbox-game/sandbox-game-lib"
# shellcheck source=sandbox-game-lib
. "$LIB" 2>/dev/null || die "sandbox-game-lib not found (run install.sh):\n$LIB"

SEL="$(head -n1 <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")"
[ -n "$SEL" ] || SEL="$(pwd)"
SEL="$(realpath "$SEL")"
[ -e "$SEL" ] || die "Selection not found:\n$SEL"
resolve_selection "$SEL"
GAMEDIR="$R_GAMEDIR"
BASE="$(basename "$GAMEDIR")"
NAME="$("$SANDBOX" --print-name "$GAMEDIR")" || die "Cannot derive a name for:\n$GAMEDIR"
game_engine "$SEL" auto
CAN_PROTON=0; RENPY_X11=0
if has_windows_exe "$GAMEDIR" || [ "$(cfg_get launch_with auto)" = proton ]; then CAN_PROTON=1; fi
if [ "$R_ENGINE" = native ] && renpy_without_wayland "$GAMEDIR"; then RENPY_X11=1; fi
DOTNET_APP=0; is_dotnet "$GAMEDIR" && DOTNET_APP=1
RES="$(xrandr --current 2>/dev/null | awk '/\*/ {print $1; exit}')"
[ -n "$RES" ] || RES="$(wlr-randr 2>/dev/null | awk '/current/ {print $1; exit}')"
[[ "$RES" =~ ^[0-9]+x[0-9]+$ ]] || RES=""
PROTONS="$("$SANDBOX" --list-proton 2>/dev/null)"
NWJS_VERSIONS="$("$SANDBOX" --list-nwjs 2>/dev/null)"
OWN_SETTINGS=0; [ ! -f "$CFGDIR/games/$NAME" ] || OWN_SETTINGS=1
# The uid backend sandbox-game keeps for this sandbox while nothing chooses one.
UID_BACKEND=""
if [ -f "$HOME/game-sandboxes/$NAME/uid" ]; then UID_BACKEND=1
elif [ -f "$HOME/game-sandboxes/$NAME/managed-uid" ]; then UID_BACKEND=systemd; fi

# JSON is data, never shell code. Folder names and values need no escaping by
# hand, and all controls keep their values while switching between runtimes.
REQUEST="$(python3 - "$BASE" "$R_ENGINE" "$CAN_PROTON" "$RENPY_X11" "$RES" "$PROTONS" "$NWJS_VERSIONS" "$OWN_SETTINGS" "$DOTNET_APP" "$UID_BACKEND" \
    "$CFGDIR/games/$NAME" "$CFGDIR/defaults" \
    launch_with "$(cfg_get launch_with auto)" wayland "$(cfg_get wayland 0)" \
    wayland_x11 "$(cfg_wayland_x11)" x11_exe "$(cfg_get x11_exe '')" \
    x11_backend "$(cfg_get x11_backend gamescope)" \
    host_x11 "$(cfg_get host_x11 0)" gamescope "$(cfg_get gamescope 0)" \
    mangohud "$(cfg_get mangohud 0)" hdr "$(cfg_get hdr 0)" net "$(cfg_get net 0)" \
    proton "$(cfg_get proton auto)" mod_loaders "$(cfg_get mod_loaders 0)" steam "$(cfg_get steam 0)" hide_tray "$(cfg_get hide_tray 0)" \
    nwjs "$(cfg_get nwjs auto)" casefold "$(cfg_get casefold 1)" webgl "$(cfg_get webgl auto)" \
    gamescope_args "$(cfg_get gamescope_args '')" \
    dotnet "$(cfg_get dotnet 0)" with_proton "$(cfg_get with_proton '')" \
    lan "$(cfg_get lan 0)" lan_allow "$(cfg_get lan_allow '')" mac_vendor "$(cfg_get mac_vendor 0)" \
    private_hosts "$(cfg_get private_hosts 0)" hosts "$(cfg_get hosts '')" \
    hosts_writable "$(cfg_get hosts_writable 0)" require "$(cfg_get require '')" <<'PY'
import json, sys
from pathlib import Path
name, engine, proton, renpy, resolution, installs, nwjs, own, dotnet, uid_backend = sys.argv[1:11]
security = {}
for scope, path in zip(("game", "all"), sys.argv[11:13]):
    values = {}
    try:
        for line in Path(path).read_text(encoding="utf-8", errors="replace").splitlines():
            key, separator, value = line.partition("=")
            if separator and not key.lstrip().startswith("#"):
                values[key.strip()] = value.strip()
    except FileNotFoundError:
        pass
    security[scope] = values
json.dump(dict(game=name, title="Sandbox preferences", engine=engine,
               can_proton=proton == "1", renpy_x11=renpy == "1", dotnet=dotnet == "1",
               resolution=resolution, protons=installs.splitlines(),
               nwjs_versions=nwjs.splitlines(),
               game_settings=own == "1", security=security, uid_backend=uid_backend,
               values=dict(zip(sys.argv[13::2], sys.argv[14::2]))), sys.stdout)
PY
)" || die "Cannot prepare preferences."
if OUT="$(dialog preferences <<<"$REQUEST")"; then :
else
    rc=$?
    [ "$rc" != 1 ] || exit 0   # closing or cancelling saves nothing
    die "Cannot open preferences. Install GTK 4, libadwaita and the Python PyGObject bindings."
fi

# The same persistence the desktop manager uses; see sandbox-game-lib.
ERR="$(prefs_save "$OUT" 2>&1 >/dev/null)" || die "${ERR:-Cannot save preferences.}"
