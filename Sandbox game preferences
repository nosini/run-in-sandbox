#!/usr/bin/env bash
# Nautilus preferences: one GTK window, shared detection and key=value config.
# Runtime, display, gamescope and engine-specific controls update in place.
set -uo pipefail

SANDBOX="$HOME/.local/bin/sandbox-game"
[ -x "$SANDBOX" ] || SANDBOX="$(command -v sandbox-game || true)"
die() {
    printf '%b\n' "$1" >&2
    if declare -F dialog >/dev/null; then dialog error --text="$1" 2>/dev/null && exit 1; fi
    notify-send "sandbox-game" "$1" 2>/dev/null || true
    exit 1
}
[ -n "$SANDBOX" ] || die "sandbox-game not found in ~/.local/bin or PATH."
LIB="$(dirname "$(realpath "$SANDBOX")")/sandbox-game-lib"
[ -f "$LIB" ] || LIB="$HOME/.local/lib/sandbox-game/sandbox-game-lib"
# shellcheck source=sandbox-game-lib
. "$LIB" 2>/dev/null || die "sandbox-game-lib not found (run install.sh):\n$LIB"

SEL="$(head -n1 <<<"${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}")"
[ -n "$SEL" ] || SEL="$(pwd)"
SEL="$(realpath "$SEL")"
[ -e "$SEL" ] || die "Selection not found:\n$SEL"
resolve_selection "$SEL"
GAMEDIR="$R_GAMEDIR"
BASE="$(basename "$GAMEDIR")"
NAME="$("$SANDBOX" --print-name "$GAMEDIR")" || die "Cannot derive a name for:\n$GAMEDIR"
game_engine "$SEL" auto
CAN_PROTON=0; RENPY_X11=0
if has_windows_exe "$GAMEDIR" || [ "$(cfg_get launch_with auto)" = proton ]; then CAN_PROTON=1; fi
if [ "$R_ENGINE" = native ] && renpy_without_wayland "$GAMEDIR"; then RENPY_X11=1; fi
RES="$(xrandr --current 2>/dev/null | awk '/\*/ {print $1; exit}')"
[ -n "$RES" ] || RES="$(wlr-randr 2>/dev/null | awk '/current/ {print $1; exit}')"
[[ "$RES" =~ ^[0-9]+x[0-9]+$ ]] || RES=""
PROTONS="$("$SANDBOX" --list-proton 2>/dev/null)"
OWN_SETTINGS=0; [ ! -f "$CFGDIR/games/$NAME" ] || OWN_SETTINGS=1

# JSON is data, never shell code. Folder names and values need no escaping by
# hand, and all controls keep their values while switching between runtimes.
REQUEST="$(python3 - "$BASE" "$R_ENGINE" "$CAN_PROTON" "$RENPY_X11" "$RES" "$PROTONS" "$OWN_SETTINGS" \
    launch_with "$(cfg_get launch_with auto)" wayland "$(cfg_get wayland 0)" \
    host_x11 "$(cfg_get host_x11 0)" gamescope "$(cfg_get gamescope 0)" \
    mangohud "$(cfg_get mangohud 0)" net "$(cfg_get net 0)" \
    proton "$(cfg_get proton auto)" mod_loaders "$(cfg_get mod_loaders 0)" \
    casefold "$(cfg_get casefold 1)" webgl "$(cfg_get webgl auto)" \
    gamescope_args "$(cfg_get gamescope_args '')" <<'PY'
import json, sys
name, engine, proton, renpy, resolution, installs, own = sys.argv[1:8]
json.dump(dict(game=name, title="Sandbox preferences", engine=engine,
               can_proton=proton == "1", renpy_x11=renpy == "1",
               resolution=resolution, protons=installs.splitlines(),
               game_settings=own == "1", values=dict(zip(sys.argv[8::2], sys.argv[9::2]))), sys.stdout)
PY
)" || die "Cannot prepare preferences."
if OUT="$(dialog preferences <<<"$REQUEST")"; then :
else
    rc=$?
    [ "$rc" != 1 ] || exit 0   # closing or cancelling saves nothing
    die "Cannot open preferences. Install GTK 4 and the Python PyGObject bindings."
fi

# Only fields belonging to the selected engine are returned. Hidden fields
# come from the file being written, so they never copy across config scopes.
PARSED="$(python3 - "$OUT" <<'PY'
import json, sys
values = json.loads(sys.argv[1])
keys = {"scope", "launch_with", "wayland", "host_x11", "gamescope", "mangohud",
        "net", "proton", "mod_loaders", "casefold", "webgl", "gamescope_args"}
assert isinstance(values, dict) and values.get("scope") in {"game", "all", "clear"}
assert all(k in keys and isinstance(v, str) and not any(c in v for c in "\n\r\t\0")
           for k, v in values.items())
for key, value in values.items():
    print(key + "\t" + value)
PY
)" || die "Invalid preferences response; no settings were saved."
declare -A RESULT
while IFS=$'\t' read -r key value; do RESULT["$key"]="$value"; done <<<"$PARSED"
if [ "${RESULT[scope]}" = clear ]; then
    python3 - "$CFGDIR/games/$NAME" <<'PY'
from pathlib import Path
import sys
Path(sys.argv[1]).unlink(missing_ok=True)
PY
    exit
fi
[ "${RESULT[scope]}" = all ] && TARGET="$CFGDIR/defaults" || TARGET="$CFGDIR/games/$NAME"
kept() { file_get "$TARGET" "$1" || printf '%s\n' "$2"; }
chosen() {
    if [ "${RESULT[$1]+set}" ]; then printf '%s\n' "${RESULT[$1]}"
    else kept "$1" "$2"; fi
}

# Compare gamescope's resolution/fullscreen options in a stable order, so an
# unchanged inherited value stays inherited. Other options are preserved.
ga_normalise() {
    local words width="" height="" full=0 rest=() i=0
    read -r -a words <<<"$1"
    while [ "$i" -lt "${#words[@]}" ]; do
        case "${words[$i]}" in
            -W|--output-width) width="${words[$((i+1))]:-}"; i=$((i+2)) ;;
            -H|--output-height) height="${words[$((i+1))]:-}"; i=$((i+2)) ;;
            -f|--fullscreen) full=1; i=$((i+1)) ;;
            *) rest+=( "${words[$i]}" ); i=$((i+1)) ;;
        esac
    done
    local out=()
    [ -z "$width" ] || [ -z "$height" ] || out+=( -W "$width" -H "$height" )
    [ "$full" != 1 ] || out+=( -f )
    out+=( "${rest[@]}" )
    printf '%s\n' "${out[*]}"
}
GA_OWN=0
if GA_OUT="$(file_get "$TARGET" gamescope_args)"; then GA_OWN=1; fi
if [ "${RESULT[gamescope_args]+set}" ]; then
    GA_OUT="${RESULT[gamescope_args]}"
    if [ "$TARGET" != "$CFGDIR/defaults" ]; then
        GA_DEFAULT="$(file_get "$CFGDIR/defaults" gamescope_args || true)"
        [ "$(ga_normalise "$GA_OUT")" = "$(ga_normalise "$GA_DEFAULT")" ] || GA_OWN=1
    fi
fi

mkdir -p "$(dirname "$TARGET")" || die "Cannot create $(dirname "$TARGET")"
{   echo "# sandbox-game preferences -- edit by hand or via the Nautilus script"
    for key in wayland host_x11 mangohud gamescope net launch_with mod_loaders casefold webgl proton; do
        case "$key" in launch_with|webgl|proton) fallback=auto ;; casefold) fallback=1 ;; *) fallback=0 ;; esac
        printf '%s=%s\n' "$key" "$(chosen "$key" "$fallback")"
    done
    if [ "$TARGET" = "$CFGDIR/defaults" ]; then
        [ -z "$GA_OUT" ] || printf 'gamescope_args=%s\n' "$GA_OUT"
    elif [ "$GA_OWN" = 1 ]; then printf 'gamescope_args=%s\n' "$GA_OUT"; fi
    ENV_KEEP="$(kept env '')"
    [ -z "$ENV_KEEP" ] || printf 'env=%s\n' "$ENV_KEEP"
} > "$TARGET.tmp" || die "Cannot write $TARGET"
mv -- "$TARGET.tmp" "$TARGET" || die "Cannot save $TARGET"
