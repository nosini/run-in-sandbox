#!/usr/bin/env bash
# sandbox-game [--wayland] [--name NAME] [--mangohud] [--gamescope[=ARGS]]
#              [--proton[=VER]|--mkxp[=DIR]] GAMEDIR CMD...
#   Runs CMD inside an isolated bwrap sandbox:
#     - no network (--unshare-all includes the net namespace)
#     - no nested user namespaces, a seccomp filter (see sandbox-seccomp), and
#       memory/task limits via a systemd scope
#     - real $HOME absent; a fresh $HOME is redirected to the capture dir
#     - GAMEDIR is presented at /game as an overlay; the pristine install is
#       never modified, all writes are captured
#   Everything the game writes ends up under ONE folder:
#     ~/game-sandboxes/NAME/  ->  home/   (writes to $HOME: configs, saves)
#                                 rw/     (writes into the install dir at /game)
#                                 compat/ (--proton: the Wine prefix, under pfx/)
#                                 mkxp.json (--mkxp: the runtime config, yours
#                                            to edit -- only created if absent)
#
#   --wayland   force SDL onto native Wayland (SDL_VIDEODRIVER=wayland), no X.
#               Only for engines whose SDL has a Wayland backend -- NOT stock
#               Ren'Py, whose bundled SDL is x11/Xwayland only.
#               With --proton it selects Proton's winewayland driver instead
#               (STEAM_COMPAT_CONFIG=wayland); GE/DW/CachyOS builds honour it,
#               builds without that driver need --gamescope for Xwayland.
#   --name NAME override the sandbox name (else derived from the game dir).
#   --env K=V   set a variable inside the sandbox; repeatable, and applied last
#               so it wins over the clean environment and display defaults
#               (e.g. --env WAYLANDDRV_PRIMARY_MONITOR=HDMI-1).
#   --mangohud  show the MangoHud overlay. Your ~/.config/MangoHud is bound
#               back in read-only -- $HOME is redirected, so without that the
#               fps_limit and per-executable .conf files silently stop
#               applying. Exporting MANGOHUD=1 opts in just the same.
#               64-bit only unless mangohud-32bit is installed.
#   --gamescope run the game inside gamescope's nested compositor. =ARGS passes
#               options through, e.g. --gamescope='-f -W 2560 -H 1440' (word
#               split, so quote the lot). Together with --mangohud this becomes
#               gamescope --mangoapp, which is what gamescope's own help says to
#               use in place of wrapping the game in mangohud; that needs the
#               separate mangoapp package. gamescope displays through the host
#               Wayland socket and brings its own nested Xwayland for the game,
#               so the host X server stays out of the sandbox in this mode.
#   --proton    run CMD as a Windows program under Proton: CMD is the .exe and
#               its args, and the sandbox cwd becomes the .exe's own directory.
#               =VER picks a Proton by name substring or by path; without it the
#               newest one found in the usual Steam locations wins. $PROTON_DIR
#               overrides the search entirely. The prefix is built fresh under
#               compat/, so your real Steam prefixes are never touched, and the
#               Proton install itself is mounted read-only.
#   --mkxp      run an RPG Maker XP/VX/VX Ace game natively under mkxp-z, no
#               Wine involved. CMD is optional and normally omitted: the
#               runtime is the program. =DIR names the mkxp-z install, else
#               ~/.local/share/mkxp* and friends are searched; $MKXP_DIR wins.
#               mkxp-z resolves everything relative to its own binary, never
#               the cwd, so the game is handed over as "gameFolder": "/game"
#               in a generated config bound over the runtime's own mkxp.json.
#

#   Default uses gamescope's private Xwayland. --host-x11 opts into the host
#   X server (other X clients can be observed/controlled). --headless exposes
#   no display. Audio always goes through the host's PipeWire and Pulse
#   sockets -- enough games refuse to start without a sound device that
#   withholding it broke more than it protected.
#
# CMD references the game at /game, e.g.:
#   sandbox-game /mnt/General-HDD/Games/games/DDLC  /game/DDLC.sh
#   sandbox-game --proton /mnt/General-HDD/Games/games/Witcher3 /game/witcher3.exe
#   sandbox-game --proton=GE-Proton11 ~/Games/Foo /game/bin/foo.exe -windowed
#   sandbox-game --mkxp /mnt/General-HDD/Games/games/SomeVXAceGame
set -euo pipefail

# Nicer names for directories whose basename is ugly. Key = on-disk basename.
declare -A NAME_MAP=(
    # ["Doki Doki Literature Club"]="ddlc"
    # ["NIKKE"]="nikke"
)

derive_name() {
    local base; base="$(basename "$1")"
    if [ -n "${NAME_MAP[$base]:-}" ]; then printf '%s\n' "${NAME_MAP[$base]}"; return; fi
    base="${base,,}"
    base="${base//[^a-z0-9._-]/-}"
    while [[ "$base" == *--* ]]; do base="${base//--/-}"; done
    base="${base#-}"; base="${base%-}"
    printf '%s\n' "${base:-game}"
}

# ---- proton discovery ------------------------------------------------------
# Where Steam keeps compatibility tools, native install and flatpak alike. Kept
# up here so --list-proton can answer before a game is even named; the menu that
# offers these versions has no business restating the search paths.
proton_roots() {
    printf '%s\n' \
        "$HOME/.local/share/Steam/compatibilitytools.d" \
        "$HOME/.steam/root/compatibilitytools.d" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d" \
        "$HOME/.local/share/Steam/steamapps/common" \
        "$HOME/.steam/root/steamapps/common" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/common" \
        /usr/share/steam/compatibilitytools.d
}

list_protons() {                      # every install found, newest first
    local root d ver
    while IFS= read -r root; do
        [ -d "$root" ] || continue
        for d in "$root"/*/; do
            d="${d%/}"
            [ -x "$d/proton" ] || continue
            ver="$(cut -d' ' -f1 "$d/version" 2>/dev/null || true)"
            [[ "$ver" =~ ^[0-9]+$ ]] || ver=0
            printf '%s\t%s\n' "$ver" "$(basename "$d")"
        done
    done < <(proton_roots) | sort -rn -k1,1 | cut -f2 | awk '!seen[$0]++'
}

# ---- args ------------------------------------------------------------------
# Shared by both spellings of --env, so "--env FOO" is rejected as loudly as
# "--env=FOO" instead of quietly setting FOO to itself.
add_env() {                           # reads $_e as KEY=VALUE
    [ "$_e" = "${_e#*=}" ] && { echo "--env wants KEY=VALUE, got '$_e'" >&2; exit 1; }
    ENV_ARGS+=( --setenv "${_e%%=*}" "${_e#*=}" )
}

# MHUD, not MANGOHUD: that name belongs to MangoHud's own env var, and writing
# to it here would switch the overlay off for anyone who exports MANGOHUD=1.
WAYLAND=0; NAME=""; EXTRA_RO=(); PROTON_SPEC=""; MKXP_SPEC=""; MHUD=0; PRINT_NAME=0
GS=0; GS_ARGS=(); ENV_ARGS=(); HOST_X11=0; HEADLESS=0
[ "${MANGOHUD:-0}" = 1 ] && MHUD=1        # an inherited MANGOHUD=1 opts in too
while [ "$#" -gt 0 ]; do
    case "$1" in
        --wayland)   WAYLAND=1; shift ;;
        --host-x11)  HOST_X11=1; shift ;;
        --headless)  HEADLESS=1; shift ;;
        --mangohud)  MHUD=1; shift ;;
        --gamescope) GS=1; shift ;;
        --gamescope=*) GS=1; read -r -a GS_ARGS <<<"${1#--gamescope=}"; shift ;;
        --print-name) PRINT_NAME=1; shift ;;
        --list-proton) list_protons; exit 0 ;;
        --name)      NAME="$2"; shift 2 ;;
        --name=*)    NAME="${1#--name=}"; shift ;;
        --proton)    PROTON_SPEC="auto"; shift ;;
        --proton=*)  PROTON_SPEC="${1#--proton=}"; PROTON_SPEC="${PROTON_SPEC:-auto}"; shift ;;
        --mkxp)      MKXP_SPEC="auto"; shift ;;
        --mkxp=*)    MKXP_SPEC="${1#--mkxp=}"; MKXP_SPEC="${MKXP_SPEC:-auto}"; shift ;;
        --ro)        EXTRA_RO+=( --ro-bind "$2" "$3" ); shift 3 ;;
        --env)       _e="$2"; shift 2; add_env ;;
        --env=*)     _e="${1#--env=}"; shift; add_env ;;
        --)          shift; break ;;
        -*)          echo "unknown option: $1" >&2; exit 1 ;;
        *)           break ;;
    esac
done
[ -z "$PROTON_SPEC" ] || [ -z "$MKXP_SPEC" ] || {
    echo "--proton and --mkxp are mutually exclusive" >&2; exit 1; }
GAMEDIR="$(realpath "${1:?usage: sandbox-game [--wayland] [--name NAME] [--proton[=VER]|--mkxp[=DIR]] GAMEDIR CMD...}")"; shift
# --mkxp supplies its own command: the runtime is the program.
[ "$#" -ge 1 ] || [ -n "$MKXP_SPEC" ] || [ "$PRINT_NAME" = 1 ] || {
    echo "need a command to run" >&2; exit 1; }
NAME="${NAME:-$(derive_name "$GAMEDIR")}"
[[ "$NAME" =~ ^[a-zA-Z0-9._-]+$ ]] && [ "$NAME" != . ] && [ "$NAME" != .. ] || {
    echo "invalid sandbox name: use letters, digits, underscores, dots and hyphens (not . or ..)" >&2
    exit 1
}
# The sandbox name doubles as the key everything else files a game under, so
# hand it out rather than have callers reimplement derive_name().
[ "$PRINT_NAME" = 0 ] || { printf '%s\n' "$NAME"; exit 0; }

# Never silently fall back to the host X server. Existing gamescope=0
# preferences still get the safe default unless host X was explicitly allowed.
if [ "$HEADLESS" = 1 ]; then
    [ "$GS" = 0 ] && [ "$WAYLAND" = 0 ] && [ "$HOST_X11" = 0 ] || {
        echo "--headless cannot be combined with display options" >&2; exit 1; }
elif [ "$WAYLAND" = 0 ] && [ "$HOST_X11" = 0 ]; then
    GS=1
fi
[ "$HOST_X11" = 0 ] || { [ "$GS" = 0 ] && [ "$WAYLAND" = 0 ]; } || {
    echo "--host-x11 cannot be combined with --gamescope or --wayland" >&2; exit 1; }

CAP="$HOME/game-sandboxes/$NAME"
mkdir -p "$CAP/home" "$CAP/rw" "$CAP/work" "$CAP/merged"

RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
WL="${WAYLAND_DISPLAY:-wayland-0}"
CHDIR=/game

# ---- proton ----------------------------------------------------------------
# A Proton is any directory holding an executable `proton` script -- that test
# also rejects the plain Wine builds people drop into compatibilitytools.d.
# Newest wins, ranked by the unix timestamp that leads the `version` file.
find_proton() {                       # $1 = auto | name substring | path
    local spec="$1" root d base ver best="" best_t=-1
    [ "$spec" = auto ] || [ ! -x "${spec%/}/proton" ] || { printf '%s\n' "${spec%/}"; return; }
    while IFS= read -r root; do
        [ -d "$root" ] || continue
        for d in "$root"/*/; do
            d="${d%/}"; base="$(basename "$d")"
            [ -x "$d/proton" ] || continue
            [ "$spec" = auto ] || [[ "${base,,}" == *"${spec,,}"* ]] || continue
            ver="$(cut -d' ' -f1 "$d/version" 2>/dev/null || true)"
            [[ "$ver" =~ ^[0-9]+$ ]] || ver=0
            if [ "$ver" -gt "$best_t" ]; then best_t="$ver"; best="$d"; fi
        done
    done < <(proton_roots)
    printf '%s\n' "$best"
}

PROTON=""; PROTON_ARGS=()
if [ -n "$PROTON_SPEC" ]; then
    PROTON="${PROTON_DIR:-$(find_proton "$PROTON_SPEC")}"
    [ -n "$PROTON" ] && [ -x "$PROTON/proton" ] || {
        [ "$PROTON_SPEC" = auto ] && echo "no Proton install found" >&2 \
                                  || echo "no Proton install matching '$PROTON_SPEC'" >&2
        echo "looked for a dir containing an executable 'proton' under:" >&2
        proton_roots | while IFS= read -r r; do echo "  $r" >&2; done
        echo "override with PROTON_DIR=/path/to/proton-install" >&2; exit 1; }
    mkdir -p "$CAP/compat" "$CAP/steam"
    # STEAM_COMPAT_CLIENT_INSTALL_PATH is read unconditionally by proton's
    # setup_prefix(), so it has to exist -- but it is only mined for optional
    # legacycompat/steamclient*.dll, which a non-Steam game does not want.
    # An empty dir keeps the real Steam install out of the sandbox.
    PROTON_ARGS=(
        --ro-bind "$PROTON" /proton
        --bind "$CAP/compat" /compat
        --bind "$CAP/steam"  /steamclient
        --setenv STEAM_COMPAT_DATA_PATH          /compat
        --setenv STEAM_COMPAT_CLIENT_INSTALL_PATH /steamclient
        --setenv STEAM_COMPAT_INSTALL_PATH       /game
    )
    # Games routinely load assets relative to the cwd, so land in the exe's dir.
    case "$1" in /*) CHDIR="$(dirname "$1")" ;; esac
    set -- /proton/proton run "$@"
fi

# ---- mkxp-z ----------------------------------------------------------------
# An mkxp-z install is a directory holding the runtime binary next to its
# stdlib/ and scripts/; the CI artifacts unpack exactly like that, so dropping
# one in ~/.local/share/ as-is is enough. First hit wins.
# Both helpers report "not found" as a non-zero return, so every caller has to
# keep that out of set -e's way: find over a missing dir fails the pipeline
# under pipefail, and an assignment inherits that status.
find_mkxp() {                         # $1 = auto | path -> install dir
    local spec="$1" d
    if [ "$spec" != auto ]; then
        mkxp_bin "${spec%/}" >/dev/null && printf '%s\n' "${spec%/}"
        return 0
    fi
    for d in "$HOME/.local/share"/mkxp*/ "$HOME/.local/lib"/mkxp*/ \
             "$HOME"/mkxp*/ "$HOME/Games"/mkxp*/ /opt/mkxp*/; do
        d="${d%/}"
        if [ -d "$d" ] && mkxp_bin "$d" >/dev/null; then printf '%s\n' "$d"; return 0; fi
    done
    return 0
}
mkxp_bin() {                          # $1 = install dir -> binary name, if any
    local b
    b="$(find "$1" -maxdepth 1 -type f -name 'mkxp*' -perm -u+x 2>/dev/null | sort | head -n1 || true)"
    [ -n "$b" ] || return 1
    basename "$b"
}

MKXP=""; MKXP_ARGS=()
if [ -n "$MKXP_SPEC" ]; then
    MKXP="${MKXP_DIR:-$(find_mkxp "$MKXP_SPEC")}"
    MKXP_BIN="$([ -n "$MKXP" ] && mkxp_bin "$MKXP" || true)"
    [ -n "$MKXP_BIN" ] || {
        [ "$MKXP_SPEC" = auto ] && echo "no mkxp-z runtime found" >&2 \
                                || echo "no mkxp-z runtime at '$MKXP_SPEC'" >&2
        echo "looked for a dir with an executable mkxp* binary under:" >&2
        echo "  ~/.local/share/mkxp*  ~/.local/lib/mkxp*  ~/mkxp*  ~/Games/mkxp*  /opt/mkxp*" >&2
        echo "override with MKXP_DIR=/path/to/mkxp-z-install" >&2; exit 1; }
    # mkxp-z resolves gameFolder against its own binary, never the cwd, so the
    # game has to be named outright. Seed the config from the runtime's own
    # commented one and then leave it alone, so per-game tweaks (fontSub, RTP,
    # soundfont) survive the next launch.
    # The preload wrappers are what let a Windows-only game run at all: without
    # win32_wrap the stock Win32API dlopen()s the DLL the game names and dies
    # with "Failed loading kernel32". They are additive shims, and win32_wrap is
    # Ancurio's, so mkxp_wrap has to precede it to supply the older names it
    # expects. Absolute paths are honoured, which keeps them in the read-only
    # runtime instead of forcing them into the game's own tree.
    mkxp_preload() {
        local f first=1
        echo '    "preloadScript": ['
        for f in ruby_classic_wrap mkxp_wrap win32_wrap; do
            [ -f "$MKXP/scripts/preload/$f.rb" ] || continue
            [ "$first" = 1 ] || echo ','
            printf '        "/mkxp/scripts/preload/%s.rb"' "$f"; first=0
        done
        echo; echo '    ],'
    }
    if [ ! -f "$CAP/mkxp.json" ]; then
        if [ "$(head -n1 "$MKXP/mkxp.json" 2>/dev/null)" = "{" ]; then
            { echo '{'
              echo '    // added by sandbox-game: the game is bind-mounted at /game'
              echo '    "gameFolder": "/game",'
              mkxp_preload
              tail -n +2 "$MKXP/mkxp.json"; } > "$CAP/mkxp.json"
        else
            { echo '{'; mkxp_preload
              echo '    "gameFolder": "/game"'; echo '}'; } > "$CAP/mkxp.json"
        fi
    fi
    MKXP_ARGS=(
        --ro-bind "$MKXP" /mkxp
        --ro-bind "$CAP/mkxp.json" /mkxp/mkxp.json
    )
    set -- "/mkxp/$MKXP_BIN" "$@"
fi

# Will gamescope end up serving a Wayland socket to its children? Either
# because --wayland asked for one, or because the flag was written into
# gamescope_args by hand. Decided here, before anything reads it.
GS_EXPOSE=0
if [ "$GS" = 1 ]; then
    [ "$WAYLAND" = 1 ] && GS_EXPOSE=1
    [[ " ${GS_ARGS[*]} " == *" --expose-wayland "* ]] && GS_EXPOSE=1
fi

# ---- mangohud --------------------------------------------------------------
# Wrap last, so the overlay also covers whatever proton/mkxp put in front. The
# packaged wrapper is the supported entry point: it exports MANGOHUD=1 for the
# Vulkan layer and prepends the GL shim to LD_PRELOAD, keeping the linker's
# literal $LIB token so the same string serves 32- and 64-bit children.
MANGOHUD_ARGS=(); MHUD_VIA_APP=0
if [ "$MHUD" = 1 ]; then
    # Under gamescope the overlay is normally mangoapp's job -- except when the
    # Wayland socket is exposed as well. mangoapp is a GLFW client: given a
    # WAYLAND_DISPLAY it takes the Wayland path, libdecor cannot find the
    # globals gamescope offers, it falls back to X11, fails there too, and the
    # reaper restarts it forever. Exposing that socket is the whole reason
    # winewayland works, so keep it and preload the shim into the game instead,
    # against gamescope's general advice. Either route reads the same config.
    # GS_EXPOSE, not WAYLAND: the flag can equally arrive by hand through
    # gamescope_args, and mangoapp breaks on the socket however it got there.
    [ "$GS" = 1 ] && [ "$GS_EXPOSE" = 0 ] && MHUD_VIA_APP=1
    [ "$MHUD_VIA_APP" = 1 ] || command -v mangohud >/dev/null || {
        echo "mangohud not found (openSUSE: zypper in mangohud)" >&2; exit 1; }
    CFG="${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud"
    if [ -d "$CFG" ]; then
        MANGOHUD_ARGS=( --ro-bind "$CFG" "$HOME/.config/MangoHud" )
    fi
    [ "$MHUD_VIA_APP" = 1 ] || set -- mangohud "$@"
fi

# ---- gamescope -------------------------------------------------------------
# Outermost of the lot, so the compositor owns whatever proton or mkxp put in
# front of the game. Its --mangoapp is the supported way to get the overlay in
# here: gamescope's own help says to use it instead of wrapping the game, and
# doing both would draw the thing twice.
if [ "$GS" = 1 ]; then
    command -v gamescope >/dev/null || {
        echo "gamescope not found (openSUSE: zypper in gamescope)" >&2; exit 1; }
    GS_CMD=( gamescope "${GS_ARGS[@]}" )
    # gamescope serves no Wayland socket to its children unless asked, and
    # Proton only reaches for winewayland.drv when it can see WAYLAND_DISPLAY.
    # Without this the game quietly lands back on winex11.drv inside gamescope,
    # STEAM_COMPAT_CONFIG=wayland notwithstanding -- and an SDL game pinned to
    # the Wayland backend has nothing at all to talk to.
    if [ "$WAYLAND" = 1 ] && [[ " ${GS_ARGS[*]} " != *" --expose-wayland "* ]]; then
        GS_CMD+=( --expose-wayland )
    fi
    # An inherited MANGOHUD=1 would light up MangoHud's Vulkan layer inside the
    # game as well, drawing the overlay a second time next to mangoapp's.
    [ "$MHUD_VIA_APP" = 1 ] && MANGOHUD_ARGS+=( --setenv MANGOHUD 0 )
    if [ "$MHUD_VIA_APP" = 1 ]; then
        if command -v mangoapp >/dev/null; then
            GS_CMD+=( --mangoapp )
        else
            # Not fatal: losing the overlay beats refusing to start the game.
            echo "warning: --mangohud under gamescope needs the mangoapp package;" >&2
            echo "         running without the overlay (openSUSE: zypper in mangoapp)" >&2
        fi
    fi
    set -- "${GS_CMD[@]}" -- "$@"
fi

# ---- environment, display and devices --------------------------------------
# Use explicit names, never prefixes such as AWS_* or even arbitrary LC_*:
# shell sessions and file managers can carry credentials in their environment.
BASE_ENV=( --clearenv --setenv PATH /usr/bin:/bin
    --setenv HOME "$HOME" --setenv USER "$(id -un)" --setenv LOGNAME "$(id -un)"
    --setenv XDG_CONFIG_HOME "$HOME/.config"
    --setenv XDG_DATA_HOME "$HOME/.local/share"
    --setenv XDG_CACHE_HOME "$HOME/.cache"
    --setenv XDG_STATE_HOME "$HOME/.local/state"
    --setenv XDG_RUNTIME_DIR "$RT" )
for key in LANG LANGUAGE LC_ALL LC_CTYPE LC_MESSAGES LC_COLLATE LC_NUMERIC LC_TIME \
           LC_MONETARY LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT \
           LC_IDENTIFICATION TERM TZ; do
    [ -z "${!key:-}" ] || BASE_ENV+=( --setenv "$key" "${!key}" )
done
VIDEO_ENV=(); XSOCK_ARGS=( --dir /tmp/.X11-unix ); DISPLAY_ARGS=()
DEVICE_ARGS=()
if [ "$HEADLESS" = 0 ]; then
    # No sound, input, camera, tty or host shared-memory mounts: sound goes
    # through the audio sockets below instead. Controllers that require raw
    # device access must be granted separately in future.
    [ ! -d /dev/dri ] || DEVICE_ARGS+=( --dev-bind /dev/dri /dev/dri )
    # Proprietary NVIDIA uses additional devices outside /dev/dri.
    for device in /dev/nvidia[0-9]* /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm /dev/nvidia-uvm-tools; do
        [ ! -c "$device" ] || DEVICE_ARGS+=( --dev-bind "$device" "$device" )
    done
    if [ "$HOST_X11" = 1 ]; then
        XSOCK_ARGS=( --ro-bind /tmp/.X11-unix /tmp/.X11-unix )
        VIDEO_ENV+=( --setenv DISPLAY "${DISPLAY:?--host-x11 needs DISPLAY}" )
        XAUTH_HOST="${XAUTHORITY:-$HOME/.Xauthority}"
        [ ! -f "$XAUTH_HOST" ] || XSOCK_ARGS+=(
            --ro-bind "$XAUTH_HOST" /tmp/.Xauthority
            --setenv XAUTHORITY /tmp/.Xauthority )
    else
        # Normalize absolute WAYLAND_DISPLAY values to a private socket path.
        case "$WL" in /*) WL_HOST="$WL" ;; *) WL_HOST="$RT/$WL" ;; esac
        [ -S "$WL_HOST" ] || {
            echo "Wayland socket not found: $WL_HOST; use --headless or explicitly opt into --host-x11" >&2
            exit 1
        }
        DISPLAY_ARGS=( --ro-bind "$WL_HOST" "$RT/wayland-0" )
        VIDEO_ENV+=( --setenv WAYLAND_DISPLAY wayland-0 )
    fi
fi
if [ "$WAYLAND" = 1 ]; then
    if [ -n "$PROTON" ]; then
        VIDEO_ENV+=( --setenv STEAM_COMPAT_CONFIG wayland )
    else
        VIDEO_ENV+=( --setenv SDL_VIDEODRIVER wayland )
    fi
fi
AUDIO_ARGS=( --ro-bind-try "$RT/pipewire-0" "$RT/pipewire-0"
    --ro-bind-try "$RT/pulse" "$RT/pulse"
    --setenv PULSE_SERVER "unix:$RT/pulse/native" )

# ---- overlay for the game's own install dir --------------------------------
# Prefer bwrap's built-in --overlay; many distro builds compile it out, so fall
# back to a pre-mounted fuse-overlayfs that we bind into the sandbox.
OVERLAY_ARGS=(); CLEANUP=""
if bwrap --help 2>&1 | grep -q -- --overlay; then
    OVERLAY_ARGS=( --overlay-src "$GAMEDIR" --overlay "$CAP/rw" "$CAP/work" /game )
else
    command -v fuse-overlayfs >/dev/null || {
        echo "bwrap lacks --overlay and fuse-overlayfs is not installed" >&2
        echo "install fuse-overlayfs (openSUSE: zypper in fuse-overlayfs)" >&2; exit 1; }
    fuse-overlayfs -o \
        "lowerdir=$GAMEDIR,upperdir=$CAP/rw,workdir=$CAP/work" "$CAP/merged"
    CLEANUP="$CAP/merged"
    OVERLAY_ARGS=( --bind "$CAP/merged" /game )
fi
# Overlayfs creates workdir/work itself, at mode 0000, and leaves it behind
# when the mount goes away. That is deliberate while mounted -- it holds
# in-flight temporary files and nothing should look inside -- but afterwards it
# is just an inaccessible directory you own, and it is what makes the whole
# capture folder refuse to delete in a file manager until you chmod it by hand.
# It is disposable once unmounted, so take it away.
unwork() {
    [ -d "$CAP/work/work" ] || return 0
    chmod u+rwx "$CAP/work/work" 2>/dev/null || return 0
    rm -rf "$CAP/work/work" 2>/dev/null || true
}
cleanup() {
    [ -n "$CLEANUP" ] && { fusermount3 -u "$CLEANUP" 2>/dev/null \
              || fusermount -u "$CLEANUP" 2>/dev/null || true; }
    unwork
    return 0
}
trap cleanup EXIT

# ---- seccomp ---------------------------------------------------------------
# Compiled by sandbox-seccomp, which sits beside this script and says what it
# blocks and why. Refuse to start without it rather than quietly run unfiltered.
# bwrap reads the filter from an fd, so it is unlinked as soon as that is open.
SECCOMP="$(dirname "$(realpath "$0")")/sandbox-seccomp"
[ -x "$SECCOMP" ] || SECCOMP="$(command -v sandbox-seccomp || true)"
[ -n "$SECCOMP" ] || { echo "sandbox-seccomp not found beside sandbox-game or on PATH" >&2; exit 1; }
SECCOMP_BPF="$(mktemp)"
"$SECCOMP" > "$SECCOMP_BPF" || { rm -f "$SECCOMP_BPF"
    echo "could not build the seccomp filter; not starting unconfined" >&2; exit 1; }
exec 9< "$SECCOMP_BPF"; rm -f "$SECCOMP_BPF"

# ---- resource limits -------------------------------------------------------
# A transient scope puts the whole sandbox in a cgroup of its own, so a leak or
# a fork bomb runs into these ceilings instead of taking the desktop down, and
# gives it a name: systemctl --user status|kill sandbox-game-NAME-PID.scope.
# systemd-run execs bwrap in place, so --die-with-parent still means this shell.
# Without a user manager to ask -- a bare TTY, some containers -- say so and go on:
# this guards the desktop's responsiveness, not the game's reach.
SCOPE=()
if command -v systemd-run >/dev/null \
   && systemd-run --user --scope --quiet --collect -- true 2>/dev/null; then
    SCOPE=( systemd-run --user --scope --quiet --collect
            --unit "sandbox-game-$NAME-$$"
            -p MemoryMax=80% -p TasksMax=4096 -- )
else
    echo "warning: no systemd user manager; running without memory or task limits" >&2
fi

# --disable-userns shuts the door the kernel is most often attacked through:
# without it the game could make a user namespace of its own, and with it every
# capability that namespace confers. It needs --unshare-user outright, where
# --unshare-all only tries, and bwrap confirms the door is shut before starting.
BWRAP=( "${SCOPE[@]}" bwrap
    --unshare-all --unshare-user --disable-userns --seccomp 9
    --die-with-parent --new-session
    "${BASE_ENV[@]}"
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /sys /sys
    --symlink usr/lib   /lib
    --symlink usr/lib64 /lib64
    --symlink usr/bin   /bin
    --symlink usr/sbin  /sbin
    --proc /proc
    --dev /dev
    "${DEVICE_ARGS[@]}"
    --tmpfs /tmp
    "${XSOCK_ARGS[@]}"
    --perms 0700 --tmpfs "$RT"
    "${DISPLAY_ARGS[@]}"
    "${AUDIO_ARGS[@]}"
    "${EXTRA_RO[@]}"
    --bind "$CAP/home" "$HOME"
    --setenv HOME "$HOME"
    "${VIDEO_ENV[@]}"
    "${OVERLAY_ARGS[@]}"
    "${PROTON_ARGS[@]}"
    "${MKXP_ARGS[@]}"
    "${MANGOHUD_ARGS[@]}"
    "${ENV_ARGS[@]}"                  # last, so these win over the above
    --chdir "$CHDIR"
)

# Always a child rather than exec: the trap has to get a turn after the game
# exits, both to unmount fuse-overlayfs and to clear the overlay workdir. The
# cost is one idle shell for the life of the game, and --die-with-parent
# already means killing it takes the sandbox with it.
"${BWRAP[@]}" "$@"; rc=$?
cleanup; trap - EXIT
exit "$rc"
