#!/usr/bin/env bash
# sandbox-game [--wayland] [--name NAME] [--mangohud] [--gamescope[=ARGS]]
#              [--hdr] [--proton[=VER] [--mod-loaders] [--steam] [--hide-tray]|--mkxp[=DIR]|--pgmmv[=DIR]] GAMEDIR CMD...
#   Runs CMD inside an isolated bwrap sandbox:
#     - no network (--unshare-all includes the net namespace), unless --net
#     - no nested user namespaces, a seccomp filter (see sandbox-seccomp), and
#       memory/task limits via a systemd scope
#     - real $HOME absent; a fresh $HOME is redirected to the capture dir
#     - the shared tools folder (Cheat Engine and the like; see sandbox-attach)
#       is mounted read-only at /tools, when it exists
#     - GAMEDIR is presented at /game as an overlay; the pristine install is
#       never modified, all writes are captured
#   Everything the game writes ends up under ONE folder:
#     ~/game-sandboxes/NAME/  ->  home/   (writes to $HOME: configs, saves)
#                                 rw/     (writes into the install dir at /game)
#                                 compat/ (--proton: the Wine prefix, under pfx/)
#                                 mkxp.json (--mkxp: the runtime config, yours
#                                            to edit -- only created if absent)
#
#   --wayland   force SDL onto native Wayland (SDL_VIDEODRIVER=wayland), no X.
#               Only for engines whose SDL has a Wayland backend. Older
#               Ren'Py builds bundle an SDL without one; for those it is
#               dropped, with a note, for gamescope's private Xwayland.
#               With --proton it selects Proton's winewayland driver instead
#               (STEAM_COMPAT_CONFIG=wayland); GE/DW/CachyOS builds honour it,
#               builds without that driver need --gamescope for Xwayland.
#               Not under gamescope, whose Wayland server that driver cannot
#               use: there Proton goes through gamescope's Xwayland.
#   --wayland-x11  Proton's main game uses the desktop's native Wayland;
#               compatible launcher/helper processes use gamescope's private
#               Xwayland. Needs a runner with per-process graphics selection.
#   --x11-backend=BACKEND  with --wayland-x11: gamescope (default) or satellite,
#               which gives launchers separate desktop windows.
#   --x11-exe EXE  with --wayland-x11, an extra executable basename or Windows
#               path fragment for the runner to put on X11.
#   --name NAME override the sandbox name (else derived from the game dir).
#   --net       give the game the internet, and only that: no LAN, nothing
#               listening on this machine, no incoming connections. Through
#               pasta (package passt); see "network" further down.
#   --env K=V   set a variable inside the sandbox; repeatable, and applied last
#               so it wins over the clean environment and display defaults
#               (e.g. --env WAYLANDDRV_PRIMARY_MONITOR=HDMI-1).
#   --mangohud  show the MangoHud overlay. Your ~/.config/MangoHud is bound
#               back in read-only -- $HOME is redirected, so without that the
#               fps_limit and per-executable .conf files silently stop
#               applying. Exporting MANGOHUD=1 opts in just the same.
#               64-bit only unless mangohud-32bit is installed.
#   --hdr       let the game show HDR where the display path has it: DXVK and
#               vkd3d-proton tell Windows games about the screen's HDR
#               (DXVK_HDR=1), and gamescope, when the game runs in it, gets
#               --hdr-enabled. On native Wayland the desktop's compositor does
#               the rest. HDR also has to be on in the desktop's display
#               settings and in the game. In split display only the game's own
#               window has it, not gamescope's. Not with --host-x11: X11 has none.
#   --gamescope run the game inside gamescope's nested compositor. =ARGS passes
#               options through, e.g. --gamescope='-f -W 2560 -H 1440' (word
#               split, so quote the lot). Together with --mangohud this becomes
#               gamescope --mangoapp, which is what gamescope's own help says to
#               use in place of wrapping the game in mangohud; that needs the
#               separate mangoapp package. gamescope displays through the host
#               Wayland socket and brings its own nested Xwayland for the game,
#               so the host X server stays out of the sandbox in this mode.
#   --proton    run CMD as a Windows program under Proton: CMD is the .exe and
#               its args, and the sandbox cwd becomes the .exe's own directory.
#               =VER picks a Proton by name substring or by path; without it the
#               newest one found in the usual Steam locations wins. $PROTON_DIR
#               overrides the search entirely. The prefix is built fresh under
#               compat/, so your real Steam prefixes are never touched, and the
#               Proton install itself is mounted read-only.
#   --mod-loaders  with --proton: Wine takes the game's own winhttp.dll,
#               version.dll and the like over its built-in ones, as Windows
#               does, so BepInEx, MelonLoader, UE4SS and ASI loaders load.
#   --steam     with --proton: start CMD through Proton's steam.exe, which
#               stands in for a running Steam client. Without it, Proton
#               builds with umu's non-Steam mode start CMD with plain Wine.
#   --hide-tray with --proton: hide the window Wine opens for tray icons when
#               it has no tray to put them in (ShowSystray=0 in the prefix).
#   --mkxp      run an RPG Maker XP/VX/VX Ace game natively under mkxp-z, no
#               Wine involved. CMD is optional and normally omitted: the
#               runtime is the program. =DIR names the mkxp-z install, else
#               ~/.local/share/mkxp* and friends are searched; $MKXP_DIR wins.
#               mkxp-z resolves everything relative to its own binary, never
#               the cwd, so the game is handed over as "gameFolder": "/game"
#               in a generated config bound over the runtime's own mkxp.json.
#   --pgmmv    run a Pixel Game Maker MV / Action Game Maker MV game with the
#               native Linux player. CMD is optional: extra player arguments.
#               =DIR names the whole bundle with bin/, lib/ and share/;
#               $PGMMV_DIR wins. Otherwise pgmmv-player* under ~/.local/share,
#               ~/.local/opt and /opt are searched, then this checkout's
#               pgmmv-player-decrypt/. The bundle is read-only at /pgmmv.
#   --dotnet    give a .NET program the host's .NET runtime, read-only at
#               /dotnet with DOTNET_ROOT pointing there. Programs published
#               without the runtime bundled stop otherwise with "You must
#               install .NET to run this application". =DIR names the
#               install; else $DOTNET_ROOT, /etc/dotnet/install_location,
#               ~/.dotnet, the usual system folders and the dotnet on PATH.
#   --with-proton  for a native program that starts Wine itself (a game's own
#               Linux launcher, say): the Proton install, read-only at /proton,
#               for it to find there. =VER as for --proton. The program is
#               still what runs; point it at /proton/files/bin/wine.
#   --allow-lan LIST  with --net: these LAN addresses or networks after all,
#               separated by commas or spaces. ADDR[/PREFIX][:PORT[-PORT]][/tcp|/udp],
#               IPv6 in brackets when a port follows. A port without a
#               protocol means TCP and UDP. Repeatable.
#   --lan       with --net: the whole LAN too. Still not this machine.
#   --mac-vendor  with --net: the game's network card gets the manufacturer
#               prefix of this machine's own card, the rest made up, rather
#               than an address that is plainly made up. Kept per sandbox.
#   --hosts     a private /etc/hosts: the host's, with the --add-host entries
#               in front of it, made afresh on every launch. The game's own
#               name lookups only; the desktop's are not affected.
#   --add-host "ADDR NAME..."  an entry for it; implies --hosts. Repeatable.
#   --hosts-writable  the game may change that file as well, which then
#               lives on as ~/game-sandboxes/NAME/hosts; the --add-host entries
#               are rewritten and conflicting names elsewhere removed on later
#               launches. pkexec runs its command as is in here, so a program
#               that edits /etc/hosts through it gets on.
#   --require LIST  refuse to start unless these protections hold, where the
#               launch would otherwise go on with a warning: landlock, scoped,
#               private-display, limits, audio, seccomp, or all (see
#               REQUIREMENTS in sandbox-game-lib). Added to what the game's
#               preferences require (require=); only a change there relaxes those.
#

#   Default uses gamescope's private Xwayland. --host-x11 opts into the host
#   X server (other X clients can be observed/controlled). --headless exposes
#   no display. Audio is always on -- enough games refuse to start without a
#   sound device that withholding it broke more than it protected -- and
#   playback-only when install.sh --restrict-audio set that up: see
#   audio/sandbox-pulse.conf. Otherwise it is the desktop's own PipeWire and
#   Pulse sockets, recording and all.
#
# sandbox-game --stop NAME | --stop-all
#   End a running sandbox outright: the game, Wine and anything sandbox-attach
#   started in there, all at once. For a game that hangs, or will not let go
#   of the screen. Names are as `sandbox-attach --list` shows them. The launch
#   it ends exits 0, so the file manager does not report it as a crash.
#
# CMD references the game at /game, e.g.:
#   sandbox-game /mnt/General-HDD/Games/games/DDLC  /game/DDLC.sh
#   sandbox-game --proton /mnt/General-HDD/Games/games/Witcher3 /game/witcher3.exe
#   sandbox-game --proton=GE-Proton11 ~/Games/Foo /game/bin/foo.exe -windowed
#   sandbox-game --mkxp /mnt/General-HDD/Games/games/SomeVXAceGame
set -euo pipefail

# Helpers -- sandbox-seccomp, sandbox-landlock, sandbox-game-lib -- are looked
# for beside this script (a checkout of the repo), then where install.sh puts
# them, then on PATH.
helper() {
    local d
    for d in "$(dirname "$(realpath "$0")")" "$HOME/.local/lib/sandbox-game"; do
        [ -e "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }
    done
    command -v "$1" || true
}

# Shared with the Nautilus scripts, which have to agree with this on what a
# game can do: the Ren'Py check, for one.
SHARED_LIB="$(helper sandbox-game-lib)"
[ -n "$SHARED_LIB" ] || { echo "sandbox-game-lib not found; run install.sh" >&2; exit 1; }
# shellcheck source=sandbox-game-lib
. "$SHARED_LIB"

# ---- proton discovery ------------------------------------------------------
# Where Steam keeps compatibility tools, native install and flatpak alike. Kept
# up here so --list-proton can answer before a game is even named; the menu that
# offers these versions has no business restating the search paths.
proton_roots() {
    printf '%s\n' \
        "$HOME/.local/share/Steam/compatibilitytools.d" \
        "$HOME/.steam/root/compatibilitytools.d" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d" \
        "$HOME/.local/share/Steam/steamapps/common" \
        "$HOME/.steam/root/steamapps/common" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/common" \
        "$HOME/.local/share/bottles/runners" \
        "$HOME/.var/app/com.usebottles.bottles/data/bottles/runners" \
        /usr/share/steam/compatibilitytools.d
}

list_protons() {                      # every install found, newest first
    local root d ver
    while IFS= read -r root; do
        [ -d "$root" ] || continue
        for d in "$root"/*/; do
            d="${d%/}"
            [ -x "$d/proton" ] || continue
            ver="$(cut -d' ' -f1 "$d/version" 2>/dev/null || true)"
            [[ "$ver" =~ ^[0-9]+$ ]] || ver=0
            printf '%s\t%s\n' "$ver" "$(basename "$d")"
        done
    done < <(proton_roots) | sort -rn -k1,1 | cut -f2 | awk '!seen[$0]++'
}

# ---- stop ------------------------------------------------------------------
# A sandbox's outer bwrap runs in our own namespaces and is the parent of its
# pid 1. Killing it lets --die-with-parent take pid 1 down, and the kernel
# then kills everything else in that pid namespace -- the game, wineserver,
# gamescope and anything sandbox-attach put in there. The capture's home is
# how a sandbox is recognised: `--bind ~/game-sandboxes/NAME/home $HOME`.
outer_bwraps() {                      # $1 = NAME, empty for all -> "pid name"
    local p args name ours
    for p in /proc/[0-9]*; do
        p="${p##*/}"
        # Same user namespace: -ef compares the namespaces' inodes, without a
        # readlink process per entry. Other users' processes fail the stat.
        ours=1
        [[ "/proc/$p/ns/user" -ef /proc/self/ns/user ]] || { ours=0; started_by_us "$p"; } || continue
        # Grouped so a process exiting mid-scan does not print anything.
        { mapfile -d '' -t args < "/proc/$p/cmdline"; } 2>/dev/null || continue
        [ "${#args[@]}" -gt 1 ] && [ "${args[0]##*/}" = bwrap ] || continue
        bound_capture "${args[@]}"; name="$BOUND"
        [ -n "$name" ] || continue
        [ "$ours" = 1 ] || sandbox_user "$p" "$name" || continue
        [ -z "$1" ] || [ "$name" = "$1" ] || continue
        printf '%s %s\n' "$p" "$name"
    done
}

stop_sandboxes() {                    # $1 = NAME, empty for all
    local found pids=() names=() p n
    found="$(outer_bwraps "$1")"
    [ -n "$found" ] || {
        [ -n "$1" ] && echo "no running sandbox named '$1'" >&2 \
                    || echo "no sandboxes running" >&2
        return 1; }
    while read -r p n; do pids+=( "$p" ); names+=( "$n" ); done <<<"$found"
    # Tells the launching sandbox-game this was asked for, so it exits 0 and
    # the file manager does not report a failure. The capture dir itself is
    # not mounted in the sandbox, so the game cannot fake or clear this.
    for n in "${names[@]}"; do : > "$HOME/game-sandboxes/$n/.stopped"; done
    kill -TERM "${pids[@]}" 2>/dev/null || true
    # Games get no say in this -- a hung one would not answer anyway -- but
    # give bwrap a moment to go on TERM before insisting.
    for _ in $(seq 50); do
        for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && break; p=""; done
        [ -n "$p" ] || break
        sleep 0.1
    done
    # Only the ones still there, and still those sandboxes' bwrap: a PID
    # that went on TERM may already belong to some other process.
    local left=()
    while read -r p n; do
        [ -n "$p" ] && [[ " ${pids[*]} " == *" $p "* ]] && left+=( "$p" )
    done <<<"$(outer_bwraps "$1")"
    [ "${#left[@]}" -eq 0 ] || kill -KILL "${left[@]}" 2>/dev/null || true
    printf 'stopped %s\n' "${names[@]}" | sort -u
}

# ---- managing sandboxes ----------------------------------------------------
# All of a game's state is its capture folder, so managing a sandbox is
# managing that folder -- never while the game runs, since the overlay is
# mounted on it then.
SANDBOXES="$HOME/game-sandboxes"
LOCKS="$SANDBOXES/.locks"

# .locks is where the locks are kept, not a sandbox.
valid_name() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]] && [ "$1" != . ] && [ "$1" != .. ] && [ "$1" != .locks ]; }

# One prefix/overlay may only have one owner, including during startup before
# bwrap exists, and nothing may launch it while --delete or --reset-install
# changes it. Taken on descriptor 18 and held until this script ends:
# everything long-lived started from here (bwrap, fuse-overlayfs, pasta)
# closes it. Kept out of the capture, which --delete removes while holding
# it, and out of sight, in .locks/. The files stay: removed after use, one a
# waiting launch already has open could be locked again by it while a new
# file is locked by another. $1 = NAME.
lock_sandbox() {
    mkdir -p "$LOCKS" && exec 18>"$LOCKS/$1" && flock -n 18 || return 1
    # Beside the capture, as NAME.run-lock, for launches before locks moved:
    # one may still be running. Unheld, it goes.
    local old="$SANDBOXES/$1.run-lock"
    [ -e "$old" ] || return 0
    flock -n "$old" true 2>/dev/null || return 1
    rm -f -- "$old"
}

# An existing, stopped sandbox, or say why not. $1 = NAME.
stopped_sandbox() {
    valid_name "$1" && [ -d "$SANDBOXES/$1" ] || {
        echo "no sandbox named '$1' (see sandbox-game --list)" >&2; return 1; }
    [ -z "$(outer_bwraps "$1")" ] || {
        echo "'$1' is running; stop it first: sandbox-game --stop $1" >&2; return 1; }
    # Also covers startup, before the outer bwrap has appeared, and holds
    # launches off for the whole delete/reset operation.
    lock_sandbox "$1" || {
        echo "'$1' is running or being changed; stop it first" >&2; return 1; }
}

# Asked only in a terminal, so scripts can still use these.
confirm() {
    [ -t 0 ] || return 0
    local answer
    read -r -p "$1 [y/N] " answer
    [[ "$answer" == [yY]* ]]
}

# Overlayfs leaves work/work at mode 0000; nothing can be removed under it
# until that is undone.
unlock_work() { chmod -R u+rwx "$1/work" 2>/dev/null || true; }

# A sandbox that ran under a uid of its own (SANDBOX_SEPARATE_UID) has folders
# of that user's, which you cannot change: give them back to you first, from
# its namespace. The next launch hands them over again.
reclaim() {                           # $1 = capture folder
    [ -f "$1/uid" ] || return 0
    local u; u="$(helper sandbox-uid)"
    [ -n "$u" ] && "$u" run "$1" -- chown -hR 0:0 "$1" && return 0
    # Without the sandbox's uid any more -- its range gone from /etc/subuid,
    # say -- only root can. Once it has, there is nothing left to do.
    [ -n "$(find "$1" ! -user "$(id -u)" -print -quit 2>/dev/null)" ] || return 0
    [ -n "$u" ] || { echo "sandbox-uid not found; run install.sh" >&2; return 1; }
    echo "could not give $1 back to you from the sandbox's uid; as root:" >&2
    echo "  sudo chown -R $(id -un): '$1'" >&2
    return 1
}

played() {                            # seconds -> "3h 12m"
    local s="$1"
    if [ "$s" -ge 3600 ]; then printf '%dh %02dm' $((s / 3600)) $((s % 3600 / 60))
    elif [ "$s" -ge 60 ]; then printf '%dm' $((s / 60))
    else printf '<1m'; fi
}

list_sandboxes() {
    local d name running total last size state
    running=" $(outer_bwraps "" | awk '{print $2}' | tr '\n' ' ') "
    printf '%-32s %7s %9s  %-16s %s\n' NAME SIZE PLAYED "LAST PLAYED" STATE
    for d in "$SANDBOXES"/*/; do
        [ -d "$d" ] || continue
        d="${d%/}"; name="${d##*/}"
        valid_name "$name" || continue
        total=0; last=""
        if [ -f "$d/playtime" ]; then
            read -r total last < <(awk '{ t += $2; if ($1 + $2 > l) l = $1 + $2 }
                                        END { print t + 0, l }' "$d/playtime")
        fi
        # Blocks shared with other games (reflinked Proton files) count in
        # each of them, as du counts them. While a game runs, overlayfs keeps
        # its work folder unreadable; du counts the rest and complains.
        size="$(du -sh "$d" 2>/dev/null | cut -f1 || true)"
        [[ "$running" == *" $name "* ]] && state=running || state=""
        printf '%-32s %7s %9s  %-16s %s\n' "$name" "${size:--}" \
            "$([ "$total" -gt 0 ] && played "$total" || echo -)" \
            "$([ -n "$last" ] && date -d "@$last" '+%Y-%m-%d %H:%M' || echo -)" "$state"
    done
}

delete_sandbox() {                    # $1 = NAME
    stopped_sandbox "$1" || return 1
    local d="$SANDBOXES/$1"
    confirm "Delete $d ($(du -sh "$d" 2>/dev/null | cut -f1 || true)) -- saves, settings and Wine prefix with it?" || {
        echo "left alone"; return 1; }
    reclaim "$d" || return 1
    unlock_work "$d"
    rm -rf -- "$d"
    echo "deleted $1"
    [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/sandbox-game/games/$1" ] \
        || echo "its preferences are kept: ${XDG_CONFIG_HOME:-$HOME/.config}/sandbox-game/games/$1"
}

# Throw away what the game changed in its own install folder -- rw/, the
# overlay's upper layer -- so an updated install shows through again instead
# of the copies the old one left. home/ (saves, settings) and the Wine prefix
# are not touched, and neither is anything in rw/ with "save" in its name, in
# any case: plenty of engines keep saves inside the install -- RPG Maker MV
# and MZ in www/save or save, Ren'Py in game/saves, RPG Maker XP/VX/VX Ace
# as Save01.rxdata and the like right in the game folder, others in SaveData.
# Matching by name keeps a little too much at worst: an updated file that
# happens to be called that stays hidden, rather than a save being lost.
reset_install() {                     # $1 = NAME
    stopped_sandbox "$1" || return 1
    local d="$SANDBOXES/$1" keep=() changed f
    reclaim "$d" || return 1          # all of rw/ readable, for the look below too
    # At any depth: rw/ holds only what the game changed, so this is quick,
    # and a save nested deeper than a guess would be gone for good.
    mapfile -t keep < <(cd "$d/rw" && find . -mindepth 1 -iname '*save*' -print -prune |
                        sed 's|^\./||')
    # Files, links, the character devices overlayfs uses to mark a deletion,
    # and directories the game made and left empty -- outside the saves being
    # kept. Other directories are only there to hold those.
    changed="$(cd "$d/rw" && find . -mindepth 1 \( ! -type d -o -empty \) | sed 's|^\./||' |
        awk -v keep="$(printf '%s\n' ${keep[@]+"${keep[@]}"})" '
            BEGIN { n = split(keep, k, "\n") }
            { for (i = 1; i <= n; i++)
                  if (k[i] != "" && ($0 == k[i] || index($0, k[i] "/") == 1)) next
              print }')"
    [ -n "$changed" ] || {
        echo "$1: nothing changed in its install folder${keep[0]:+, apart from its saves}"; return 0; }
    echo "$1: changes to its install folder, to be discarded:"
    awk -F/ '{ n[$1]++ } END { for (t in n) printf "  %s (%d file%s)\n", t, n[t], (n[t] > 1 ? "s" : "") }' \
        <<<"$changed" | sort
    for f in ${keep[@]+"${keep[@]}"}; do echo "kept: $f (looks like a save)"; done
    confirm "Discard them?" || { echo "left alone"; return 1; }
    unlock_work "$d"
    rm -rf -- "$d/rw.keep"
    for f in ${keep[@]+"${keep[@]}"}; do
        mkdir -p "$d/rw.keep/$(dirname "$f")"
        mv -- "$d/rw/$f" "$d/rw.keep/$f"
    done
    rm -rf -- "$d/rw" "$d/work"
    if [ -d "$d/rw.keep" ]; then mv -- "$d/rw.keep" "$d/rw"; else mkdir "$d/rw"; fi
    mkdir -p "$d/work"
    echo "reset $1"
}

# ---- resource limits and host checks ---------------------------------------
# A transient scope puts the whole sandbox in a cgroup of its own, so a leak,
# a fork bomb or a busy loop runs into these ceilings instead of taking the
# desktop down, and gives it a name:
# systemctl --user status|kill sandbox-game-NAME-PID.scope.
#
# All but one core's worth of CPU time, so the rest of the desktop keeps one
# however hard the game -- or a miner hiding in it -- works. Not a lower
# CPUWeight: that only counts against the other apps beside it in app.slice,
# and would have the game give way to a busy browser tab. A game rarely keeps
# every core busy; shader compiles lose 1/N.
#
# Sets LIMITS (the scope properties), CPUS, SCOPE (systemd-run up to its
# options) and UNLIMITED (the controllers a scope here cannot limit, space
# separated); returns 1 when there is no user manager to ask. It asks with a
# trial scope carrying the same limits, which names each one its cgroup does
# not hold to -- no file for it, or no limit in it: the user manager can only
# set what it was delegated. openSUSE ships user@.service with Delegate=
# emptied, and there memory and CPU limits are accepted without a word and
# never applied.
probe_limits() {
    local controllers=( memory pids )
    LIMITS=( -p MemoryMax=80% -p TasksMax=4096 )
    CPUS="$(nproc 2>/dev/null || echo 1)"
    [ "$CPUS" -lt 2 ] || { LIMITS+=( -p "CPUQuota=$(( (CPUS - 1) * 100 ))%" ); controllers+=( cpu ); }
    SCOPE=( systemd-run --user --scope --quiet --collect )
    # systemd-run 254+ expands ${VAR} in the command it runs, as unit files
    # do, and blanks what it cannot parse: `b=${f##*/}` in the NW.js launch
    # script arrived as `b=`. The command line is ours, not a unit's; hand it
    # over as written. Older versions neither expand nor know the switch.
    # Not piped into grep -q: under pipefail, grep leaving at the first match
    # can kill systemd-run with SIGPIPE, and the switch would be left out.
    [[ "$(systemd-run --help 2>/dev/null)" == *--expand-environment* ]] \
        && SCOPE+=( --expand-environment=no )
    command -v systemd-run >/dev/null \
        && UNLIMITED="$("${SCOPE[@]}" "${LIMITS[@]}" -- /bin/sh -c '
            d="/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)"
            for c do
                v="$(cat "$d/$c.max" 2>/dev/null)" || v=max
                [ "${v%% *}" != max ] || printf "%s " "$c"
            done' sh "${controllers[@]}" 2>/dev/null)" \
        || return 1
    UNLIMITED="${UNLIMITED% }"
}

# Proton runs on this system's libraries, not Steam's runtime. A build with a
# 32-bit Wine of its own (the i386-unix drivers) starts 32-bit Windows
# programs, as many installers and launchers still are, through the system's
# 32-bit loader, and its display and sound drivers link or open 32-bit system
# libraries. Without them an installer dies at once, or runs and never opens a
# window. Sets W32_PROTONS and W32_DRIVERS, counts of what was found, and
# W32_MISSING, the libraries any of those drivers cannot find, each with the
# Protons whose drivers want it, or alone when it is missing for them all.
wine32_status() {
    local dirs=() d f root lib arrow rest cache re names ld=/usr/lib/ld-linux.so.2
    local -A missing=()                 # library -> the Protons wanting it, a line each
    W32_PROTONS=0; W32_DRIVERS=0; W32_MISSING=()
    [ -z "${PROTON_DIR:-}" ] || dirs+=( "${PROTON_DIR%/}" )
    while IFS= read -r root; do
        for d in "$root"/*/; do dirs+=( "${d%/}" ); done
    done < <(proton_roots)
    for d in "${dirs[@]}"; do
        [ -x "$d/proton" ] || continue
        W32_PROTONS=$((W32_PROTONS + 1))
        for f in "$d"/files/lib/wine/i386-unix/{winex11,winewayland,winepulse}.so; do
            [ -f "$f" ] || continue
            W32_DRIVERS=$((W32_DRIVERS + 1))
            [ -x "$ld" ] || continue
            # The loader's own answer, with the library folders proton adds,
            # traced as ldd does: --list stops at the first library missing.
            # Wine's own modules beside the driver are found by Wine itself.
            while read -r lib arrow rest; do
                [ "$arrow $rest" = "=> not found" ] || continue
                [ ! -e "${f%/*}/$lib" ] || continue
                [[ $'\n'"${missing[$lib]:-}" == *$'\n'"${d##*/}"$'\n'* ]] \
                    || missing[$lib]+="${d##*/}"$'\n'
            done < <(LD_TRACE_LOADED_OBJECTS=1 LD_LIBRARY_PATH="$d/files/lib/i386-linux-gnu:$d/files/lib" \
                     "$ld" "$f" 2>/dev/null || true)
        done
    done
    # Fonts, TLS, Vulkan and EGL are opened at run time, so --list cannot see
    # them; the loader's cache marks 32-bit x86 entries "(libc6)" or
    # "(libc6, OS ABI: ...)". No cache to read, no verdict on these.
    if [ "$W32_DRIVERS" -gt 0 ] && [ -x "$ld" ] \
        && cache="$({ ldconfig -p || /sbin/ldconfig -p; } 2>/dev/null)"; then
        for lib in libfreetype.so.6 libfontconfig.so.1 libgnutls.so.30 libvulkan.so.1 libEGL.so.1; do
            re=$'(^|\n)\t'"${lib//./\\.}"' \(libc6(\)|, )'
            [[ "$cache" =~ $re ]] || missing[$lib]=""
        done
    fi
    while IFS= read -r lib; do
        [ -n "$lib" ] || continue
        names="${missing[$lib]%$'\n'}"
        W32_MISSING+=( "$lib${names:+ (${names//$'\n'/, })}" )
    done < <(printf '%s\n' "${!missing[@]}" | sort)
}

# sandbox-game --check: what of all this holds on this machine, one line
# each. "!!" is something a sandbox here goes without that it would normally
# have, and makes the exit status 1; "--" something optional or not
# available here by design.
check_host() {
    local here rt out abi failed=0 nodes=()
    rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    _check_line() { printf '  %s  %-12s %s\n' "$1" "$2" "$3"; [ "$1" != '!!' ] || failed=1; }
    # Each saved scope may choose another policy. Keep invalid preferences
    # distinct from a compiler failure, and propagate neither scope's exports.
    _check_filter() {
        local out status label="${1:-defaults}"
        if out="$(
            exec 2>&1
            NAME="$1"
            security_prefs || exit 2
            compiler="$(helper sandbox-seccomp)"
            [ -n "$compiler" ] || { echo "sandbox-seccomp not found"; exit 1; }
            "$compiler" --status || exit 1
        )"; then
            if [ "$out" = "socket families filtered" ]; then
                _check_line ok seccomp "$label: syscall filter, socket families filtered"
            else
                _check_line -- seccomp "$label: syscall filter; $out"
            fi
            return 0
        else
            status=$?
            if [ "$status" = 2 ]; then
                _check_line '!!' preferences "$label: $out"
            else
                _check_line '!!' seccomp "$label: cannot build the filter: $out"
            fi
            return "$status"
        fi
    }

    if command -v flock >/dev/null; then
        _check_line ok flock "one writer per sandbox"
    else
        _check_line '!!' flock "not installed: launches need it (package util-linux)"
    fi

    if ! command -v bwrap >/dev/null; then
        _check_line '!!' sandbox "bwrap is not installed"
    elif out="$(bwrap --unshare-all --unshare-user --disable-userns --ro-bind / / true 2>&1)"; then
        _check_line ok sandbox "$(bwrap --version), nested user namespaces off"
    else
        _check_line '!!' sandbox "cannot start one: $out"
    fi

    local default_filter_status=0
    _check_filter "" || default_filter_status=$?

    abi="$(python3 "$(helper sandbox-landlock)" --abi 2>/dev/null || echo 0)"
    if [ "$abi" -ge 6 ] 2>/dev/null; then
        _check_line ok landlock "ABI $abi: files, and signals and abstract sockets scoped"
    elif [ "$abi" -ge 1 ] 2>/dev/null; then
        _check_line ok landlock "ABI $abi: files only (signal and socket scoping need ABI 6)"
    else
        _check_line '!!' landlock "not available: not in this kernel, or not in its lsm= list"
    fi

    if ! probe_limits; then
        _check_line '!!' limits "no systemd user manager: no memory, CPU or task limits"
    elif [ -n "$UNLIMITED" ]; then
        _check_line '!!' limits "no ${UNLIMITED// / or } limit: not delegated to the user manager (README: \"Memory, CPU and task limits\")"
    elif [ "$CPUS" -ge 2 ]; then
        _check_line ok limits "80% of memory, $((CPUS - 1)) of $CPUS cores, 4096 tasks"
    else
        _check_line ok limits "80% of memory, 4096 tasks"
    fi

    if [ -S "$rt/sandbox-pulse/native" ]; then
        _check_line ok sound "playback only (sandbox-pulse)"
    else
        _check_line '!!' sound "the desktop's own sockets: games can record (./install.sh --restrict-audio)"
    fi

    for out in /dev/dri/renderD*; do [ ! -c "$out" ] || nodes+=( "${out##*/}" ); done
    if [ "${#nodes[@]}" -gt 0 ]; then
        _check_line ok gpu "render nodes: ${nodes[*]}"
    else
        _check_line '!!' gpu "no render node: no GPU acceleration in games"
    fi

    if ! command -v gamescope >/dev/null; then
        _check_line '!!' gamescope "not installed: the default display needs it (--wayland does not)"
    elif python3 "$(helper sandbox-landlock)" --has-unix-connect 2>/dev/null; then
        _check_line ok gamescope "installed; games under it cannot reach the desktop's compositor"
    else
        _check_line -- gamescope "installed, but this kernel's Landlock cannot keep games under it off the desktop's compositor"
    fi
    if { [ -n "$(helper sandbox-xwayland-satellite)" ] || command -v xwayland-satellite >/dev/null; } \
            && command -v Xwayland >/dev/null; then
        _check_line ok satellite "optional private X11 backend for --wayland-x11 installed"
    else
        _check_line -- satellite "optional --x11-backend=satellite needs xwayland-satellite and Xwayland"
    fi

    if command -v pasta >/dev/null && command -v ip >/dev/null; then
        _check_line ok network "--net available (pasta)"
    else
        _check_line -- network "--net unavailable: needs pasta (passt) and ip (iproute2)"
    fi

    if [ -c /dev/ntsync ] && [ -r /dev/ntsync ] && [ -w /dev/ntsync ]; then
        _check_line ok ntsync "/dev/ntsync, given to Proton games"
    elif [ -c /dev/ntsync ]; then
        _check_line -- ntsync "/dev/ntsync is there but not yours to open (mode $(stat -c %a /dev/ntsync))"
    else
        _check_line -- ntsync "no /dev/ntsync: kernel older than 6.14, or the module not loaded"
    fi

    wine32_status
    if [ "$W32_PROTONS" = 0 ]; then
        _check_line -- 32-bit "no Proton found: nothing to check"
    elif [ "$W32_DRIVERS" = 0 ]; then
        _check_line -- 32-bit "no separate 32-bit Wine in the Protons found (WoW64 builds need none)"
    elif [ ! -x /usr/lib/ld-linux.so.2 ]; then
        _check_line '!!' 32-bit "no 32-bit glibc (/usr/lib/ld-linux.so.2): Proton cannot start 32-bit programs, many installers and launchers among them"
    elif [ "${#W32_MISSING[@]}" -gt 0 ]; then
        out="$(printf '%s; ' "${W32_MISSING[@]}")"
        _check_line '!!' 32-bit "32-bit programs under Proton lack ${out%; }: install their 32-bit packages"
    else
        _check_line ok 32-bit "Proton's 32-bit Wine finds the system libraries it needs"
    fi

    # Saved requirements, by game, as a launch would take them -- a game's own
    # file over the defaults -- and what of each this machine cannot meet.
    # What a launch's display or sound would contradict is said at launch.
    local name file all key own_security filter_status
    for file in "$CFGDIR/defaults" "$CFGDIR"/games/*; do
        [ -f "$file" ] || continue
        if [ "$file" = "$CFGDIR/defaults" ]; then name=""; else name="${file##*/}"; fi
        own_security=0
        for key in $SECURITY_PREF_KEYS; do
            file_get "$file" "$key" >/dev/null && own_security=1
        done
        filter_status="$default_filter_status"
        if [ -n "$name" ] && [ "$own_security" = 1 ]; then
            filter_status=0
            _check_filter "$name" || filter_status=$?
        fi
        [ "$filter_status" != 2 ] || continue  # a configuration error, already reported
        all="$(NAME="$name" cfg_get require "")"
        [ -n "$all" ] || continue
        [ -z "$name" ] || [ "$own_security" = 1 ] || file_get "$file" require >/dev/null || continue
        if ! parse_requirements "$all" 2>/dev/null; then
            _check_line '!!' preferences "${name:-defaults}: unknown requirement in '$all'"
        else
            # Only stdout lists unmet protections. Helpers' warnings remain on
            # stderr and do not turn a satisfied requirement into a refusal.
            out="$(NAME="$name"; security_prefs && requirement_failures $R_REQUIRE)"
            if [ "$filter_status" != 0 ] && [[ " $R_REQUIRE " == *" seccomp "* ]]; then
                out+="${out:+$'\n'}seccomp: the selected filter cannot be built"
            fi
            if [ -z "$out" ]; then
                _check_line ok require "${name:-defaults}: $R_REQUIRE"
            else
                _check_line '!!' require "${name:-defaults}: $R_REQUIRE; cannot launch here: ${out//$'\n'/; }"
            fi
        fi
    done
    return "$failed"
}

# Why each requirement given cannot be met, a line each with what would help;
# nothing when all can. Machine-wide unless LAUNCH=1, when this launch's own
# choices -- display, sound, uid, seccomp mode -- count as well.
requirement_failures() {
    local r abi
    abi="$(python3 "$(helper sandbox-landlock)" --abi 2>/dev/null || echo 0)"
    [[ "$abi" =~ ^[0-9]+$ ]] || abi=0
    for r in "$@"; do
        case "$r" in
            landlock)
                [ "$abi" -ge 1 ] || echo "landlock: this kernel has no Landlock, or it is not in its lsm= list" ;;
            scoped)
                [ "$abi" -ge 6 ] || echo "scoped: signal and abstract socket scoping need Landlock ABI 6 (Linux 6.12); this kernel has $abi" ;;
            private-display)
                if [ "${LAUNCH:-0}" = 1 ] && [ "$HEADLESS" = 0 ]; then
                    if [ "$HOST_X11" = 1 ]; then
                        echo "private-display: --host-x11 puts the game on the desktop's own X server"
                    elif [ "$WAYLAND_X11" = 1 ]; then
                        echo "private-display: split display (--wayland-x11) gives the game the desktop's compositor"
                    elif [ "$OUTER_DISPLAY" = 0 ]; then
                        echo "private-display: --wayland without gamescope gives the game the desktop's compositor"
                    fi
                fi
                if [ "${LAUNCH:-0}" = 0 ] || { [ "$HEADLESS" = 0 ] && [ "$OUTER_DISPLAY" = 1 ]; }; then
                    python3 "$(helper sandbox-landlock)" --has-unix-connect 2>/dev/null \
                        || echo "private-display: this kernel's Landlock cannot keep the game off the desktop's compositor socket"
                fi ;;
            limits)
                if ! probe_limits; then
                    echo "limits: no systemd user manager to set memory, CPU and task limits"
                elif [ -n "$UNLIMITED" ]; then
                    echo "limits: no ${UNLIMITED// / or } limit: the controller is not delegated to the user manager" \
                         "(README: \"Memory, CPU and task limits\")"
                fi ;;
            audio)
                # A uid of its own gets no sound at all without that server.
                [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sandbox-pulse/native" ] \
                    || { [ "${LAUNCH:-0}" = 1 ] && [ "$SEPARATE_UID" != 0 ]; } \
                    || echo "audio: no playback-only sound server (./install.sh --restrict-audio sets one up)" ;;
            seccomp)
                [ "${SANDBOX_SECCOMP:-}" != log ] \
                    || echo "seccomp: SANDBOX_SECCOMP=log lets every call the filter blocks through" ;;
        esac
    done
}

# ---- args ------------------------------------------------------------------
# The short version. The header above says why each of these is the way it is.
usage() {
    cat <<'EOF'
usage: sandbox-game [OPTIONS] GAMEDIR CMD...
       sandbox-game --list | --stop NAME | --stop-all
       sandbox-game --reset-install NAME | --delete NAME
       sandbox-game --print-name GAMEDIR | --list-proton | --check | --help

Runs CMD in a bwrap sandbox: no network, no home directory, GAMEDIR at /game
as an overlay. Everything the game writes lands in ~/game-sandboxes/NAME/.
CMD refers to the game at /game, not at its path on disk.

Display (default: gamescope's private Xwayland)
  --wayland             native Wayland; with --proton, Proton's winewayland
  --wayland-x11         Proton: native Wayland plus private X11
                        for launcher/helper processes (needs a patched runner)
  --x11-backend=BACKEND with --wayland-x11: gamescope (default) or satellite
  --x11-exe EXE         with --wayland-x11: an executable to put on X11;
                        empty uses only the runner's built-in selection
  --gamescope[=ARGS]    run inside gamescope, passing ARGS (quote them all)
  --host-x11            the host X server -- other X apps can be watched and
                        controlled; never for a game you do not trust
  --headless            no display at all

Runtimes
  --proton[=VER]        CMD is a Windows .exe, run with Proton: the newest
                        found, or VER by name or path ($PROTON_DIR wins)
  --mod-loaders         with --proton: load mod loaders the game ships
                        (BepInEx, MelonLoader, UE4SS, ASI loaders)
  --steam               with --proton: start it through Proton's steam.exe,
                        as Steam does, rather than as a non-Steam program
  --hide-tray           with --proton: hide Wine's window for tray icons
  --mkxp[=DIR]          RPG Maker XP/VX/VX Ace under mkxp-z; CMD optional
  --pgmmv[=DIR]         Pixel Game Maker MV under the Linux player; CMD optional
  --dotnet[=DIR]        the host's .NET runtime, for a .NET program that does
                        not bundle it
  --with-proton[=VER]   Proton at /proton, read-only, for a native program
                        that starts Wine itself

Access
  --net                 the internet, and only that: no LAN, nothing on this
                        machine, nothing incoming (needs pasta)
  --allow-lan LIST      with --net: these LAN addresses after all, e.g.
                        10.0.50.105:443,192.168.1.0/24 ([v6]:port, :80/tcp)
  --lan                 with --net: the whole LAN, still not this machine
  --mac-vendor          with --net: a network card address with your own
                        card's manufacturer prefix, the rest made up
  --hosts               a private /etc/hosts, the host's plus --add-host's
  --add-host "ADDR NAME..."  an entry in it (implies --hosts)
  --hosts-writable      the game may edit it too; kept in the capture folder
  --ro SRC DST          bind SRC in read-only at DST

Protections
  --require LIST        refuse to start unless these hold, on top of the saved
                        require=: landlock, scoped, private-display, limits,
                        audio, seccomp, or all

Other
  --name NAME           sandbox name, else derived from GAMEDIR
  --env K=V             set a variable inside; repeatable, applied last
  --mangohud            the MangoHud overlay (also: MANGOHUD=1)
  --hdr                 HDR for games that offer it (DXVK_HDR=1; gamescope's
                        --hdr-enabled); also turn it on in the desktop and game

Managing sandboxes
  --list                every sandbox: size, time played, last played, running
  --stop NAME           end a running sandbox and everything in it
  --stop-all            end every running sandbox
  --reset-install NAME  discard the game's changes to its install folder
                        (after updating it); settings, and anything in there
                        named like a save, are kept
  --delete NAME         delete a sandbox: saves, settings, Wine prefix
  --print-name GAMEDIR  the sandbox name a folder gets
  --list-proton         the Proton installs found, newest first
  --check               which protections hold on this machine, one line each,
                        and whether the saved requirements can be met
  -h, --help            this

Examples
  sandbox-game ~/Games/SomeRenpyGame /game/SomeRenpyGame.sh
  sandbox-game --proton ~/Games/SomeWindowsGame /game/game.exe
  sandbox-game --net --proton=GE-Proton10 ~/Games/Online /game/bin/client.exe
  sandbox-game --mkxp ~/Games/SomeVXAceGame
  sandbox-game --pgmmv ~/Games/SomePixelGameMakerGame

Read on the host: PROTON_DIR, MKXP_DIR, PGMMV_DIR, NWJS_DIR, DOTNET_ROOT, SANDBOX_TOOLS_DIR,
SANDBOX_SECCOMP=log, SANDBOX_SECCOMP_POLICY=allowlist, SANDBOX_GPU_CARD=1,
SANDBOX_SEPARATE_UID=1, SANDBOX_X11_TIMEOUT=SECONDS, MANGOHUD=1. Sound is playback only
once `install.sh --restrict-audio` has set that up.
Saved separate_uid, seccomp_policy and seccomp preferences override their
environment variables (per-game settings, then defaults).
More in the README.
EOF
}

# Shared by both spellings of --env, so "--env FOO" is rejected as loudly as
# "--env=FOO" instead of quietly setting FOO to itself.
add_env() {                           # reads $_e as KEY=VALUE
    [ "$_e" = "${_e#*=}" ] && { echo "--env wants KEY=VALUE, got '$_e'" >&2; exit 1; }
    ENV_ARGS+=( --setenv "${_e%%=*}" "${_e#*=}" )
}

# MHUD, not MANGOHUD: that name belongs to MangoHud's own env var, and writing
# to it here would switch the overlay off for anyone who exports MANGOHUD=1.
WAYLAND=0; NAME=""; EXTRA_RO=(); PROTON_SPEC=""; MKXP_SPEC=""; PGMMV_SPEC=""; MHUD=0; PRINT_NAME=0
GS=0; GS_ARGS=(); ENV_ARGS=(); HOST_X11=0; HEADLESS=0; NET=0; MODS=0; STEAM=0; HIDE_TRAY=0; MAC_VENDOR=0
WAYLAND_X11=0; X11_EXE=""; HDR=0; X11_BACKEND=gamescope; X11_BACKEND_SET=0; GS_SET=0
DOTNET_SPEC=""; WITH_PROTON_SPEC=""; LAN_ALLOW=(); LAN_ALL=0; HOSTS=0; HOSTS_RW=0; HOSTS_ADD=()
REQUIRE_CLI=""
[ "${MANGOHUD:-0}" = 1 ] && MHUD=1        # an inherited MANGOHUD=1 opts in too
while [ "$#" -gt 0 ]; do
    case "$1" in
        --wayland)   WAYLAND=1; shift ;;
        --wayland-x11) WAYLAND_X11=1; GS=1; shift ;;
        --x11-backend) [ -n "${2:-}" ] && [[ "$2" != -* ]] || {
                          echo "--x11-backend needs gamescope or satellite" >&2; exit 1; }
                      X11_BACKEND="$2"; X11_BACKEND_SET=1; shift 2 ;;
        --x11-backend=*) X11_BACKEND="${1#*=}"; X11_BACKEND_SET=1; shift ;;
        --x11-exe)   [ -n "${2:-}" ] && [[ "$2" != -* ]] || {
                         echo "--x11-exe needs an executable name (--x11-exe=VALUE for one starting with -)" >&2
                         exit 1; }
                     X11_EXE="$2"; shift 2 ;;
        --x11-exe=*) X11_EXE="${1#--x11-exe=}"; shift ;;
        --host-x11)  HOST_X11=1; shift ;;
        --headless)  HEADLESS=1; shift ;;
        --net)       NET=1; shift ;;
        --mangohud)  MHUD=1; shift ;;
        --hdr)       HDR=1; shift ;;
        --gamescope) GS=1; GS_SET=1; shift ;;
        --gamescope=*) GS=1; GS_SET=1; read -r -a GS_ARGS <<<"${1#--gamescope=}"; shift ;;
        --print-name) PRINT_NAME=1; shift ;;
        --list-proton) list_protons; exit 0 ;;
        -h|--help)   usage; exit 0 ;;
        --stop)      stop_sandboxes "${2:?--stop needs a sandbox name (or use --stop-all)}"; exit ;;
        --stop=*)    _n="${1#--stop=}"   # empty is --stop-all's job, never this one's
                     stop_sandboxes "${_n:?--stop needs a sandbox name (or use --stop-all)}"; exit ;;
        --stop-all)  stop_sandboxes ""; exit ;;
        --list)      list_sandboxes; exit ;;
        --check)     check_host; exit ;;
        --delete)    delete_sandbox "${2:?--delete needs a sandbox name}"; exit ;;
        --reset-install) reset_install "${2:?--reset-install needs a sandbox name}"; exit ;;
        --name)      NAME="$2"; shift 2 ;;
        --name=*)    NAME="${1#--name=}"; shift ;;
        --proton)    PROTON_SPEC="auto"; shift ;;
        --proton=*)  PROTON_SPEC="${1#--proton=}"; PROTON_SPEC="${PROTON_SPEC:-auto}"; shift ;;
        --mod-loaders) MODS=1; shift ;;
        --steam)     STEAM=1; shift ;;
        --hide-tray) HIDE_TRAY=1; shift ;;
        --mkxp)      MKXP_SPEC="auto"; shift ;;
        --mkxp=*)    MKXP_SPEC="${1#--mkxp=}"; MKXP_SPEC="${MKXP_SPEC:-auto}"; shift ;;
        --pgmmv)     PGMMV_SPEC="auto"; shift ;;
        --pgmmv=*)   PGMMV_SPEC="${1#--pgmmv=}"; PGMMV_SPEC="${PGMMV_SPEC:-auto}"; shift ;;
        --dotnet)    DOTNET_SPEC="auto"; shift ;;
        --dotnet=*)  DOTNET_SPEC="${1#--dotnet=}"; DOTNET_SPEC="${DOTNET_SPEC:-auto}"; shift ;;
        --with-proton) WITH_PROTON_SPEC="auto"; shift ;;
        --with-proton=*) WITH_PROTON_SPEC="${1#--with-proton=}"
                     WITH_PROTON_SPEC="${WITH_PROTON_SPEC:-auto}"; shift ;;
        --allow-lan) LAN_ALLOW+=( "${2?--allow-lan needs a list of addresses}" ); shift 2 ;;
        --allow-lan=*) LAN_ALLOW+=( "${1#--allow-lan=}" ); shift ;;
        --lan)       LAN_ALL=1; shift ;;
        --mac-vendor) MAC_VENDOR=1; shift ;;
        --hosts)     HOSTS=1; shift ;;
        --add-host)  HOSTS=1; HOSTS_ADD+=( "${2?--add-host needs \"ADDRESS NAME...\"}" ); shift 2 ;;
        --add-host=*) HOSTS=1; HOSTS_ADD+=( "${1#--add-host=}" ); shift ;;
        --hosts-writable) HOSTS=1; HOSTS_RW=1; shift ;;
        --ro)        EXTRA_RO+=( --ro-bind "$2" "$3" ); shift 3 ;;
        --require)   REQUIRE_CLI+="${2?--require needs a list} "; shift 2 ;;
        --require=*) REQUIRE_CLI+="${1#--require=} "; shift ;;
        --env)       _e="$2"; shift 2; add_env ;;
        --env=*)     _e="${1#--env=}"; shift; add_env ;;
        --)          shift; break ;;
        -*)          echo "unknown option: $1 (see sandbox-game --help)" >&2; exit 1 ;;
        *)           break ;;
    esac
done
case "$X11_BACKEND" in gamescope|satellite) ;; *)
    echo "--x11-backend must be gamescope or satellite" >&2; exit 1 ;; esac
[ "$X11_BACKEND_SET" = 0 ] || [ "$WAYLAND_X11" = 1 ] || {
    echo "--x11-backend needs --wayland-x11" >&2; exit 1; }
[ "$X11_BACKEND" != satellite ] || [ "$GS_SET" = 0 ] || {
    echo "--gamescope cannot be used with --x11-backend=satellite" >&2; exit 1; }
[ "$WAYLAND_X11" = 0 ] || [ -n "$PROTON_SPEC" ] || {
    echo "--wayland-x11 needs --proton and a runner with per-process graphics selection" >&2; exit 1; }
# Split display is private X11 with the desktop's Wayland for the game, set
# up in "landlock" alone. WAYLAND stays 0: everything --wayland asks of
# gamescope (its own Wayland socket, Proton's Wayland setting) is not wanted.
[ "$WAYLAND_X11" = 0 ] || WAYLAND=0
[ -z "$X11_EXE" ] || [ "$WAYLAND_X11" = 1 ] || {
    echo "--x11-exe needs --wayland-x11" >&2; exit 1; }
[[ "$X11_EXE" != *$'\n'* && "$X11_EXE" != *$'\r'* ]] || {
    echo "--x11-exe must be one executable name or path fragment" >&2; exit 1; }
[ -z "$PROTON_SPEC" ] || [ -z "$MKXP_SPEC" ] || {
    echo "--proton and --mkxp are mutually exclusive" >&2; exit 1; }
