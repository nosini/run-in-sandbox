import ipaddress, json, re, sys
LAN_ENTRY = re.compile(r"(?:\[(?P<v6>[0-9a-f:.]+(?:/\d+)?)\]|(?P<v4>[0-9.]+(?:/\d+)?)"
                       r"|(?P<bare6>[0-9a-f]*:[0-9a-f:.]*(?:/\d+)?))"
                       r"(?::(?P<port>\d+(?:-\d+)?))?(?:/(?P<proto>tcp|udp))?", re.I)
HOST_NAME = re.compile(r"[a-z0-9_](?:[a-z0-9_.-]*[a-z0-9_])?", re.I)
kind, texts = sys.argv[1], sys.argv[2:]
try:
    if kind == "lan":
        rules = []
        for word in re.split(r"[\s,]+", " ".join(texts)):
            if not word:
                continue
            m = LAN_ENTRY.fullmatch(word)
            try:
                net = ipaddress.ip_network(m["v6"] or m["v4"] or m["bare6"], strict=False)
            except (TypeError, ValueError):
                raise ValueError(f"not an address or network: {word}") from None
            if net.is_loopback or net.is_multicast or net.network_address.is_unspecified:
                raise ValueError(f"not a LAN address: {word}")
            if m["port"]:
                low, _, high = m["port"].partition("-")
                if not 0 < int(low) <= int(high or low) <= 65535:
                    raise ValueError(f"no such port: {word}")
            rules.append([str(net), (m["proto"] or "").lower(), m["port"] or ""])
        json.dump(rules, sys.stdout)
    else:
        for line in re.split(r"[,\n]", "\n".join(texts)):
            words = line.split()
            if not words:
                continue
            try:
                address = ipaddress.ip_address(words[0])
            except ValueError:
                raise ValueError(f"not an address: {words[0]}") from None
            if len(words) < 2:
                raise ValueError(f"no host names after {words[0]}")
            for name in words[1:]:
                if not HOST_NAME.fullmatch(name):
                    raise ValueError(f"not a host name: {name}")
            print(address, *words[1:])
except ValueError as error:
    sys.exit(f"{'--allow-lan' if kind == 'lan' else '--add-host'}: {error}")
