# shellcheck shell=bash
# Sourced by the Nautilus scripts -- not executable, and deliberately not in the
# scripts directory, where Nautilus would list it as a menu entry of its own.
#
#   install -Dm644 sandbox-game-lib ~/.local/lib/sandbox-game/sandbox-game-lib
#
# Everything here has to give the same answer in the launcher and in the
# preferences dialog. Keying a game one way while launching it another means
# saved settings quietly never apply, so the shared parts live in one file.

CFGDIR="${XDG_CONFIG_HOME:-$HOME/.config}/sandbox-game"

# All file-manager dialogs use one host-side GTK helper. An explicit override
# also lets tests record requests without needing a desktop session.
dialog() {
    local helper="${SANDBOX_DIALOG:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/sandbox-game-dialog}"
    [ -x "$helper" ] || helper="$HOME/.local/lib/sandbox-game/sandbox-game-dialog"
    [ -x "$helper" ] || { echo "sandbox-game-dialog not found; run install.sh" >&2; return 2; }
    "$helper" "$@"
}

# One key out of one file. Anything writing a settings file wants this rather
# than cfg_get: cfg_get answers with the merged view, and writing that back into
# a single file copies values across scopes in whichever direction the save
# happens to go. Read rather than sourced -- these files are edited by hand as
# often as by the dialog, and a stray line should not run as code.
# A key that is there with nothing after it is a value, the empty one: that
# is how a game's own file says "none" where the defaults say something, as
# with gamescope_args. Only a key that is not there at all falls through.
file_get() {                                   # $1 = file, $2 = key
    local v
    [ -f "$1" ] && grep -q "^[[:space:]]*$2[[:space:]]*=" "$1" || return 1
    v="$(sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | tail -n1)"
    # Trailing blanks survive that substitution, and a file saved with CRLF
    # leaves a \r that would make "1" compare unequal to 1 -- invisibly.
    v="${v%"${v##*[![:space:]]}"}"
    printf '%s\n' "$v"
}

# Per-game settings win over the defaults, and both over the built-in fallback.
cfg_get() {                                    # $1 = key, $2 = fallback
    local f
    for f in "$CFGDIR/games/$NAME" "$CFGDIR/defaults"; do
        file_get "$f" "$1" && return
    done
    printf '%s\n' "$2"
}

is_nwapp() { [ -e "$1/package.json" ] || [ -e "$1/index.html" ]; }

# Native exports can be standalone ELF programs (for example .x86_64 or
# extensionless launchers), with or without their executable bit preserved.
# Inspect only headers, never run a program to identify it. Shared libraries
# normally have no entry point and must not become launcher choices.
native_launchers() {
    python3 - "$1" <<'PY'
import os, sys
from pathlib import Path

scripts, binaries = [], []
root = Path(sys.argv[1])
try:
    with os.scandir(root) as entries:
        for entry in entries:
            try:
                if not entry.is_file(follow_symlinks=False) or "\n" in entry.name:
                    continue
                if entry.name.endswith(".sh"):
                    scripts.append(entry.path)
                    continue
                if ".so" in Path(entry.name).suffixes:
                    continue
                fd = os.open(entry.path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, "rb") as stream:
                    header = stream.read(64)
                if len(header) < 52 or header[:4] != b"\x7fELF" or header[4] not in (1, 2) \
                        or header[5] not in (1, 2) or header[6] != 1:
                    continue
                width = 4 if header[4] == 1 else 8
                if width == 8 and len(header) < 64:
                    continue
                order = "little" if header[5] == 1 else "big"
                kind = int.from_bytes(header[16:18], order)
                address = int.from_bytes(header[24:24 + width], order)
                if kind in (2, 3) and address:
                    binaries.append(entry.path)
            except OSError:
                continue
except OSError:
    pass
for path in sorted(scripts or binaries):
    print(path)
PY
}

# Map a Nautilus selection onto the game. RPG Maker MV/MZ is the awkward one:
# the app lives in "www" but the game -- and so the sandbox, and the settings --
# is the folder above it, and either may be what got right-clicked.
# Sets R_APPDIR (the NW.js app, empty when it is not one) and R_GAMEDIR.
# shellcheck disable=SC2034  # both are outputs, read by whoever sourced this
resolve_selection() {                          # $1 = selected path
    local sel="$1"
    R_APPDIR=""; R_GAMEDIR=""
    if [ -d "$sel" ]; then
        if   is_nwapp "$sel";     then R_APPDIR="${sel%/}"
        elif is_nwapp "$sel/www"; then R_APPDIR="${sel%/}/www"
        fi
    else
        case "$(basename "$sel")" in
            index.html|package.json) R_APPDIR="$(dirname "$sel")" ;;
        esac
    fi
    if [ -n "$R_APPDIR" ] && [ "$(basename "$R_APPDIR")" = www ]; then
        R_GAMEDIR="$(dirname "$R_APPDIR")"
    elif [ -n "$R_APPDIR" ]; then
        R_GAMEDIR="$R_APPDIR"
    elif [ -d "$sel" ]; then
        R_GAMEDIR="${sel%/}"
    else
        R_GAMEDIR="$(dirname "$sel")"
    fi
    # PGMMV's project lives in data/, sometimes below Resources/. Selecting
    # that folder or project.json should use the same sandbox as player.exe.
    local part base
    for part in data resources; do
        base="${R_GAMEDIR##*/}"
        if [ "${base,,}" = "$part" ] && is_pgmmv "$(dirname "$R_GAMEDIR")"; then
            R_GAMEDIR="$(dirname "$R_GAMEDIR")"
        fi
    done
}

# Both exported (including encrypted) games and editor projects have this
# file. Match case as the Linux player does, without parsing encrypted JSON.
is_pgmmv() {
    find "$1" -maxdepth 3 -type f -iname project.json -printf '%P\n' 2>/dev/null \
        | grep -iEx 'data/project[.]json|resources/data/project[.]json' >/dev/null
}

# A .NET program that needs a .NET runtime installed: its NAME.runtimeconfig.json
# names a shared framework, and NAME beside it is the Linux starter (an ELF
# file). Self-contained programs list "includedFrameworks" instead and bring
# their own; a Windows .NET program has NAME.exe, which a Linux runtime cannot
# start anyway. Only these get the preference that hands them the runtime.
is_dotnet() {                                  # $1 = game dir
    local f
    while IFS= read -r -d '' f; do
        [ -f "${f%.runtimeconfig.json}" ] \
            && cmp -s -n 4 "${f%.runtimeconfig.json}" <(printf '\177ELF') \
            && grep -qE '"frameworks?"[[:space:]]*:' "$f" && return 0
    done < <(find "$1" -maxdepth 3 -type f -name '*.runtimeconfig.json' -print0 2>/dev/null)
    return 1
}

has_windows_exe() {
    [ -n "$(find "$1" -maxdepth 5 -type f -iname '*.exe' -print -quit 2>/dev/null)" ]
}

# RPG Maker XP / VX / VX Ace, i.e. the RGSS engines mkxp-z reimplements. Game.ini
# names the runtime it wants; the data files and encrypted archives catch dumps
# that arrived without one. MV/MZ never match -- those are the NW.js case.
is_rgss() {
    [ -f "$1/Game.ini" ] &&
        grep -qiE '^[[:space:]]*Library[[:space:]]*=[[:space:]]*RGSS' "$1/Game.ini" && return 0
    [ -n "$(find "$1" -maxdepth 2 \( -iname '*.rvdata2' -o -iname '*.rvdata' \
            -o -iname '*.rxdata' -o -iname 'Game.rgss*' \) -print -quit 2>/dev/null)" ]
}

# What "Sandbox game" will run a selection with, in the order it goes by: an
# NW.js app, a native launcher, a PGMMV or RGSS game, a Windows .exe under
# Proton. For the preferences, which offer only what that engine can do.
# Sets R_ENGINE to nwjs, native, pgmmv, mkxp, proton, or empty when nothing is found.
# shellcheck disable=SC2034  # an output, read by whoever sourced this
game_engine() {                                # $1 = selection, $2 = optional launch_with override
    R_ENGINE=""
    if [ "${2:-$(cfg_get launch_with auto)}" = proton ]; then
        R_ENGINE=proton
        return
    fi
    if [ -n "$R_APPDIR" ]; then
        R_ENGINE=nwjs
    elif [ -d "$1" ]; then
        if [ -n "$(native_launchers "$R_GAMEDIR")" ]; then
            R_ENGINE=native
        elif is_pgmmv "$R_GAMEDIR"; then
            R_ENGINE=pgmmv
        elif is_rgss "$R_GAMEDIR"; then
            R_ENGINE=mkxp
        elif has_windows_exe "$R_GAMEDIR"; then
            R_ENGINE=proton
        fi
    else
        case "${1,,}" in
            *.exe) if is_pgmmv "$R_GAMEDIR"; then R_ENGINE=pgmmv
                   elif is_rgss "$R_GAMEDIR"; then R_ENGINE=mkxp; else R_ENGINE=proton; fi ;;
            *.json) if is_pgmmv "$R_GAMEDIR"; then R_ENGINE=pgmmv; else R_ENGINE=native; fi ;;
            *)     R_ENGINE=native ;;
        esac
    fi
}

# Ren'Py carries its own SDL, built into its lib/*linux-ARCH/ binaries, and
# before some 8.x release built it without the Wayland driver: forced onto
# Wayland, such a build dies at its GL test with "wayland not available".
# True where the X11 driver is there and the Wayland one is not. Only when
# both driver names can be looked for: a layout this does not know is false.
renpy_without_wayland() {                      # $1 = game dir
    [ -d "$1/renpy" ] || return 1
    local libs=( "$1"/lib/*linux-"$(uname -m)" ) sos
    [ -d "${libs[0]}" ] || return 1
    # The shared objects only (librenpython.so, or a separate libSDL2): the
    # rest need not be read on every launch.
    # -H: the arch folder itself may be a symlink.
    mapfile -t sos < <(find -H "${libs[@]}" -maxdepth 2 -type f -name '*.so*' 2>/dev/null)
    [ "${#sos[@]}" -gt 0 ] || return 1
    grep -a -q -F "SDL X11 video driver" "${sos[@]}" 2>/dev/null \
        && ! grep -a -q -F "SDL Wayland video driver" "${sos[@]}" 2>/dev/null
}

# The sandbox-game options the saved preferences stand for. The launcher and
# the desktop manager both build their command lines here, so one preference
# never means two things. In: NAME, GAMEDIR, APPDIR (NW.js app or empty),
# PROTON, MKXP, PGMMV (1 for the runtime chosen), ALLOW_MANGOHUD. Out: FLAG;
# WL=1 when native Wayland was chosen; DOTNET_APP=1 for a .NET program.
# shellcheck disable=SC2034  # outputs, read by whoever sourced this
pref_flags() {
    local host_x11 x11_exe lan_allow e wp ga pv
    local -a host_entries cfg_env
    FLAG=( --name "$NAME" )
    host_x11="$(cfg_get host_x11 0)"
    [ "$host_x11" = 1 ] && FLAG+=( --host-x11 )
    WL=0
    [ "$host_x11" != 1 ] && [ "$(cfg_get wayland 0)" = 1 ] && WL=1
    if [ "$WL" = 1 ] && [ "$PROTON" = 1 ] && [ "$(cfg_get wayland_x11 0)" = 1 ]; then
        FLAG+=( --wayland-x11 )
        x11_exe="$(cfg_get x11_exe '')"
        [ -z "$x11_exe" ] || FLAG+=( "--x11-exe=$x11_exe" )
    elif [ "$WL" = 1 ]; then
        FLAG+=( --wayland )
    fi
    [ "$ALLOW_MANGOHUD" = 1 ] && [ "$(cfg_get mangohud 0)" = 1 ] && FLAG+=( --mangohud )
    if [ "$(cfg_get net 0)" = 1 ]; then
        FLAG+=( --net )
        if [ "$(cfg_get lan 0)" = 1 ]; then
            FLAG+=( --lan )
        else
            lan_allow="$(cfg_get lan_allow "")"
            [ -z "$lan_allow" ] || FLAG+=( "--allow-lan=$lan_allow" )
        fi
    fi
    # hosts=ADDR NAME..., ADDR NAME... -- one --add-host each.
    if [ "$(cfg_get private_hosts 0)" = 1 ]; then
        FLAG+=( --hosts )
        IFS=, read -r -a host_entries <<<"$(cfg_get hosts "")"
        for e in ${host_entries[@]+"${host_entries[@]}"}; do
            e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
            [ -z "$e" ] || FLAG+=( "--add-host=$e" )
        done
        [ "$(cfg_get hosts_writable 0)" = 1 ] && FLAG+=( --hosts-writable )
    fi
    # Native programs only. The .NET runtime is opt-in, and only for a program
    # recognised as needing it.
    DOTNET_APP=0
    if [ -z "$APPDIR" ] && [ "$PROTON" = 0 ] && [ "$MKXP" = 0 ] && [ "$PGMMV" = 0 ]; then
        is_dotnet "$GAMEDIR" && DOTNET_APP=1
        [ "$DOTNET_APP" = 1 ] && [ "$(cfg_get dotnet 0)" = 1 ] && FLAG+=( --dotnet )
        # Proton, for one that starts Wine itself.
        wp="$(cfg_get with_proton "")"
        if [ "$wp" = auto ]; then FLAG+=( --with-proton ); elif [ -n "$wp" ]; then FLAG+=( "--with-proton=$wp" ); fi
    fi
    # The X11 choice is stored as gamescope=0, wayland=0: X11 always runs in
    # gamescope, so its resolution and fullscreen apply there too.
    if [ "$host_x11" != 1 ] && { [ "$(cfg_get gamescope 0)" = 1 ] || [ "$WL" = 0 ]; }; then
        # Empty means gamescope's own defaults.
        ga="$(cfg_get gamescope_args "")"
        if [ -n "$ga" ]; then FLAG+=( "--gamescope=$ga" ); else FLAG+=( --gamescope ); fi
    fi
    # env=K=V K=V ... -- a game launched from the file manager inherits its
    # environment, not a shell's, so anything the game needs has to be recorded.
    read -r -a cfg_env <<<"$(cfg_get env "")"
    for e in ${cfg_env[@]+"${cfg_env[@]}"}; do FLAG+=( "--env=$e" ); done
    if [ "$PROTON" = 1 ] && [ "$MKXP" = 0 ] && [ "$PGMMV" = 0 ]; then
        # An exported PROTON_VER still wins, matching NWJS_DIR/MKXP_DIR/PROTON_DIR.
        pv="${PROTON_VER:-$(cfg_get proton auto)}"
        if [ "$pv" = auto ]; then FLAG+=( --proton ); else FLAG+=( "--proton=$pv" ); fi
        [ "$(cfg_get mod_loaders 0)" = 1 ] && FLAG+=( --mod-loaders )
    fi
}

# Write one preferences window's answer ($1, JSON) for NAME: into its own
# file, or the defaults, or clear its file. Shared by the Nautilus window and
# the desktop manager. Says why on stderr and fails when nothing was saved.
# A subshell, so its working variables stay its own.
prefs_save() (
    out="$1"
    # Only fields belonging to the selected engine are returned. Hidden fields
    # come from the file being written, so they never copy across config scopes.
    parsed="$(python3 - "$out" <<'PY'
import json, re, sys
values = json.loads(sys.argv[1])
keys = {"scope", "launch_with", "wayland", "host_x11", "gamescope", "mangohud",
        "wayland_x11", "x11_exe",
        "net", "proton", "mod_loaders", "casefold", "webgl",
        "gamescope_resolution", "gamescope_fullscreen", "dotnet", "with_proton",
        "lan", "lan_allow", "private_hosts", "hosts", "hosts_writable", "env"}
assert isinstance(values, dict) and values.get("scope") in {"game", "all", "clear"}
assert all(k in keys and isinstance(v, str) and not any(c in v for c in "\n\r\t\0")
           for k, v in values.items())
if "gamescope_resolution" in values or "gamescope_fullscreen" in values:
    assert "gamescope_resolution" in values and "gamescope_fullscreen" in values
    assert not values["gamescope_resolution"] or re.fullmatch(r"[0-9]+x[0-9]+", values["gamescope_resolution"])
    assert values["gamescope_fullscreen"] in {"0", "1"}
# The manager's editor; the Nautilus window keeps whatever the file has.
assert all(re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*=\S*", word)
           for word in values.get("env", "").split(" ") if word)
for key, value in values.items():
    print(key + "\t" + value)
PY
)" || { echo "Invalid preferences response; no settings were saved." >&2; exit 1; }
    declare -A RESULT
    while IFS=$'\t' read -r key value; do RESULT["$key"]="$value"; done <<<"$parsed"
    # The window checks these as they are typed; sandbox-game has the last word.
    check=()
    [ -z "${RESULT[lan_allow]:-}" ] || check+=( --net "--allow-lan=${RESULT[lan_allow]}" )
    [ -z "${RESULT[hosts]:-}" ] || check+=( "--add-host=${RESULT[hosts]}" )
    if [ "${#check[@]}" -gt 0 ] && ! err="$("$SANDBOX" "${check[@]}" --name "$NAME" --print-name / 2>&1 >/dev/null)"; then
        printf 'Not saved:\n%s\n' "$err" >&2; exit 1
    fi
    if [ "${RESULT[scope]}" = clear ]; then
        rm -f -- "$CFGDIR/games/$NAME" || exit 1
        exit 0
    fi
    [ "${RESULT[scope]}" = all ] && TARGET="$CFGDIR/defaults" || TARGET="$CFGDIR/games/$NAME"
    kept() { file_get "$TARGET" "$1" || printf '%s\n' "$2"; }
    chosen() {
        if [ "${RESULT[$1]+set}" ]; then printf '%s\n' "${RESULT[$1]}"
        else kept "$1" "$2"; fi
    }
    # Shown in the window, or already in the file. A hidden key the file lacks
    # is not written: a game's file would then override the defaults with the
    # built-in value, from then on, for a setting the user never saw.
    saved_key() { [ "${RESULT[$1]+set}" ] || file_get "$TARGET" "$1" >/dev/null; }

    # Parse the destination's arguments, then replace only the exposed controls.
    # A game without its own arguments inherits the defaults; saving defaults
    # never takes hidden options from the selected game's merged view.
    ga_parse() {
        local words i=0
        GA_WIDTH=""; GA_HEIGHT=""; GA_FULL=0; GA_REST=()
        read -r -a words <<<"$1"
        while [ "$i" -lt "${#words[@]}" ]; do
            case "${words[$i]}" in
                -W|--output-width) GA_WIDTH="${words[$((i+1))]:-}"; i=$((i+2)) ;;
                -H|--output-height) GA_HEIGHT="${words[$((i+1))]:-}"; i=$((i+2)) ;;
                -f|--fullscreen) GA_FULL=1; i=$((i+1)) ;;
                *) GA_REST+=( "${words[$i]}" ); i=$((i+1)) ;;
            esac
        done
    }
    ga_join() {
        local out=()
        [ -z "$GA_WIDTH" ] || [ -z "$GA_HEIGHT" ] || out+=( -W "$GA_WIDTH" -H "$GA_HEIGHT" )
        [ "$GA_FULL" != 1 ] || out+=( -f )
        out+=( "${GA_REST[@]}" )
        printf '%s\n' "${out[*]}"
    }
    ga_normalise() { ga_parse "$1"; ga_join; }
    GA_OWN=0
    if GA_OUT="$(file_get "$TARGET" gamescope_args)"; then GA_OWN=1; fi
    if [ "${RESULT[gamescope_resolution]+set}" ]; then
        if [ "$TARGET" != "$CFGDIR/defaults" ] && [ "$GA_OWN" = 0 ]; then
            GA_OUT="$(file_get "$CFGDIR/defaults" gamescope_args || true)"
        fi
        ga_parse "$GA_OUT"
        GA_WIDTH=""; GA_HEIGHT=""
        if [[ "${RESULT[gamescope_resolution]}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
            GA_WIDTH="${BASH_REMATCH[1]}"; GA_HEIGHT="${BASH_REMATCH[2]}"
        fi
        GA_FULL="${RESULT[gamescope_fullscreen]}"
        GA_OUT="$(ga_join)"
        if [ "$TARGET" != "$CFGDIR/defaults" ]; then
            GA_DEFAULT="$(file_get "$CFGDIR/defaults" gamescope_args || true)"
            [ "$(ga_normalise "$GA_OUT")" = "$(ga_normalise "$GA_DEFAULT")" ] || GA_OWN=1
        fi
    fi

    bools="wayland wayland_x11 host_x11 mangohud gamescope net launch_with mod_loaders casefold webgl proton
           dotnet lan private_hosts hosts_writable"
    optional="with_proton lan_allow hosts x11_exe"
    mkdir -p "$(dirname "$TARGET")" || { echo "Cannot create $(dirname "$TARGET")" >&2; exit 1; }
    {   echo "# sandbox-game preferences -- edit by hand or via the Nautilus script"
        for key in $bools; do
            saved_key "$key" || continue
            case "$key" in launch_with|webgl|proton) fallback=auto ;; casefold) fallback=1 ;; *) fallback=0 ;; esac
            printf '%s=%s\n' "$key" "$(chosen "$key" "$fallback")"
        done
        if [ "$TARGET" = "$CFGDIR/defaults" ]; then
            [ -z "$GA_OUT" ] || printf 'gamescope_args=%s\n' "$GA_OUT"
        elif [ "$GA_OWN" = 1 ]; then printf 'gamescope_args=%s\n' "$GA_OUT"; fi
        # Values that may be empty: written when there is one, or when the
        # defaults have one that this game's empty value turns off.
        for key in $optional; do
            saved_key "$key" || continue
            value="$(chosen "$key" '')"
            if [ -n "$value" ] || { [ "$TARGET" != "$CFGDIR/defaults" ] \
                    && [ -n "$(file_get "$CFGDIR/defaults" "$key" || true)" ]; }; then
                printf '%s=%s\n' "$key" "$value"
            fi
        done
        # The manager edits this file's own variables; an empty list leaves a
        # game with the defaults' ones, unless the file already said "none".
        if [ "${RESULT[env]+set}" ]; then
            env_out="${RESULT[env]}"
            if [ -n "$env_out" ] || { v="$(file_get "$TARGET" env)" && [ -z "$v" ]; }; then
                printf 'env=%s\n' "$env_out"
            fi
        else
            env_out="$(kept env '')"
            [ -z "$env_out" ] || printf 'env=%s\n' "$env_out"
        fi
        # Keys this window does not know -- hand-written, or newer -- stay.
        if [ -f "$TARGET" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                [[ "$line" == *=* ]] || continue
                key="${line%%=*}"; key="${key//[[:space:]]/}"
                [[ "$key" =~ ^[a-z][a-z_0-9]*$ ]] || continue
                [[ " $bools $optional gamescope_args env " == *[[:space:]]"$key"[[:space:]]* ]] && continue
                printf '%s\n' "$line"
            done < "$TARGET"
        fi
    } > "$TARGET.tmp" || { echo "Cannot write $TARGET" >&2; exit 1; }
    mv -- "$TARGET.tmp" "$TARGET" || { echo "Cannot save $TARGET" >&2; exit 1; }
)
