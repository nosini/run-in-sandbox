# shellcheck shell=bash
# Sourced by the Nautilus scripts -- not executable, and deliberately not in the
# scripts directory, where Nautilus would list it as a menu entry of its own.
#
#   install -Dm644 sandbox-game-lib ~/.local/lib/sandbox-game/sandbox-game-lib
#
# Everything here has to give the same answer in the launcher and in the
# preferences dialog. Keying a game one way while launching it another means
# saved settings quietly never apply, so the shared parts live in one file.

CFGDIR="${XDG_CONFIG_HOME:-$HOME/.config}/sandbox-game"

# All file-manager dialogs use one host-side GTK helper. An explicit override
# also lets tests record requests without needing a desktop session.
dialog() {
    local helper="${SANDBOX_DIALOG:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")/sandbox-game-dialog}"
    [ -x "$helper" ] || helper="$HOME/.local/lib/sandbox-game/sandbox-game-dialog"
    [ -x "$helper" ] || { echo "sandbox-game-dialog not found; run install.sh" >&2; return 2; }
    "$helper" "$@"
}

# One key out of one file. Anything writing a settings file wants this rather
# than cfg_get: cfg_get answers with the merged view, and writing that back into
# a single file copies values across scopes in whichever direction the save
# happens to go. Read rather than sourced -- these files are edited by hand as
# often as by the dialog, and a stray line should not run as code.
# A key that is there with nothing after it is a value, the empty one: that
# is how a game's own file says "none" where the defaults say something, as
# with gamescope_args. Only a key that is not there at all falls through.
file_get() {                                   # $1 = file, $2 = key
    local v
    [ -f "$1" ] && grep -q "^[[:space:]]*$2[[:space:]]*=" "$1" || return 1
    v="$(sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | tail -n1)"
    # Trailing blanks survive that substitution, and a file saved with CRLF
    # leaves a \r that would make "1" compare unequal to 1 -- invisibly.
    v="${v%"${v##*[![:space:]]}"}"
    printf '%s\n' "$v"
}

# Per-game settings win over the defaults, and both over the built-in fallback.
cfg_get() {                                    # $1 = key, $2 = fallback
    local f
    for f in "$CFGDIR/games/$NAME" "$CFGDIR/defaults"; do
        file_get "$f" "$1" && return
    done
    printf '%s\n' "$2"
}

# Host-side protection choices apply even to direct CLI launches: per-game
# settings, then defaults, then the environment. An empty value uses the latter.
# A subshell caller (such as --check) can apply another game's choices safely.
SECURITY_PREF_KEYS="separate_uid seccomp_policy seccomp"
security_prefs() {
    local key value var
    for key in $SECURITY_PREF_KEYS; do
        value="$(cfg_get "$key" '')"
        [ -n "$value" ] || continue
        case "$key:$value" in
            separate_uid:0|separate_uid:1|separate_uid:systemd) var=SANDBOX_SEPARATE_UID ;;
            seccomp_policy:denylist|seccomp_policy:allowlist) var=SANDBOX_SECCOMP_POLICY ;;
            seccomp:enforce|seccomp:log) var=SANDBOX_SECCOMP ;;
            *) echo "sandbox-game: invalid $key=$value preference for ${NAME:-defaults}" >&2; return 1 ;;
        esac
        export "$var=$value"
    done
}

# wayland_x11 (split display) refines the display that wayland, gamescope and
# host_x11 choose, so it comes from the first file that sets any of them: a
# game whose own file chose plain Wayland, saved before split display existed,
# must not take it from the defaults.
cfg_wayland_x11() {
    local f k
    for f in "$CFGDIR/games/$NAME" "$CFGDIR/defaults"; do
        for k in wayland_x11 wayland gamescope host_x11; do
            file_get "$f" "$k" >/dev/null || continue
            file_get "$f" wayland_x11 || printf '0\n'
            return
        done
    done
    printf '0\n'
}

# Protections a game can require (require= in its preferences, --require):
# the launch is refused when one cannot be had, where it would otherwise go on
# with a warning. Guarantees, not features: each says what the game cannot do.
#   landlock         Landlock holds the game to its mounts
#   scoped           it cannot signal, or reach abstract sockets of, anything
#                    outside its own Landlock domain (Landlock ABI 6)
#   private-display  it cannot reach the desktop's display server: a private
#                    one, and Landlock that can keep the game off other sockets
#   limits           memory, CPU and task limits are in force
#   audio            sound is playback only, or there is none
#   seccomp          the syscall filter refuses, rather than logs
REQUIREMENTS="landlock scoped private-display limits audio seccomp"

# A list of them -- commas or blanks, "all" for all -- in R_REQUIRE, space
# separated and in the order above. Fails, naming it, on one it does not know.
# shellcheck disable=SC2034  # an output, read by whoever sourced this
parse_requirements() {                         # $1 = list
    local word r out="" seen=" "
    local -a words
    read -r -a words <<<"${1//,/ }"
    for word in ${words[@]+"${words[@]}"}; do
        if [ "$word" = all ]; then seen=" $REQUIREMENTS "; continue; fi
        [[ " $REQUIREMENTS " == *" $word "* ]] || {
            echo "unknown protection requirement '$word' (known: $REQUIREMENTS, all)" >&2; return 1; }
        seen+="$word "
    done
    for r in $REQUIREMENTS; do [[ "$seen" != *" $r "* ]] || out+="$r "; done
    R_REQUIRE="${out% }"
}

# Nicer sandbox names for directories whose basename is ugly. Key = on-disk
# basename. Here rather than in sandbox-game, so the manager, matching game
# folders to sandboxes, names them exactly as sandbox-game does.
declare -gA NAME_MAP=(
    # ["Doki Doki Literature Club"]="ddlc"
    # ["NIKKE"]="nikke"
)

# The sandbox name for game dir $1, in R_NAME: no subshell, as the manager
# names whole folder trees at a time (derive_names).
# shellcheck disable=SC2034  # an output, read by whoever sourced this
derive_name() {
    local base="${1%/}"
    base="${base##*/}"
    if [ -n "$base" ] && [ -n "${NAME_MAP[$base]:-}" ]; then R_NAME="${NAME_MAP[$base]}"; return; fi
    base="${base,,}"
    base="${base//[^a-z0-9._-]/-}"
    while [[ "$base" == *--* ]]; do base="${base//--/-}"; done
    base="${base#-}"; base="${base%-}"
    [ "$base" != .locks ] || base=locks   # where sandbox-game keeps its locks
    R_NAME="${base:-game}"
}

# derive_name for each NUL-terminated folder on stdin, NUL-terminated, in order.
derive_names() {
    local dir
    while IFS= read -r -d '' dir; do derive_name "$dir"; printf '%s\0' "$R_NAME"; done
}

is_nwapp() { [ -e "$1/package.json" ] || [ -e "$1/index.html" ]; }

# Programs among the files given, for this machine: ELF executables or PIE
# programs for its architecture, going by their headers alone, never by
# running them. Shared libraries have no entry point and do not count; nor do
# symbolic links. With --compat first, 32-bit x86 ones on x86_64 instead: for
# when nothing 64-bit is there. Prints "SIZE<TAB>PATH" for each, as
# rank_launchers takes them.
elf_programs() {
    [ "$#" -gt 0 ] || return 0
    python3 - "$@" <<'PY'
import os, sys
MACHINES = {"x86_64": 62, "aarch64": 183, "riscv64": 243, "ppc64le": 21, "i686": 3, "i386": 3}
host = MACHINES.get(os.uname().machine)
paths = sys.argv[1:]
if paths[0] == "--compat":
    paths, host = paths[1:], 3 if host == 62 else None
found = []
for path in paths:
    if "\n" in path or "\t" in path:
        continue
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            if not os.path.isfile(f"/proc/self/fd/{stream.fileno()}"):
                continue
            size = os.fstat(stream.fileno()).st_size
            header = stream.read(64)
    except OSError:
        continue
    if len(header) < 52 or header[:4] != b"\x7fELF" or header[4] not in (1, 2) \
            or header[5] not in (1, 2) or header[6] != 1:
        continue
    width = 4 if header[4] == 1 else 8
    if width == 8 and len(header) < 64:
        continue
    order = "little" if header[5] == 1 else "big"
    kind = int.from_bytes(header[16:18], order)
    machine = int.from_bytes(header[18:20], order)
    if kind not in (2, 3) or not int.from_bytes(header[24:24 + width], order):
        continue
    if host is not None and machine == host:
        found.append(f"{size}\t{path}")
print("\n".join(found))
PY
}

# Best guess first, from "SIZE<TAB>PATH" lines on stdin. Names matching JUNK,
# an extended regex, only when nothing else is left (with $3 = strict, never);
# then a file name echoing the folder's, then the biggest -- the real program
# is rarely the small one. awk keeps the folder name literal, so a game called
# "S.T.A.L.K.E.R." is not read as a regex.
rank_launchers() {                             # $1 = dir, $2 = junk, $3 = strict
    local dir="$1" list keep
    list="$(grep . || true)"
    keep="$(grep -Eiv "/[^/]*(${2})[^/]*$" <<<"$list" || true)"
    [ -n "$keep" ] || [ "${3:-}" = strict ] || keep="$list"
    [ -n "$keep" ] || return 0
    awk -F'\t' -v b="${dir##*/}" '
        BEGIN { b = tolower(b) }
        { n = $2; sub(/.*\//, "", n)
          print (index(tolower(n), b) ? 0 : 1) "\t" $0 }' <<<"$keep" \
        | sort -t"$(printf '\t')" -k1,1n -k2,2rn | cut -f3
}

# Windows games ship a heap of .exe beside the real one; drop the usual
# installers and helpers, but only while something else is left to run.
EXE_JUNK='unins|install|setup|vcredist|dxsetup|dxwebsetup|directx|oalinst|dotnet|redist|crashhandler|crashreport|crashsender|touchup|nwjc|notification_helper|python'
# And Linux ones: .NET's crash dumper, Chromium/CEF helpers, Unity's crash
# handler and debug symbol files. Never offered on their own.
NATIVE_JUNK='createdump|crashpad|chrome-sandbox|chrome_sandbox|crashhandler|crashreport|\.debug$|uninstall'

find_exes() {                                  # $1 = dir -> best guess first
    local dir="$1" d list="" keep=""
    # Top level first, then deeper -- but only stopping at a level with a
    # candidate that is not junk: an uninstaller alone at the top, with the
    # game in bin/, would otherwise be the one picked, and run.
    for d in 1 5; do
        list="$(find "$dir" -maxdepth "$d" -type f -iname '*.exe' -printf '%s\t%p\n' 2>/dev/null)"
        keep="$(grep -Eiv "/[^/]*(${EXE_JUNK})[^/]*$" <<<"$list" || true)"
        [ -n "$keep" ] && break
    done
    rank_launchers "$dir" "$EXE_JUNK" <<<"$list"
}

# A native game's .sh launchers, at the top of its folder.
native_scripts() {                             # $1 = dir
    find "$1" -maxdepth 1 -type f -name '*.sh' 2>/dev/null | sort
}

# Standalone Linux programs at the top of a game folder (a Godot .x86_64,
# an extensionless binary), best guess first, with or without their
# executable bit. Beside Windows programs, only one named as one of them is
# (Game.x86_64 beside Game.exe), or a .NET program's Linux starter (NAME
# beside NAME.runtimeconfig.json, a launcher that may run the Windows
# programs through Wine itself): a Windows game's Linux server or helper must
# not turn it into a native game.
native_binaries() {                            # $1 = dir
    local dir="$1" files=() list stems compat
    mapfile -d '' files < <(find "$dir" -maxdepth 1 -type f ! -name '*.sh' ! -iname '*.exe' \
        ! -iname '*.dll' ! -name '*.so' ! -name '*.so.*' -print0 2>/dev/null)
    [ "${#files[@]}" -gt 0 ] || return 0
    for compat in "" --compat; do
        list="$(elf_programs ${compat:+"$compat"} "${files[@]}" | grep -Eiv "/[^/]*(${NATIVE_JUNK})[^/]*$" || true)"
        [ -z "$list" ] || break
    done
    [ -n "$list" ] || return 0
    if [ -n "$(find "$dir" -maxdepth 1 -type f -iname '*.exe' -print -quit 2>/dev/null)" ]; then
        stems="$(find "$dir" -maxdepth 1 -type f \( -iname '*.exe' -o -name '*.runtimeconfig.json' \) \
            -printf '%f\n' 2>/dev/null | sed -E 's/(\.runtimeconfig\.json|\.[eE][xX][eE])$//')"
        list="$(awk -F'\t' 'NR == FNR { s[tolower($0)]; next }
            { n = $2; sub(/.*\//, "", n); n = tolower(n); m = n; sub(/\.[^.]*$/, "", m)
              if ((n in s) || (m in s)) print }' <(printf '%s\n' "$stems") - <<<"$list")"
    fi
    rank_launchers "$dir" "$NATIVE_JUNK" strict <<<"$list"
}

# Map a Nautilus selection onto the game. RPG Maker MV/MZ is the awkward one:
# the app lives in "www" but the game -- and so the sandbox, and the settings --
# is the folder above it, and either may be what got right-clicked.
# Sets R_APPDIR (the NW.js app, empty when it is not one) and R_GAMEDIR.
# shellcheck disable=SC2034  # both are outputs, read by whoever sourced this
resolve_selection() {                          # $1 = selected path
    local sel="$1"
    R_APPDIR=""; R_GAMEDIR=""
    if [ -d "$sel" ]; then
        if   is_nwapp "$sel";     then R_APPDIR="${sel%/}"
        elif is_nwapp "$sel/www"; then R_APPDIR="${sel%/}/www"
        fi
    else
        case "$(basename "$sel")" in
            index.html|package.json) R_APPDIR="$(dirname "$sel")" ;;
        esac
    fi
    if [ -n "$R_APPDIR" ] && [ "$(basename "$R_APPDIR")" = www ]; then
        R_GAMEDIR="$(dirname "$R_APPDIR")"
    elif [ -n "$R_APPDIR" ]; then
        R_GAMEDIR="$R_APPDIR"
    elif [ -d "$sel" ]; then
        R_GAMEDIR="${sel%/}"
    else
        R_GAMEDIR="$(dirname "$sel")"
    fi
    # PGMMV's project lives in data/, sometimes below Resources/. Selecting
    # that folder or project.json should use the same sandbox as player.exe.
    local part base
    for part in data resources; do
        base="${R_GAMEDIR##*/}"
        if [ "${base,,}" = "$part" ] && is_pgmmv "$(dirname "$R_GAMEDIR")"; then
            R_GAMEDIR="$(dirname "$R_GAMEDIR")"
        fi
    done
}

# Both exported (including encrypted) games and editor projects have this
# file. Match case as the Linux player does, without parsing encrypted JSON.
is_pgmmv() {
    find "$1" -maxdepth 3 -type f -iname project.json -printf '%P\n' 2>/dev/null \
        | grep -iEx 'data/project[.]json|resources/data/project[.]json' >/dev/null
}

# A .NET program that needs a .NET runtime installed: its NAME.runtimeconfig.json
# names a shared framework, and NAME beside it is the Linux starter (an ELF
# file). Self-contained programs list "includedFrameworks" instead and bring
# their own; a Windows .NET program has NAME.exe, which a Linux runtime cannot
# start anyway. Only these get the preference that hands them the runtime.
is_dotnet() {                                  # $1 = game dir
    local f
    while IFS= read -r -d '' f; do
        [ -f "${f%.runtimeconfig.json}" ] \
            && [ -n "$(elf_programs "${f%.runtimeconfig.json}")" ] \
            && grep -qE '"frameworks?"[[:space:]]*:' "$f" && return 0
    done < <(find "$1" -maxdepth 3 -type f -name '*.runtimeconfig.json' -print0 2>/dev/null)
    return 1
}

has_windows_exe() {
    [ -n "$(find "$1" -maxdepth 5 -type f -iname '*.exe' -print -quit 2>/dev/null)" ]
}

# RPG Maker XP / VX / VX Ace, i.e. the RGSS engines mkxp-z reimplements. Game.ini
# names the runtime it wants; the data files and encrypted archives catch dumps
# that arrived without one. MV/MZ never match -- those are the NW.js case.
is_rgss() {
    [ -f "$1/Game.ini" ] &&
        grep -qiE '^[[:space:]]*Library[[:space:]]*=[[:space:]]*RGSS' "$1/Game.ini" && return 0
    [ -n "$(find "$1" -maxdepth 2 \( -iname '*.rvdata2' -o -iname '*.rvdata' \
            -o -iname '*.rxdata' -o -iname 'Game.rgss*' \) -print -quit 2>/dev/null)" ]
}

# What "Sandbox game" will run a selection with, in the order it goes by: an
# NW.js app, a .sh launcher, a PGMMV or RGSS game, a Linux program, a Windows
# .exe under Proton. For the preferences, which offer only what that engine can do.
# Sets R_ENGINE to nwjs, native, pgmmv, mkxp, proton, or empty when nothing is found.
# shellcheck disable=SC2034  # an output, read by whoever sourced this
game_engine() {                                # $1 = selection, $2 = optional launch_with override
    R_ENGINE=""
    if [ "${2:-$(cfg_get launch_with auto)}" = proton ]; then
        R_ENGINE=proton
        return
    fi
    if [ -n "$R_APPDIR" ]; then
        R_ENGINE=nwjs
    elif [ -d "$1" ]; then
        # The order "Sandbox game" goes by: cheap checks first, the binaries'
        # headers only when they are what is left to tell.
        if [ -n "$(native_scripts "$R_GAMEDIR")" ]; then
            R_ENGINE=native
        elif is_pgmmv "$R_GAMEDIR"; then
            R_ENGINE=pgmmv
        elif is_rgss "$R_GAMEDIR"; then
            R_ENGINE=mkxp
        elif [ -n "$(native_binaries "$R_GAMEDIR")" ]; then
            R_ENGINE=native
        elif has_windows_exe "$R_GAMEDIR"; then
            R_ENGINE=proton
        fi
    else
        case "${1,,}" in
            *.exe) if is_pgmmv "$R_GAMEDIR"; then R_ENGINE=pgmmv
                   elif is_rgss "$R_GAMEDIR"; then R_ENGINE=mkxp; else R_ENGINE=proton; fi ;;
            *.json) if is_pgmmv "$R_GAMEDIR"; then R_ENGINE=pgmmv; else R_ENGINE=native; fi ;;
            *)     R_ENGINE=native ;;
        esac
    fi
}

# Ren'Py carries its own SDL, built into its lib/*linux-ARCH/ binaries, and
# before some 8.x release built it without the Wayland driver: forced onto
# Wayland, such a build dies at its GL test with "wayland not available".
# True where the X11 driver is there and the Wayland one is not. Only when
# both driver names can be looked for: a layout this does not know is false.
renpy_without_wayland() {                      # $1 = game dir
    [ -d "$1/renpy" ] || return 1
    local libs=( "$1"/lib/*linux-"$(uname -m)" ) sos
    [ -d "${libs[0]}" ] || return 1
    # The shared objects only (librenpython.so, or a separate libSDL2): the
    # rest need not be read on every launch.
    # -H: the arch folder itself may be a symlink.
    mapfile -t sos < <(find -H "${libs[@]}" -maxdepth 2 -type f -name '*.so*' 2>/dev/null)
    [ "${#sos[@]}" -gt 0 ] || return 1
    grep -a -q -F "SDL X11 video driver" "${sos[@]}" 2>/dev/null \
        && ! grep -a -q -F "SDL Wayland video driver" "${sos[@]}" 2>/dev/null
}

# The sandbox-game options the saved preferences stand for. The launcher and
# the desktop manager both build their command lines here, so one preference
# never means two things. In: NAME, GAMEDIR, APPDIR (NW.js app or empty),
# PROTON, MKXP, PGMMV (1 for the runtime chosen), ALLOW_MANGOHUD. Out: FLAG;
# WL=1 when native Wayland was chosen; DOTNET_APP=1 for a .NET program.
# shellcheck disable=SC2034  # outputs, read by whoever sourced this
pref_flags() {
    local host_x11 split=0 gs=0 x11_exe x11_backend lan_allow e wp ga pv
    local -a host_entries cfg_env
    FLAG=( --name "$NAME" )
    host_x11="$(cfg_get host_x11 0)"
    [ "$host_x11" = 1 ] && FLAG+=( --host-x11 )
    WL=0
    [ "$host_x11" != 1 ] && [ "$(cfg_get wayland 0)" = 1 ] && WL=1
    [ "$WL" = 1 ] && [ "$(cfg_wayland_x11)" = 1 ] && split=1
    # Split display is Proton's. Any other engine takes it as what it is for
    # the game itself, plain native Wayland, as the preferences window shows.
    if [ "$split" = 1 ] && [ "$PROTON" = 1 ]; then
        FLAG+=( --wayland-x11 )
        x11_backend="$(cfg_get x11_backend gamescope)"
        FLAG+=( "--x11-backend=$x11_backend" )
        x11_exe="$(cfg_get x11_exe '')"
        [ -z "$x11_exe" ] || FLAG+=( "--x11-exe=$x11_exe" )
    elif [ "$WL" = 1 ]; then
        FLAG+=( --wayland )
    fi
    [ "$ALLOW_MANGOHUD" = 1 ] && [ "$(cfg_get mangohud 0)" = 1 ] && FLAG+=( --mangohud )
    # X11 has no HDR: defaults that ask for it pass over a game on the host's.
    [ "$host_x11" != 1 ] && [ "$(cfg_get hdr 0)" = 1 ] && FLAG+=( --hdr )
    if [ "$(cfg_get net 0)" = 1 ]; then
        FLAG+=( --net )
        [ "$(cfg_get mac_vendor 0)" != 1 ] || FLAG+=( --mac-vendor )
        if [ "$(cfg_get lan 0)" = 1 ]; then
            FLAG+=( --lan )
        else
            lan_allow="$(cfg_get lan_allow "")"
            [ -z "$lan_allow" ] || FLAG+=( "--allow-lan=$lan_allow" )
        fi
    fi
    # hosts=ADDR NAME..., ADDR NAME... -- one --add-host each.
    if [ "$(cfg_get private_hosts 0)" = 1 ]; then
        FLAG+=( --hosts )
        IFS=, read -r -a host_entries <<<"$(cfg_get hosts "")"
        for e in ${host_entries[@]+"${host_entries[@]}"}; do
            e="${e#"${e%%[![:space:]]*}"}"; e="${e%"${e##*[![:space:]]}"}"
            [ -z "$e" ] || FLAG+=( "--add-host=$e" )
        done
        [ "$(cfg_get hosts_writable 0)" = 1 ] && FLAG+=( --hosts-writable )
    fi
    # Native programs only. The .NET runtime is opt-in, and only for a program
    # recognised as needing it.
    DOTNET_APP=0
    if [ -z "$APPDIR" ] && [ "$PROTON" = 0 ] && [ "$MKXP" = 0 ] && [ "$PGMMV" = 0 ]; then
        is_dotnet "$GAMEDIR" && DOTNET_APP=1
        [ "$DOTNET_APP" = 1 ] && [ "$(cfg_get dotnet 0)" = 1 ] && FLAG+=( --dotnet )
        # Proton, for one that starts Wine itself.
        wp="$(cfg_get with_proton "")"
        if [ "$wp" = auto ]; then FLAG+=( --with-proton ); elif [ -n "$wp" ]; then FLAG+=( "--with-proton=$wp" ); fi
    fi
    # The X11 choice is stored as gamescope=0, wayland=0: X11 always runs in
    # gamescope, so its resolution and fullscreen apply there too. Split
    # display runs gamescope when it is the X11 backend, whatever the
    # gamescope key says.
    if [ "$host_x11" != 1 ]; then
        if [ "$WL" = 0 ]; then gs=1
        elif [ "$split" = 1 ]; then
            if [ "$PROTON" = 1 ] && [ "$x11_backend" = gamescope ]; then gs=1; fi
        else gs="$(cfg_get gamescope 0)"; fi
    fi
    if [ "$gs" = 1 ]; then
        # Empty means gamescope's own defaults.
        ga="$(cfg_get gamescope_args "")"
        if [ -n "$ga" ]; then FLAG+=( "--gamescope=$ga" ); else FLAG+=( --gamescope ); fi
    fi
    # env=K=V K=V ... -- a game launched from the file manager inherits its
    # environment, not a shell's, so anything the game needs has to be recorded.
    read -r -a cfg_env <<<"$(cfg_get env "")"
    for e in ${cfg_env[@]+"${cfg_env[@]}"}; do FLAG+=( "--env=$e" ); done
    if [ "$PROTON" = 1 ] && [ "$MKXP" = 0 ] && [ "$PGMMV" = 0 ]; then
        # An exported PROTON_VER still wins, matching NWJS_DIR/MKXP_DIR/PROTON_DIR.
        pv="${PROTON_VER:-$(cfg_get proton auto)}"
        if [ "$pv" = auto ]; then FLAG+=( --proton ); else FLAG+=( "--proton=$pv" ); fi
        [ "$(cfg_get mod_loaders 0)" = 1 ] && FLAG+=( --mod-loaders )
        [ "$(cfg_get steam 0)" = 1 ] && FLAG+=( --steam )
        [ "$(cfg_get hide_tray 0)" = 1 ] && FLAG+=( --hide-tray )
    fi
}

# Write one preferences window's answer ($1, JSON) for NAME: into its own
# file, or the defaults, or clear its file. Shared by the Nautilus window and
# the desktop manager. Says why on stderr and fails when nothing was saved.
# A subshell, so its working variables stay its own.
prefs_save() (
    out="$1"
    # Only fields belonging to the selected engine are returned. Hidden fields
    # come from the file being written, so they never copy across config scopes.
    parsed="$(python3 - "$out" <<'PY'
import json, re, sys
values = json.loads(sys.argv[1])
keys = {"scope", "launch_with", "wayland", "host_x11", "gamescope", "mangohud", "hdr",
