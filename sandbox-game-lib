# shellcheck shell=bash
# Sourced by the Nautilus scripts -- not executable, and deliberately not in the
# scripts directory, where Nautilus would list it as a menu entry of its own.
#
#   install -Dm644 sandbox-game-lib ~/.local/bin/sandbox-game-lib
#
# Everything here has to give the same answer in the launcher and in the
# preferences dialog. Keying a game one way while launching it another means
# saved settings quietly never apply, so the shared parts live in one file.

CFGDIR="${XDG_CONFIG_HOME:-$HOME/.config}/sandbox-game"

# One key out of one file. Anything writing a settings file wants this rather
# than cfg_get: cfg_get answers with the merged view, and writing that back into
# a single file copies values across scopes in whichever direction the save
# happens to go. Read rather than sourced -- these files are edited by hand as
# often as by the dialog, and a stray line should not run as code.
# A key that is there with nothing after it is a value, the empty one: that
# is how a game's own file says "none" where the defaults say something, as
# with gamescope_args. Only a key that is not there at all falls through.
file_get() {                                   # $1 = file, $2 = key
    local v
    [ -f "$1" ] && grep -q "^[[:space:]]*$2[[:space:]]*=" "$1" || return 1
    v="$(sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | tail -n1)"
    # Trailing blanks survive that substitution, and a file saved with CRLF
    # leaves a \r that would make "1" compare unequal to 1 -- invisibly.
    v="${v%"${v##*[![:space:]]}"}"
    printf '%s\n' "$v"
}

# Per-game settings win over the defaults, and both over the built-in fallback.
cfg_get() {                                    # $1 = key, $2 = fallback
    local f
    for f in "$CFGDIR/games/$NAME" "$CFGDIR/defaults"; do
        file_get "$f" "$1" && return
    done
    printf '%s\n' "$2"
}

is_nwapp() { [ -e "$1/package.json" ] || [ -e "$1/index.html" ]; }

# Map a Nautilus selection onto the game. RPG Maker MV/MZ is the awkward one:
# the app lives in "www" but the game -- and so the sandbox, and the settings --
# is the folder above it, and either may be what got right-clicked.
# Sets R_APPDIR (the NW.js app, empty when it is not one) and R_GAMEDIR.
# shellcheck disable=SC2034  # both are outputs, read by whoever sourced this
resolve_selection() {                          # $1 = selected path
    local sel="$1"
    R_APPDIR=""; R_GAMEDIR=""
    if [ -d "$sel" ]; then
        if   is_nwapp "$sel";     then R_APPDIR="${sel%/}"
        elif is_nwapp "$sel/www"; then R_APPDIR="${sel%/}/www"
        fi
    else
        case "$(basename "$sel")" in
            index.html|package.json) R_APPDIR="$(dirname "$sel")" ;;
        esac
    fi
    if [ -n "$R_APPDIR" ] && [ "$(basename "$R_APPDIR")" = www ]; then
        R_GAMEDIR="$(dirname "$R_APPDIR")"
    elif [ -n "$R_APPDIR" ]; then
        R_GAMEDIR="$R_APPDIR"
    elif [ -d "$sel" ]; then
        R_GAMEDIR="${sel%/}"
    else
        R_GAMEDIR="$(dirname "$sel")"
    fi
}

# RPG Maker XP / VX / VX Ace, i.e. the RGSS engines mkxp-z reimplements. Game.ini
# names the runtime it wants; the data files and encrypted archives catch dumps
# that arrived without one. MV/MZ never match -- those are the NW.js case.
is_rgss() {
    [ -f "$1/Game.ini" ] &&
        grep -qiE '^[[:space:]]*Library[[:space:]]*=[[:space:]]*RGSS' "$1/Game.ini" && return 0
    [ -n "$(find "$1" -maxdepth 2 \( -iname '*.rvdata2' -o -iname '*.rvdata' \
            -o -iname '*.rxdata' -o -iname 'Game.rgss*' \) -print -quit 2>/dev/null)" ]
}

# What "Sandbox game" will run a selection with, in the order it goes by: an
# NW.js app, a .sh launcher, an RGSS game under mkxp-z, a Windows .exe under
# Proton. For the preferences, which offer only what that engine can do.
# Sets R_ENGINE to nwjs, native, mkxp, proton, or empty when nothing is found.
# shellcheck disable=SC2034  # an output, read by whoever sourced this
game_engine() {                                # $1 = selected path, after resolve_selection
    R_ENGINE=""
    if [ -n "$R_APPDIR" ]; then
        R_ENGINE=nwjs
    elif [ -d "$1" ]; then
        if [ -n "$(find "$R_GAMEDIR" -maxdepth 1 -type f -name '*.sh' -print -quit 2>/dev/null)" ]; then
            R_ENGINE=native
        elif is_rgss "$R_GAMEDIR"; then
            R_ENGINE=mkxp
        elif [ -n "$(find "$R_GAMEDIR" -maxdepth 5 -type f -iname '*.exe' -print -quit 2>/dev/null)" ]; then
            R_ENGINE=proton
        fi
    else
        case "${1,,}" in
            *.exe) if is_rgss "$R_GAMEDIR"; then R_ENGINE=mkxp; else R_ENGINE=proton; fi ;;
            *)     R_ENGINE=native ;;
        esac
    fi
}

# Ren'Py carries its own SDL, built into its lib/*linux-ARCH/ binaries, and
# before some 8.x release built it without the Wayland driver: forced onto
# Wayland, such a build dies at its GL test with "wayland not available".
# True where the X11 driver is there and the Wayland one is not. Only when
# both driver names can be looked for: a layout this does not know is false.
renpy_without_wayland() {                      # $1 = game dir
    [ -d "$1/renpy" ] || return 1
    local libs=( "$1"/lib/*linux-"$(uname -m)" ) sos
    [ -d "${libs[0]}" ] || return 1
    # The shared objects only (librenpython.so, or a separate libSDL2): the
    # rest need not be read on every launch.
    # -H: the arch folder itself may be a symlink.
    mapfile -t sos < <(find -H "${libs[@]}" -maxdepth 2 -type f -name '*.so*' 2>/dev/null)
    [ "${#sos[@]}" -gt 0 ] || return 1
    grep -a -q -F "SDL X11 video driver" "${sos[@]}" 2>/dev/null \
        && ! grep -a -q -F "SDL Wayland video driver" "${sos[@]}" 2>/dev/null
}
